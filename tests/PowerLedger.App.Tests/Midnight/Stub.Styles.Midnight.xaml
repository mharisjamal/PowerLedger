<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- A stand-in for Midnight/Styles.Midnight.xaml (Plan O task M1-1, owned by Agent M1), with the keys of the plan's
         task 0.3 that M2's pages use, so they can be drawn before M1's dictionary lands. Deleted when it does. -->

    <FontFamily x:Key="M.Font.Ui">pack://application:,,,/PowerLedger;component/Fonts/Manrope/#Manrope, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="M.Font.Numbers">pack://application:,,,/PowerLedger;component/Fonts/JetBrainsMono/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="M.Font.Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="M.Radius.Card">14</sys:Double>
    <sys:Double x:Key="M.Radius.Pill">999</sys:Double>
    <sys:Double x:Key="M.Radius.Control">8</sys:Double>
    <sys:Double x:Key="M.Elevation.Card">12</sys:Double>

    <Style x:Key="M.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource M.Ink}" />
    </Style>
    <Style x:Key="M.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Numbers}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="M.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Body}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="M.Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Body}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="M.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource M.Ink2}" />
    </Style>
    <Style x:Key="M.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource M.Ink3}" />
    </Style>
    <Style x:Key="M.Text.Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Body}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource M.Ink3}" />
    </Style>
    <Style x:Key="M.Text.Number" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Numbers}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="M.Card.Flat" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource M.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M.LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="M.Card" TargetType="Border" BasedOn="{StaticResource M.Card.Flat}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M.Button.Quiet" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource M.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource M.Raised}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource M.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="M.Button.Outline" TargetType="Button" BasedOn="{StaticResource M.Button.Quiet}">
        <Setter Property="BorderBrush" Value="{DynamicResource M.LineStrong}" />
    </Style>
    <Style x:Key="M.Button.Primary" TargetType="Button" BasedOn="{StaticResource M.Button.Quiet}">
        <Setter Property="Background" Value="{DynamicResource M.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource M.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M.Accent}" />
    </Style>
    <Style x:Key="M.IconButton" TargetType="Button" BasedOn="{StaticResource M.Button.Quiet}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Glyphs}" />
    </Style>

    <Style x:Key="M.Pill" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource M.Ink2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" Height="28" Background="{DynamicResource M.Raised}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource M.Ink}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource M.Focus}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource M.OnAccent}" />
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource M.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M.Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Numbers}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource M.Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource M.Ink}" />
        <Setter Property="Background" Value="{DynamicResource M.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource M.LineStrong}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource M.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M.Tick" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource M.Ink2}" />
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" BorderBrush="{DynamicResource M.LineStrong}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3.5,8 L6.5,11 L12.5,4.5" Stroke="{DynamicResource M.OnAccent}" StrokeThickness="1.8" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource M.Ink}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource M.Focus}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource M.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource M.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M.Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource M.Ink2}" />
        <Setter Property="FontFamily" Value="{StaticResource M.Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="20" Background="{DynamicResource M.LineStrong}" CornerRadius="10" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource M.OnAccent}" HorizontalAlignment="Left" Margin="3,0" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource M.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="M.Chip.Measured" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource M.ChipMeasured}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource M.ChipMeasuredText}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource M.Font.Ui}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="M.Chip.Calibrated" TargetType="Border" BasedOn="{StaticResource M.Chip.Measured}">
        <Setter Property="Background" Value="{DynamicResource M.ChipCalibrated}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource M.ChipCalibratedText}" />
    </Style>
    <Style x:Key="M.Chip.Estimated" TargetType="Border" BasedOn="{StaticResource M.Chip.Measured}">
        <Setter Property="Background" Value="{DynamicResource M.ChipEstimated}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource M.ChipEstimatedText}" />
    </Style>

    <Style x:Key="M.Table.Header" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource M.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,8" />
    </Style>
    <Style x:Key="M.Table.Row" TargetType="Border">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="BorderBrush" Value="{DynamicResource M.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource M.Raised}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="M.ShareTrack" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource M.Raised}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PowerLedger</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The logo, made by assets\brand\make-brand.ps1: the icon Explorer, the Start menu and a pinned taskbar button show. -->
    <ApplicationIcon>..\..\assets\brand\PowerLedger.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003 wants DPI awareness set through WinForms' startup API, which a WPF app never calls; WPF reads it from the manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerLedger.Contracts\PowerLedger.Contracts.csproj" />
    <ProjectReference Include="..\PowerLedger.Core\PowerLedger.Core.csproj" />
    <ProjectReference Include="..\PowerLedger.Storage\PowerLedger.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec §9's faces, a folder a family, static instances only: WPF reads no variable font's axes. Each folder's OFL.txt is
         its licence; THIRD-PARTY-NOTICES.md at the repo root lists them. A FontFamily names the folder: /Fonts/Archivo/#Archivo. -->
    <Resource Include="Fonts\**\*.ttf" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window's icon: its taskbar button and Alt+Tab. -->
    <Resource Include="..\..\assets\brand\PowerLedger.ico" Link="Brand\PowerLedger.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PowerLedger.App.Tests" />
  </ItemGroup>

  <!-- The release feed, the checked download and the connection's cost, shared with the service, which installs updates
       itself (Plan Q §4): compiled into each, so neither exposes them. -->
  <ItemGroup>
    <Compile Include="..\Shared\Updates\*.cs" Link="Updates\Shared\%(Filename)%(Extension)" />
    <Using Include="PowerLedger.Updates" />
  </ItemGroup>

  <!-- The repo is public: Google's Desktop client secret never lands in source or in this file's own value, only in the
       built assembly's metadata, from a property installer\build.ps1 passes on the command line. Empty when nobody
       passes it, which SignInClients.GoogleSecret then reads as "not configured" (review: security round). -->
  <ItemGroup>
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(PowerLedgerGoogleClientSecret)" />
  </ItemGroup>

  <!-- WinForms is here only for the tray icon and a screen's work area; its global usings would collide with WPF's Application, Color and more. -->
  <Target Name="DropWinFormsGlobalUsings" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Drawing" />
      <Using Remove="System.Windows.Forms" />
    </ItemGroup>
  </Target>

</Project>

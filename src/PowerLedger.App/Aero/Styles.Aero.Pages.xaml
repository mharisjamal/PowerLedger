<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:app="clr-namespace:PowerLedger.App"
                    xmlns:aero="clr-namespace:PowerLedger.App.Aero">

    <!-- Page-only styles for Aero's History, Parts, Reports and Household pages (Plan S, P1 to P4), merged by each page
         after Styles.Aero.xaml, whose keys (Plan S 0.8) these build on. Panels sit 16 apart, as the demo's grid has them,
         with 20 × 18 inside; a panel's head is its icon well and title, its controls at the right. Colours are the palette's
         A.* tokens by DynamicResource, so a theme or Glass change repaints; nothing here is a raw colour. -->
    <ResourceDictionary.MergedDictionaries>
        <!-- The keys these build on, the one instance the window merges, so a page can merge this dictionary alone. -->
        <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The page: room under the last panel for its shadow; the page host sets the sides. -->
    <Thickness x:Key="A.Page.Margin">0,0,0,28</Thickness>
    <Thickness x:Key="A.Page.Gap">0,16,0,0</Thickness>
    <Thickness x:Key="A.Page.Panel">20,18</Thickness>
    <!-- Prose and forms keep to a readable measure inside a panel. -->
    <sys:Double x:Key="A.Page.Measure">560</sys:Double>
    <sys:Double x:Key="A.Page.Share">120</sys:Double>

    <!-- Each part's colour, as the Dashboard's pie gives it: the accent, green, violet and blue. -->
    <SolidColorBrush x:Key="A.Part.Cpu" Color="{DynamicResource A.C.Accent}" />
    <SolidColorBrush x:Key="A.Part.Gpu" Color="{DynamicResource A.C.Green}" />
    <SolidColorBrush x:Key="A.Part.Display" Color="{DynamicResource A.C.Violet}" />
    <SolidColorBrush x:Key="A.Part.Rest" Color="{DynamicResource A.C.Blue}" />

    <!-- A panel's head: the icon well, the title, and the panel's own controls docked at the right. -->
    <Style x:Key="A.Page.Head" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="A.Page.IconWell" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Icon}" />
        <Setter Property="Background" Value="{DynamicResource A.B.Well2}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The segmented pills' track: a hairline capsule, the white pill that slides between them drawn by SegTrack. -->
    <Style x:Key="A.Page.SegTrack" TargetType="aero:SegTrack">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IndicatorBrush" Value="{DynamicResource A.B.Pill}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="aero:SegTrack">
                    <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <Grid x:Name="PART_Host">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Width="0" Height="32" CornerRadius="16"
                                    Background="{TemplateBinding IndicatorBrush}" Visibility="Hidden" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.18" RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A table's column heads and cells, inside A.Table.Header and A.Table.Row, which give the 14 px sides and the
         demo's small muted heads and rows that light on hover; a cell keeps 14 from the next. -->
    <Style x:Key="A.Page.Head.Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text3}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style x:Key="A.Page.Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="A.Page.Cell.Number" TargetType="TextBlock" BasedOn="{StaticResource A.Page.Cell}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="A.Page.Cell.Muted" TargetType="TextBlock" BasedOn="{StaticResource A.Page.Cell}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
    </Style>
    <Style x:Key="A.Page.Dot" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A key and its value in a well, as the demo's report and household dialogs list them. -->
    <Style x:Key="A.Page.Key" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Margin" Value="14,11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="A.Page.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Margin" Value="14,11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Words under a control, and the line that says how a save or an action went. -->
    <Style x:Key="A.Page.Note" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style x:Key="A.Page.Prose" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The drawn controls the pages share with the other looks, in Aero's ink: hairlines as the demo's grid, labels in the
         third ink, each part in its colour. -->
    <Style x:Key="A.Page.Instrument" TargetType="app:Instrument">
        <Setter Property="LineBrush" Value="{DynamicResource A.B.TrackSoft}" />
        <Setter Property="StrongLineBrush" Value="{DynamicResource A.B.Line}" />
        <Setter Property="LabelBrush" Value="{DynamicResource A.B.Text3}" />
        <Setter Property="InkBrush" Value="{DynamicResource A.B.Text}" />
        <Setter Property="AccentBrush" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="AccentSoftBrush" Value="{DynamicResource A.B.Well2}" />
        <Setter Property="CpuBrush" Value="{StaticResource A.Part.Cpu}" />
        <Setter Property="GpuBrush" Value="{StaticResource A.Part.Gpu}" />
        <Setter Property="DisplayBrush" Value="{StaticResource A.Part.Display}" />
        <Setter Property="RestBrush" Value="{StaticResource A.Part.Rest}" />
        <Setter Property="NumberFont" Value="{DynamicResource A.F.Ui}" />
    </Style>
    <Style x:Key="A.Page.StackedChart" TargetType="app:StackedChart" BasedOn="{StaticResource A.Page.Instrument}" />
    <Style x:Key="A.Page.DailyBars" TargetType="app:DailyBars" BasedOn="{StaticResource A.Page.Instrument}" />
    <Style x:Key="A.Page.QualityBar" TargetType="app:QualityBar" BasedOn="{StaticResource A.Page.Instrument}">
        <Setter Property="MeasuredBrush" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="CalibratedBrush" Value="{DynamicResource A.B.Violet}" />
        <Setter Property="EstimatedBrush" Value="{DynamicResource A.B.Muted}" />
    </Style>
    <Style x:Key="A.Page.ShareBar" TargetType="app:ShareBar" BasedOn="{StaticResource A.Page.Instrument}">
        <Setter Property="TrackBrush" Value="{DynamicResource A.B.TrackSoft}" />
        <Setter Property="FillBrush" Value="{StaticResource A.Part.Rest}" />
    </Style>
    <Style x:Key="A.Page.PartTrend" TargetType="aero:PartTrend" BasedOn="{StaticResource A.Page.Instrument}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="28" />
        <Setter Property="StrokeBrush" Value="{DynamicResource A.B.Accent}" />
    </Style>

    <Style x:Key="A.Page.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text3}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
</ResourceDictionary>

<Window x:Class="PowerLedger.App.Aero.OverlayWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:app="clr-namespace:PowerLedger.App"
        xmlns:aero="clr-namespace:PowerLedger.App.Aero"
        Title="PowerLedger watts overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource A.F.Ui}" Foreground="{DynamicResource A.B.Text}" TextOptions.TextFormattingMode="Ideal"
        Typography.NumeralAlignment="Tabular" UseLayoutRounding="True">
    <!-- The watts overlay (0.10.9): the recipe's glass capsule and nothing else. The window is drawn with its alpha
         (AllowsTransparency), so outside the capsule it is clear, its edge anti-aliased straight onto whatever is behind,
         and a clear pixel takes no click. No room is kept round the capsule for the recipe's drop shadow: an untinted
         capsule casts at most 0.7 % (under 2 of 255, measured in Edge), and every pixel it tinted would take the pointer
         from the windows under it. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Aero's styles on the window, as on Aero's main window (Aero look design §3), never at Application level. -->
                <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A pixel of room round the capsule, so its anti-aliased edge is never cut by the window's own. -->
            <Thickness x:Key="Overlay.Room">1</Thickness>
            <!-- The capsule: the kit's watts pill, 56 high, the recipe's 28 corner. -->
            <sys:Double x:Key="Overlay.Height">56</sys:Double>
            <!-- The menu's section heads: quiet, and not a choice. -->
            <Style x:Key="Overlay.MenuHead" TargetType="MenuItem">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <TextBlock Text="{TemplateBinding Header}" FontSize="{DynamicResource A.T.Tiny}" Foreground="{DynamicResource A.B.Text3}" Margin="12,8,12,2" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Room" Margin="{StaticResource Overlay.Room}">
        <Grid x:Name="Pill" RenderTransformOrigin="0.5,0.5" Height="{StaticResource Overlay.Height}">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PillScale" />
            </Grid.RenderTransform>
            <!-- The kit's .pill: the live dot, the watts in 26 semibold, the unit at 80 %, the 30 s line 90 by 26, 14 apart. -->
            <aero:GlassPanel x:Name="Glass" Style="{StaticResource A.Glass.Capsule}" Padding="18,0,22,0" HasShadow="False"
                             AutomationProperties.Name="No reading">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The live dot, still: a breathing ring would redraw the window all the time. -->
                    <aero:PulseDot Size="10" Breathes="False" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <aero:RollingNumber x:Name="Number" DigitSize="26" DigitWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="Unit" Text="W" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource A.B.Text2}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="NoReading" Text="No reading" FontSize="{DynamicResource A.T.Body}" Foreground="{DynamicResource A.B.Text2}" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <aero:Sparkline x:Name="Spark" Width="90" Height="26" Margin="14,0,0,0" VerticalAlignment="Center" Stroke="{DynamicResource A.B.Accent}" />
                </StackPanel>
            </aero:GlassPanel>
        </Grid>
    </Grid>
</Window>

    <PathGeometry x:Key="A.I.Bell" po:Freeze="True" Figures="M6,8 a6,6 0 1 1 12,0 c0,7 3,9 3,9 H3 c0,0 3,-2 3,-9 M10.3,21 a1.9,1.9 0 0 0 3.4,0" />

        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
        <PathGeometry Figures="M12,11 v5 M12,8 v0.01" />
    </GeometryGroup>
    <PathGeometry x:Key="A.I.Expand" po:Freeze="True" Figures="M15,3 h6 v6 M9,21 H3 v-6 M21,3 l-7,7 M3,21 l7,-7" />

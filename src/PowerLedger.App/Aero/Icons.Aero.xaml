    </GeometryGroup>
    <PathGeometry x:Key="A.I.Moon" po:Freeze="True" Figures="M12,3 a9,9 0 1 0 9,9 a7,7 0 0 1 -9,-9 z" />
    <GeometryGroup x:Key="A.I.Search" po:Freeze="True">

                    mc:Ignorable="po">
    <!-- Aero's icons (Plan S 0.8; 0.10.9, the liquid glass mockup's own SVG paths) on a 24 unit grid (tools/AeroPreview/Icons.xaml),
         drawn by the Icon control at any size in the inherited foreground; stroked with round caps unless Filled. Merged by
         Styles.Aero.xaml. Frozen: every view shares the one geometry. -->
    <PathGeometry x:Key="A.I.Bolt" po:Freeze="True" Figures="M13,2 L4,14 H11 L10,22 L19,10 H12 Z" />
    <GeometryGroup x:Key="A.I.Dashboard" po:Freeze="True">
        <RectangleGeometry Rect="3,3,7,7" RadiusX="2" RadiusY="2" />
        <RectangleGeometry Rect="14,3,7,7" RadiusX="2" RadiusY="2" />
        <RectangleGeometry Rect="3,14,7,7" RadiusX="2" RadiusY="2" />
        <RectangleGeometry Rect="14,14,7,7" RadiusX="2" RadiusY="2" />
    </GeometryGroup>
    <PathGeometry x:Key="A.I.History" po:Freeze="True" Figures="M3,12 a9,9 0 1 0 3,-6.7 L3,8 M3,3 v5 h5 M12,7 v5 l3,2" />
    <PathGeometry x:Key="A.I.Replay" po:Freeze="True" Figures="M3,12 a9,9 0 1 0 3,-6.7 M3,4 v5 h5" />
    <!-- The intro's speaker (Plan S intro): sounding, and crossed out while muted. -->
    <PathGeometry x:Key="A.I.Speaker" po:Freeze="True" Figures="M4,9 h4 l5,-4 v14 l-5,-4 h-4 Z M16.5,8.5 a5,5 0 0 1 0,7 M19,6 a8.5,8.5 0 0 1 0,12" />
    <PathGeometry x:Key="A.I.Muted" po:Freeze="True" Figures="M4,9 h4 l5,-4 v14 l-5,-4 h-4 Z M16,9 l6,6 M22,9 l-6,6" />
    <GeometryGroup x:Key="A.I.Chip" po:Freeze="True">
        <RectangleGeometry Rect="6,6,12,12" RadiusX="2" RadiusY="2" />
        <PathGeometry Figures="M9,2 v4 M15,2 v4 M9,18 v4 M15,18 v4 M2,9 h4 M2,15 h4 M18,9 h4 M18,15 h4" />
    </GeometryGroup>
    <!-- Insights, new with the page (Aero look design §4): a line that climbs, with the spark of a finding at its peak. -->
    <PathGeometry x:Key="A.I.Insights" po:Freeze="True" Figures="M3,17 l6,-6 l4,4 l8,-8 M14,7 h7 v7" />
    <PathGeometry x:Key="A.I.Report" po:Freeze="True" Figures="M14,3 H6 a2,2 0 0 0 -2,2 v14 a2,2 0 0 0 2,2 h12 a2,2 0 0 0 2,-2 V9 Z M14,3 v6 h6 M8,13 h8 M8,17 h5" />

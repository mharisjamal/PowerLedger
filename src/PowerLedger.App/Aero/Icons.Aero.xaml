        <RectangleGeometry Rect="6,6,12,12" RadiusX="2.5" RadiusY="2.5" />
    </GeometryGroup>
    <GeometryGroup x:Key="A.I.Restore" po:Freeze="True">
        <RectangleGeometry Rect="5,8,11,11" RadiusX="2.5" RadiusY="2.5" />
        <PathGeometry Figures="M8,5 h9 a2,2 0 0 1 2,2 v9" />
    </GeometryGroup>
    <PathGeometry x:Key="A.I.Close" po:Freeze="True" Figures="M7,7 l10,10 M17,7 l-10,10" />
    <GeometryGroup x:Key="A.I.Overlay" po:Freeze="True">
        <RectangleGeometry Rect="3,8,18,8" RadiusX="4" RadiusY="4" />
        <EllipseGeometry Center="8,12" RadiusX="0.75" RadiusY="0.75" />
    </GeometryGroup>
    <PathGeometry x:Key="A.I.Check" po:Freeze="True" Figures="M5,12.5 l4.5,4.5 L19,7.5" />
</ResourceDictionary>

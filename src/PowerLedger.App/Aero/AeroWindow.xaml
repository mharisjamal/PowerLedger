<Window x:Class="PowerLedger.App.AeroWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerLedger.App"
        Title="PowerLedger" Icon="pack://application:,,,/PowerLedger;component/Brand/PowerLedger.ico" Width="1280" Height="860" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Ground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Aero's styles live here, not at Application level (design §3); the views merge the same instance. -->
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Task 0's Aero shell (Aero look design §2, Plan S Task 0): the window the look switcher opens for Aero, with the
         IShellWindow members and nothing drawn yet but the page it is on. Agent D replaces the content with the sidebar,
         the top bar, the page host and the intro; the constructor and the IShellWindow members stay as they are. -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="Placeholder" FontSize="20" Foreground="{DynamicResource Brush.Ink}" Text="PowerLedger" HorizontalAlignment="Center" />
            <TextBlock x:Name="PageName" FontSize="13" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Ink2}" HorizontalAlignment="Center"
                       Text="{Binding Page}" />
        </StackPanel>
    </Grid>
</Window>

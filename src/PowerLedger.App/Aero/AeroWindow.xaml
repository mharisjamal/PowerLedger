<Window x:Class="PowerLedger.App.AeroWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerLedger.App"
        xmlns:aero="clr-namespace:PowerLedger.App.Aero"
        Title="PowerLedger" Icon="pack://application:,,,/PowerLedger;component/Brand/PowerLedger.ico" Width="1280" Height="860" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Ground}"
        FontFamily="{DynamicResource A.F.Ui}" Foreground="{DynamicResource A.B.Text}" FontSize="{DynamicResource A.T.Body}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- The Aero shell (Aero look design §1 and §2, Plan S D1): the approved demo's stage on real ViewModels. The sidebar
         is a glass pane with the brand, the pages under a pill that springs from item to item, "Your PCs", Switch look,
         and the version and the service's state at its foot; the main column has the top bar (search, the overlay, the
         bell, the service pulse, the household), the banners and the page. The caption strip above them (52 px, the
         demo's) holds its buttons. Menus are glass context menus (A.Menu); dialogs, toasts and the blocking update panel
         float in the layer over everything. Since 0.10.1 the window is only its glass (AeroWindow.FreeForm): every pane,
         pill and button floats on its own over the real desktop, any glass that isn't a control drags the window, and the
         grip and the shape's outer edges resize it, so WindowChrome keeps no caption of its own. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Aero's styles live here, not at Application level (design §3); the views merge the same instance. -->
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:AtLeast x:Key="AtLeast" />

            <!-- A narrow window (under 1100 px) draws the sidebar as a column of icons, each still named for a screen reader; a
                 short one (under 700 px) sets its items closer. The item's words come from its automation name, so the narrow
                 window can leave them out. -->
            <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource A.NavItem}">
                <Setter Property="Content" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
                <Setter Property="GroupName" Value="Nav" />
                <Setter Property="Margin" Value="0,0,0,9" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=700}" Value="False">
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=1100}" Value="False">
                        <Setter Property="Content" Value="{x:Null}" />
                        <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Wide" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=1100}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="WideText" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=1100}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Narrow" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=1100}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- A disc with letters: a PC in "Your PCs", this one in the accent and the others in violet, as the demo. -->
            <DataTemplate x:Key="PcRow" DataType="{x:Type local:PcRow}">
                <Button Style="{StaticResource A.RowBtn}" Margin="0,0,0,4" Click="PcClick" AutomationProperties.Name="{Binding Name}"
                        AutomationProperties.HelpText="{Binding Figure}" ToolTip="{Binding Name}">
                    <DockPanel>
                        <Grid Width="30" Height="30">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource A.B.Violet}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThisPc}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource A.B.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource A.B.White}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsThisPc}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource A.B.AccentInk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Figure}" Style="{StaticResource WideText}" FontSize="{DynamicResource A.T.Small}"
                                   Foreground="{DynamicResource A.B.Text2}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource WideText}" Margin="10,0,0,0" FontSize="{DynamicResource A.T.Control}" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <!-- Windows pushes a maximised window's resize border off screen; keep the content on it. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- The room behind the glass: the desktop through the window, or the wallpaper lined up with the screen (frosted
             once in the panes), or the plain ground (Aero look design §3; Backdrop and WallpaperFrost fill it). Only the
             glass's soft edges show it: outside the glass there is no window. -->
        <Border x:Name="Room" IsHitTestVisible="False" />

        <Grid x:Name="Stage" Margin="24,52,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="240" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ the sidebar ============ -->
            <aero:GlassPanel x:Name="Side" Padding="15,19" Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                <Grid x:Name="SideContent">
                    <!-- In reading order, which is the keyboard's: the brand, the pages and PCs, Switch look, the foot. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2,6,20" AutomationProperties.Name="PowerLedger">
                        <Grid Width="32" Height="32">
                            <Ellipse Fill="{DynamicResource A.B.Accent}" />
                            <aero:Icon Data="{StaticResource A.I.Bolt}" Filled="True" Foreground="{DynamicResource A.B.AccentInk}" />
                        </Grid>
                        <TextBlock Text="PowerLedger" Style="{StaticResource WideText}" Margin="10,0,0,0" FontSize="{DynamicResource A.T.Brand}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- The pages, and "Your PCs"; a window too short for them all scrolls them rather than covering the foot. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <Grid x:Name="Nav">
                                <!-- The demo's .nav-ind: white at 10 % right to the edge, its light top line (22 %) on the first row. -->
                                <Border x:Name="NavIndicator" Height="48" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0"
                                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                        Background="{DynamicResource A.B.NavIndicator}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="NavY" />
                                    </Border.RenderTransform>
                                    <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                            BorderBrush="{DynamicResource A.B.NavIndicatorTop}" BorderThickness="0,1,0,0" />
                                </Border>
                                <StackPanel x:Name="NavItems" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                                    <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource A.I.Dashboard}" AutomationProperties.Name="Dashboard" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Dashboard}}" />
                                    <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource A.I.History}" AutomationProperties.Name="History" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Breakdown}}" />
                                    <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource A.I.Chip}" AutomationProperties.Name="Parts" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Parts}}" />
                                    <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource A.I.Insights}" AutomationProperties.Name="Insights" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Insights}}" />
                                    <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource A.I.Report}" AutomationProperties.Name="Reports" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Report}}" />
                                    <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource A.I.House}" AutomationProperties.Name="Household" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Household}}" />
                                    <RadioButton Style="{StaticResource NavItem}" Tag="{StaticResource A.I.Gear}" AutomationProperties.Name="Settings" Checked="NavChecked" Margin="0"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Settings}}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Your PCs" Style="{StaticResource WideText}" FontSize="{DynamicResource A.T.Small}" Foreground="{DynamicResource A.B.Text3}" Margin="8,20,8,8" />
                            <Border Height="1" Margin="10,16,10,12" Background="{DynamicResource A.B.WellTop}" Style="{StaticResource Narrow}" />
                            <ItemsControl x:Name="Pcs" Focusable="False" ItemTemplate="{StaticResource PcRow}" AutomationProperties.Name="Your PCs" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Switch look: a small menu of the other two looks (design §2). -->
                    <Button x:Name="SwitchLookButton" Grid.Row="2" Style="{StaticResource A.RowBtn}" Foreground="{DynamicResource A.B.Text2}"
                            Click="SwitchLookClick" AutomationProperties.Name="Switch look" ToolTip="Switch look">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="30" Height="30">
                                <Ellipse Fill="{DynamicResource A.B.Well2}" />
                                <aero:Icon Data="{StaticResource A.I.Moon}" Size="14" />
                            </Grid>
                            <TextBlock Text="Switch look" Style="{StaticResource WideText}" Foreground="{DynamicResource A.B.Text2}" FontSize="{DynamicResource A.T.Control}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- The foot: the update card when there is something to say, then the version and the service's state. -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Border x:Name="UpdateCard" Style="{StaticResource A.Well}" Padding="14,12" Margin="0,0,0,10" AutomationProperties.Name="Update"
                                Visibility="{Binding ShowCard, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource A.ExpandBtn}" Width="24" Height="24" Margin="0,-4,-6,0" Command="{Binding Dismiss}"
                                            ToolTip="Later" AutomationProperties.Name="Later" Visibility="{Binding CanDismiss, Converter={StaticResource VisibleWhen}}">
                                        <aero:Icon Data="{StaticResource A.I.Close}" Size="12" />
                                    </Button>
                                    <TextBlock Style="{StaticResource A.Text.Muted}" FontSize="{DynamicResource A.T.Small}" Text="Update" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource A.Text.Body}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Small}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"
                                           Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource VisibleWhenText}}" />
                                <Button Style="{StaticResource A.AccentBtn}" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{Binding ActionLabel}"
                                        Command="{Binding Act}" Visibility="{Binding ActionLabel, Converter={StaticResource VisibleWhenText}}" />
                                <Button x:Name="WhatsNew" Style="{StaticResource A.OutlineBtn}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="What's new"
                                        Command="{Binding ShowWhatsNew}" Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="8,0,4,0">
                            <TextBlock x:Name="VersionLine" DockPanel.Dock="Right" Style="{StaticResource WideText}" Foreground="{DynamicResource A.B.Text3}" FontSize="{DynamicResource A.T.Small}"
                                       VerticalAlignment="Center" Text="{Binding ShortName}" ToolTip="{Binding RunningName}"
                                       AutomationProperties.Name="{Binding RunningName}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Now.Status.State}">
                                <Ellipse x:Name="StateDot" Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource M.Bad}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Now.Status.Running}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource A.B.Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource WideText}" Margin="8,0,0,0" Foreground="{DynamicResource A.B.Text3}" FontSize="{DynamicResource A.T.Small}"
                                           Text="{Binding Now.Status.State}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                </Grid>
            </aero:GlassPanel>

            <!-- ============ the main column ============ -->
            <Grid x:Name="Main">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="2" />
                        <Style.Triggers>
                            <!-- The wizard has the window: no sidebar, and the wizard across the whole width. -->
                            <DataTrigger Binding="{Binding IsSetup}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The top bar -->
                <!-- The search is the demo's 330 px wide while the bar has room for it (its column takes nearly all the free width,
                     up to 330), and gives way to the pills in a narrower window. -->
                <Grid x:Name="TopBar" Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" MaxWidth="330" />
                        <ColumnDefinition Width="*" MinWidth="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <aero:GlassPanel x:Name="SearchGlass" Height="46" CornerRadius="{DynamicResource A.R.Search}" Padding="19,0,7,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <aero:Icon Data="{StaticResource A.I.Search}" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search history" Margin="10,0,0,0" Foreground="{DynamicResource A.B.Text2}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="Search" Grid.Column="1" Margin="8,0,6,0" Style="{StaticResource A.SearchBox}" AutomationProperties.Name="Search history"
                                     TextChanged="SearchChanged" />
                            <Border Grid.Column="2" Height="34" Padding="10,0" CornerRadius="{DynamicResource A.R.Button}" Background="{DynamicResource A.B.WellHover}"
                                    VerticalAlignment="Center" Style="{StaticResource Wide}">
                                <TextBlock Text="Ctrl K" FontSize="{DynamicResource A.T.Small}" Foreground="{DynamicResource A.B.Text2}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </aero:GlassPanel>
                    <!-- Each pill floats on its own over the desktop (0.10.1): a piece of the window's shape under its button
                         (A.TopPill), which draws the demo's .gbtn itself. -->
                    <!-- The watts overlay (design §5): on or off, through Settings, where the overlay listens. -->
                    <aero:GlassPanel x:Name="OverlayPill" Grid.Column="2" Style="{StaticResource A.TopPill}" Margin="0,0,10,0">
                        <ToggleButton x:Name="OverlayButton" Style="{StaticResource A.GlassToggle}" Height="46"
                                      Command="{Binding Settings.ToggleOverlay}" IsChecked="{Binding Settings.OverlaySection.Enabled, Mode=OneWay}" AutomationProperties.Name="Watts overlay" ToolTip="Show the watts over other windows">
                            <StackPanel Orientation="Horizontal">
                                <aero:Icon Data="{StaticResource A.I.Overlay}" Size="16" />
                                <TextBlock Text="Overlay" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource WideText}" FontSize="{DynamicResource A.T.Control}" />
                            </StackPanel>
                        </ToggleButton>
                    </aero:GlassPanel>
                    <aero:GlassPanel x:Name="BellPill" Grid.Column="3" Style="{StaticResource A.TopPill}" Margin="0,0,10,0">
                        <Grid>
                            <Button x:Name="BellButton" Style="{StaticResource A.RoundGlassBtn}" Click="BellClick" AutomationProperties.Name="Approvals and alerts" ToolTip="Approvals and alerts">
                                <aero:Icon Data="{StaticResource A.I.Bell}" Size="17" />
                            </Button>
                            <Ellipse x:Name="BellDot" Width="9" Height="9" Fill="{DynamicResource A.B.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,8,9,0" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </aero:GlassPanel>
                    <aero:GlassPanel x:Name="ServicePill" Grid.Column="4" Style="{StaticResource A.TopPill}" Margin="0,0,10,0">
                        <Button x:Name="ServiceButton" Style="{StaticResource A.RoundGlassBtn}"
                                Click="ServiceClick" AutomationProperties.Name="Service" ToolTip="{Binding Now.Status.State}">
                            <Grid>
                                <!-- Measuring: the accent dot breathing; stopped: a still red one. -->
                                <aero:PulseDot x:Name="ServicePulse" Size="9" Visibility="{Binding Now.Status.Running, Converter={StaticResource VisibleWhen}}" />
                                <Ellipse x:Name="ServiceDot" Width="9" Height="9" IsHitTestVisible="False" Fill="{DynamicResource M.Bad}"
                                         Visibility="{Binding Now.Status.Running, Converter={StaticResource HiddenWhen}}" />
                            </Grid>
                        </Button>
                    </aero:GlassPanel>
                    <aero:GlassPanel x:Name="HouseholdPill" Grid.Column="5" Style="{StaticResource A.TopPill}">
                    <Button x:Name="HouseholdButton" Style="{StaticResource A.GlassBtn}" Height="46" Padding="6,0,14,0"
                            Click="HouseholdClick" AutomationProperties.Name="Household">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="{DynamicResource A.B.Pill}" />
                                <aero:Icon Data="{StaticResource A.I.House}" Foreground="{DynamicResource A.B.Ink}" />
                            </Grid>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Wide}">
                                <!-- The demo's .who .t: two lines at 1.2. -->
                                <TextBlock Text="Home" FontSize="{DynamicResource A.T.Body}" FontWeight="Medium" LineHeight="16.8" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock x:Name="HouseholdLine" FontSize="11.5" Foreground="{DynamicResource A.B.Text2}" LineHeight="13.8" LineStackingStrategy="BlockLineHeight" />
                            </StackPanel>
                            <aero:Icon Data="{StaticResource A.I.Chevron}" Size="14" StrokeWidth="2.6" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </aero:GlassPanel>
                </Grid>

                <!-- Banners under the top bar, in the page's flow: they block nothing. -->
                <StackPanel x:Name="Banners" Grid.Row="1" Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                    <aero:GlassPanel x:Name="ServiceDown" Style="{StaticResource A.Banner}" Margin="0,16,0,0" AutomationProperties.Name="Service not running"
                                     Visibility="{Binding Now.IsServiceDown, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource A.AccentBtn}" Content="Start service" Command="{Binding Now.StartService}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{DynamicResource M.Bad}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource A.Text.Body}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"
                                       Text="Service not running. History stays readable; live readings return when the service starts." />
                        </DockPanel>
                    </aero:GlassPanel>
                    <aero:GlassPanel x:Name="ServiceNotice" Style="{StaticResource A.Banner}" Margin="0,16,0,0" AutomationProperties.Name="Service notice"
                                     Visibility="{Binding Now.Status.Notice, Converter={StaticResource VisibleWhenText}, FallbackValue=Collapsed}">
                        <DockPanel Margin="0,4,8,4">
                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{DynamicResource M.Warn}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource A.Text.Body}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" Text="{Binding Now.Status.Notice}" />
                        </DockPanel>
                    </aero:GlassPanel>
                    <!-- The new look, said once (design §1): Switch back goes to the look the move left, Got it keeps Aero; either,
                         or any look switch, retires it for good. -->
                    <aero:GlassPanel x:Name="LookIntro" Style="{StaticResource A.Banner}" Margin="0,16,0,0" Visibility="Collapsed"
                                     AutomationProperties.Name="PowerLedger has a new look">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="SwitchBackButton" Style="{StaticResource A.GhostBtn}" Content="Switch back" Click="SwitchBackClick" Margin="0,2,8,2" />
                                <Button x:Name="GotItButton" Style="{StaticResource A.AccentBtn}" Content="Got it" Click="GotItClick" Margin="0,2" />
                            </WrapPanel>
                            <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource A.B.Accent}" />
                                <aero:Icon Data="{StaticResource A.I.Bolt}" Size="15" Filled="True" Foreground="{DynamicResource A.B.AccentInk}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource A.Text.Title}" FontSize="{DynamicResource A.T.Body}" Text="PowerLedger has a new look" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock x:Name="LookIntroLine" Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Label}" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                        </DockPanel>
                    </aero:GlassPanel>
                    <aero:GlassPanel x:Name="SwitchProblem" Style="{StaticResource A.Banner}" Margin="0,16,0,0" Visibility="Collapsed"
                                     AutomationProperties.Name="Look switch problem" AutomationProperties.LiveSetting="Assertive">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource A.ExpandBtn}" Click="DismissProblem" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Center">
                                <aero:Icon Data="{StaticResource A.I.Close}" Size="13" />
                            </Button>
                            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{DynamicResource M.Bad}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SwitchProblemText" Style="{StaticResource A.Text.Body}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                        </DockPanel>
                    </aero:GlassPanel>
                </StackPanel>

                <!-- The wizard isn't glass of its own: while it has the window it stands on a pane, so it has a shape to show in. -->
                <aero:GlassPanel x:Name="SetupGlass" Grid.Row="2" Margin="0,16,0,0" IsHitTestVisible="False" SheenEnabled="False" HasShadow="False"
                                 Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}" />
                <local:AeroPageHost x:Name="Pages" Grid.Row="2" Margin="0,16,0,0" Content="{Binding Current}" Page="{Binding Page}" />
            </Grid>
        </Grid>

        <!-- ============ the caption: the window's buttons, each a glass pill of its own ============ -->
        <Grid x:Name="Caption" Height="52" VerticalAlignment="Top" Margin="24,0">
            <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- The demo's own pills (its .demo, bottom right there): Replay intro plays the opening again, Play tour pushes
                     the camera in on the Dashboard's panes in turn. Up here beside the window's buttons: the stage's foot has
                     no room for them outside the panes. Each is a pill of its own, as the caption's are (0.10.6): a group's
                     glass round them read as a wide border. -->
                <StackPanel x:Name="DemoControls" Orientation="Horizontal" Margin="0,0,12,0" Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                    <aero:GlassPanel Style="{StaticResource A.TopPill}">
                        <Button x:Name="ReplayButton" Style="{StaticResource A.GlassBtn}" Height="30" FontSize="{DynamicResource A.T.Small}" Click="ReplayIntroClick"
                                AutomationProperties.Name="Replay intro" ToolTip="Play the opening again">
                            <StackPanel Orientation="Horizontal">
                                <aero:Icon Data="{StaticResource A.I.Replay}" Size="13" StrokeWidth="2.2" VerticalAlignment="Center" />
                                <TextBlock Text="Replay intro" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </aero:GlassPanel>
                    <aero:GlassPanel Style="{StaticResource A.TopPill}" Margin="6,0,0,0">
                        <Button x:Name="TourButton" Style="{StaticResource A.GlassBtn}" Height="30" FontSize="{DynamicResource A.T.Small}" Click="PlayTourClick"
                                AutomationProperties.Name="Play tour" ToolTip="Show the Dashboard's panes one by one">
                            <StackPanel Orientation="Horizontal">
                                <aero:Icon Data="{StaticResource A.I.Play}" Size="13" Filled="True" VerticalAlignment="Center" />
                                <TextBlock Text="Play tour" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </aero:GlassPanel>
                </StackPanel>
                <aero:GlassPanel Style="{StaticResource A.TopPill}" Margin="0,0,6,0">
                    <Button Style="{StaticResource A.RoundGlassBtn}" Width="30" Height="30" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <aero:Icon Data="{StaticResource A.I.Minimize}" Size="14" />
                    </Button>
                </aero:GlassPanel>
                <aero:GlassPanel Style="{StaticResource A.TopPill}" Margin="0,0,6,0">
                    <Button x:Name="MaximizeButton" Style="{StaticResource A.RoundGlassBtn}" Width="30" Height="30" Click="MaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                        <aero:Icon x:Name="MaximizeIcon" Data="{StaticResource A.I.Maximize}" Size="14" StrokeWidth="1.8" />
                    </Button>
                </aero:GlassPanel>
                <aero:GlassPanel Style="{StaticResource A.TopPill}">
                    <Button Style="{StaticResource A.RoundGlassBtn}" Width="30" Height="30" Click="CloseClick" ToolTip="Close to the tray" AutomationProperties.Name="Close">
                        <aero:Icon Data="{StaticResource A.I.Close}" Size="14" />
                    </Button>
                </aero:GlassPanel>
            </StackPanel>
        </Grid>

        <!-- The grip (0.10.1): a small glass disc off the stage's bottom-right corner that resizes the smaller layout. -->
        <aero:GlassPanel x:Name="Grip" Style="{StaticResource A.Grip}" AutomationProperties.Name="Resize">
            <Grid>
                <Ellipse Fill="{DynamicResource A.B.BtnFill}" />
                <Ellipse Stroke="{DynamicResource A.B.BtnEdge}" StrokeThickness="1" />
                <Path Data="M 10,3 L 3,10 M 10,7 L 7,10" Stroke="{DynamicResource A.B.Text2}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </aero:GlassPanel>

        <!-- ============ dialogs and toasts float here, over everything ============ -->
        <Grid x:Name="Layer">
            <Border x:Name="Scrim" Background="{DynamicResource A.B.Scrim}" Visibility="Collapsed" MouseLeftButtonDown="ScrimDown" />
            <Grid x:Name="ModalHost" />
            <Grid x:Name="ToastHost" IsHitTestVisible="False" />
        </Grid>

        <!-- Plan Q §3: while this version is below the data server's minimum, a glass dialog on a scrim covers the page under
             the caption, whose buttons stay, so the window can still go to the tray. -->
        <Grid x:Name="UpdateRequiredCover" Margin="0,52,0,0" Visibility="{Binding UpdateRequired, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
            <Border Background="{DynamicResource A.B.Scrim}" />
            <aero:GlassPanel Style="{StaticResource A.Modal}" AutomationProperties.Name="{Binding RequiredTitle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource A.Text.Title}" FontSize="{DynamicResource A.T.Modal}" TextWrapping="Wrap" TextTrimming="None" Text="{Binding RequiredTitle}" />
                    <TextBlock Style="{StaticResource A.Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None" Text="{Binding RequiredText}" />
                    <TextBlock Style="{StaticResource A.Text.Muted}" Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="None" Text="{Binding RequiredStatus}"
                               Visibility="{Binding RequiredStatus, Converter={StaticResource VisibleWhenText}, FallbackValue=Collapsed}" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource A.GhostBtn}" Content="Close PowerLedger" Command="{Binding ClosePowerLedger}" Margin="0,0,8,0" />
                        <Button x:Name="UpdateNowButton" Style="{StaticResource A.AccentBtn}" Content="Update now" Command="{Binding UpdateNow}" />
                    </StackPanel>
                </StackPanel>
            </aero:GlassPanel>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="PowerLedger.App.Aero.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PowerLedger.App"
             xmlns:aero="clr-namespace:PowerLedger.App.Aero">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Aero's styles and the page styles, the one instance the window merges (SharedDictionary). -->
                <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The sheet's panels sit two to a row, 16 apart. -->
            <Style x:Key="Left" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.Page.Glass}">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Margin" Value="0,16,8,0" />
                <Setter Property="Padding" Value="{StaticResource A.Page.Panel}" />
            </Style>
            <Style x:Key="Right" TargetType="aero:GlassPanel" BasedOn="{StaticResource Left}">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Margin" Value="8,16,0,0" />
            </Style>
            <Style x:Key="Export" TargetType="Button" BasedOn="{StaticResource A.OutlineBtn}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource A.Page.Margin}">

            <!-- The range and the exports: Save as PDF the accent, the rest quiet outlines. -->
            <aero:GlassPanel Style="{StaticResource A.Page.Glass}" Padding="20,18,20,10">
                <StackPanel>
                    <DockPanel Style="{StaticResource A.Page.Head}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource A.AccentBtn}" Content="Save as PDF" Margin="12,0,0,0" Command="{Binding ExportPdf}"
                                ToolTip="Save this report as a PDF" />
                        <Border Style="{StaticResource A.Page.IconWell}">
                            <aero:Icon Data="{StaticResource A.I.Report}" Size="15" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource A.PanelTitle}" Text="{Binding Data.Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource A.Label}" Text="{Binding Data.Period}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Data.Period, Converter={StaticResource VisibleWhenText}}" />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel DataContext="{Binding Range}">
                        <aero:SegTrack Style="{StaticResource A.Page.SegTrack}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="ReportRange" Content="Today"
                                             IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.Today}}" />
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="ReportRange" Content="7 days"
                                             IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.SevenDays}}" />
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="ReportRange" Content="30 days"
                                             IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.ThirtyDays}}" />
                            </StackPanel>
                        </aero:SegTrack>
                        <aero:SegTrack Style="{StaticResource A.Page.SegTrack}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="ReportRange" Content="This month"
                                             IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.ThisMonth}}" />
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="ReportRange" Content="Last month"
                                             IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.LastMonth}}" />
                            </StackPanel>
                        </aero:SegTrack>
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,0">
                        <Button Style="{StaticResource Export}" Content="PNG" Click="SavePicture" ToolTip="Save a picture of this report" />
                        <Button Style="{StaticResource Export}" Content="CSV · 1 h" Command="{Binding ExportCsv}" CommandParameter="Hour" ToolTip="Hour rows for this range" />
                        <Button Style="{StaticResource Export}" Content="CSV · 1 min" Command="{Binding ExportCsv}" CommandParameter="Minute" ToolTip="Minute rows for this range" />
                        <Button Style="{StaticResource Export}" Content="CSV · raw" Command="{Binding ExportCsv}" CommandParameter="Raw"
                                ToolTip="Every reading; raw readings are kept for the last two days" />
                        <!-- Review finding A11: only while this PC is in a household right now. -->
                        <CheckBox Style="{StaticResource A.Tick}" Content="Include my household" IsChecked="{Binding IncludeHousehold}" Margin="6,0,0,8" VerticalAlignment="Center"
                                  Visibility="{Binding HasHousehold, Converter={StaticResource VisibleWhen}}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource A.Page.Note}" Margin="0,0,0,8" Text="{Binding Saved}" Visibility="{Binding Saved, Converter={StaticResource VisibleWhenText}}" />
                    <TextBlock Style="{StaticResource A.Page.Note}" Margin="0,0,0,8" Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </aero:GlassPanel>

            <!-- The sheet: what the PNG export draws, so it holds every panel and the room between them. -->
            <Grid x:Name="Sheet">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <aero:GlassPanel Grid.Row="0" Style="{StaticResource Left}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource A.Page.Title}" Text="Bill" />
                        <Border Style="{StaticResource A.Page.Figures}">
                            <StackPanel>
                                <aero:KeyValue IsHero="True" Key="Energy used" Value="{Binding Data.Energy}" Note="kWh" />
                                <aero:KeyValue Key="Cost" Value="{Binding Data.Cost}" Note="{Binding Data.CostNote}" />
                                <aero:KeyValue Key="CO₂" Value="{Binding Data.Co2}" Note="{Binding Data.Co2Note}" />
                                <aero:KeyValue Key="Average" Value="{Binding Data.Average}" Note="W while on" />
                                <aero:KeyValue Key="Peak" Value="{Binding Data.Peak}" Note="{Binding Data.PeakAt}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </aero:GlassPanel>
                <aero:GlassPanel Grid.Row="0" Style="{StaticResource Right}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource A.Page.Title}" Text="Time" />
                        <Border Style="{StaticResource A.Page.Figures}">
                            <StackPanel>
                                <aero:KeyValue IsHero="True" Key="On" Value="{Binding Data.On}" />
                                <aero:KeyValue Key="Idle, display on" Value="{Binding Data.IdleOn}" />
                                <aero:KeyValue Key="Idle, display off" Value="{Binding Data.IdleOff}" />
                                <aero:KeyValue Key="Asleep" Value="{Binding Data.Asleep}" Note="while the service ran" />
                                <aero:KeyValue Key="Unmonitored" Value="{Binding Data.Unmonitored}" Note="no readings at all" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </aero:GlassPanel>

                <aero:GlassPanel Grid.Row="1" Style="{StaticResource Left}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource A.Label}" Text="kWh" Margin="0,0,58,12" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource A.Page.Title}" Text="By part" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Data.Parts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:PartRow}">
                                    <Border Style="{StaticResource A.Table.Row}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Swatch" Style="{StaticResource A.Page.Dot}" Fill="{DynamicResource M.PartRest}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource A.Page.Cell}" Margin="10,0,12,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource A.Page.Cell.Number}" Text="{Binding Energy}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource A.Page.Cell.Number}" Foreground="{DynamicResource A.B.Text2}" Text="{Binding Share}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Part}" Value="Cpu">
                                            <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartCpu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Part}" Value="Gpu">
                                            <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartGpu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Part}" Value="Display">
                                            <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartDisplay}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </aero:GlassPanel>
                <aero:GlassPanel Grid.Row="1" Style="{StaticResource Right}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource A.Page.Title}" Text="Everyday equivalents" />
                        <Border Style="{StaticResource A.Page.Figures}">
                            <ItemsControl ItemsSource="{Binding Data.Equivalents}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type app:ReportLine}">
                                        <aero:KeyValue Key="{Binding Name}" Value="{Binding Value}" Note="{Binding Note}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </aero:GlassPanel>

                <aero:GlassPanel Grid.Row="2" Style="{StaticResource Left}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource A.Page.Title}" Text="Idle waste" />
                        <Border Style="{StaticResource A.Page.Figures}">
                            <aero:KeyValue IsHero="True" Key="Energy while idle" Value="{Binding Data.IdleWaste}" Note="{Binding Data.IdleWasteNote}" />
                        </Border>
                        <TextBlock Style="{StaticResource A.Page.Prose}" Margin="0,12,0,0" Text="{Binding Data.Advice}"
                                   Visibility="{Binding Data.Advice, Converter={StaticResource VisibleWhenText}}" />
                    </StackPanel>
                </aero:GlassPanel>
                <aero:GlassPanel Grid.Row="2" Style="{StaticResource Right}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource A.Page.Title}" Text="Data quality" />
                        <app:QualityBar Style="{StaticResource A.Page.QualityBar}" Margin="0,4,0,12" Mix="{Binding Data.Quality}" />
                        <WrapPanel>
                            <ContentControl Style="{StaticResource A.Chip.Measured}" Margin="0,0,14,6" />
                            <ContentControl Style="{StaticResource A.Chip.Calibrated}" Content="Calibrated ±10%" Margin="0,0,14,6" />
                            <ContentControl Style="{StaticResource A.Chip.Estimated}" Content="Estimated ±20%" Margin="0,0,14,6" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource A.Page.Prose}" Margin="0,6,0,0" Foreground="{DynamicResource A.B.Text2}" Text="{Binding Data.QualityText}" />
                        <TextBlock Style="{StaticResource A.Page.Note}" Margin="0,8,0,0" Text="{x:Static app:ReportData.QualityLegend}" />
                    </StackPanel>
                </aero:GlassPanel>

                <aero:GlassPanel Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Left}" Margin="{StaticResource A.Page.Gap}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource A.Label}" Text="kWh" VerticalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Style="{StaticResource A.Page.Title}" Text="Energy each day" />
                        </DockPanel>
                        <Border Padding="12,12,12,8" CornerRadius="{DynamicResource A.R.Well}" Background="{DynamicResource A.B.ChartWell}"
                                BorderBrush="{DynamicResource A.B.ChartWellTop}" BorderThickness="0,1,0,0">
                            <app:DailyBars Style="{StaticResource A.Page.DailyBars}" Days="{Binding Data.Days}" AutomationProperties.Name="Energy each day" />
                        </Border>
                    </StackPanel>
                </aero:GlassPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

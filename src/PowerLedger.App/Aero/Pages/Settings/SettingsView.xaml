<UserControl x:Class="PowerLedger.App.Aero.SettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:app="clr-namespace:PowerLedger.App"
             xmlns:aero="clr-namespace:PowerLedger.App.Aero"
             xmlns:contracts="clr-namespace:PowerLedger.Contracts;assembly=PowerLedger.Contracts"
             Foreground="{DynamicResource A.B.Text}" FontFamily="{DynamicResource A.F.Ui}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Aero's styles, the one instance the window merges (SharedDictionary): a view the window's DataTemplate builds
                     resolves its StaticResources before it joins the window. -->
                <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <aero:SameText x:Key="SameText" />

            <!-- The page's measures: the gap round the page and between panes, the label column, a pane's padding. -->
            <Thickness x:Key="Page.Margin">0,0,0,16</Thickness>
            <Thickness x:Key="Pane.Gap">0,0,0,16</Thickness>
            <Thickness x:Key="Pane.Padding">24,20,24,22</Thickness>
            <sys:Double x:Key="Label.Width">200</sys:Double>
            <sys:Double x:Key="Slider.Width">240</sys:Double>
            <sys:Double x:Key="Number.Width">84</sys:Double>

            <!-- Each section a glass pane, as the demo's panels. -->
            <Style x:Key="Pane" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
                <Setter Property="Padding" Value="{StaticResource Pane.Padding}" />
                <Setter Property="Margin" Value="{StaticResource Pane.Gap}" />
            </Style>
            <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource A.PanelTitle}">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <!-- A row: its label in a column of its own, then the control. -->
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="0,6" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource A.Label}">
                <Setter Property="Width" Value="{StaticResource Label.Width}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style x:Key="Aside" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Muted}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,0,0,0" />
            </Style>
            <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Muted}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,6" />
            </Style>
            <!-- A note under a row's control, lined up with it. -->
            <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource Note}">
                <Setter Property="Margin" Value="212,0,0,6" />
            </Style>
            <!-- What came of a save. -->
            <Style x:Key="Said" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Secondary}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource A.Field}">
                <Setter Property="Width" Value="{StaticResource Number.Width}" />
            </Style>
            <Style x:Key="Slider" TargetType="Slider" BasedOn="{StaticResource A.Slider}">
                <Setter Property="Width" Value="{StaticResource Slider.Width}" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Percent" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Number}">
                <Setter Property="Width" Value="48" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
            </Style>
            <!-- A switch's words beside it. -->
            <Style x:Key="SwitchText" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="MaxWidth" Value="420" />
            </Style>

            <!-- ============ the Styles board's Glass (0.10.9): the four style cards and the Glass pane in two columns ============ -->
            <!-- The board's .lab (14 medium, white at 90 %) and .cap (12.5 medium at 75 %). -->
            <Style x:Key="Lab" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource A.B.NavText}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="Cap" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Secondary}">
                <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <!-- The board's .well: navy from 22 % at its top to 10 % at its foot, its inset shade and the hairline of light
                 along its foot as a one-pixel edge, 20 corners. -->
            <Style x:Key="BoardWell" TargetType="Border">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="BorderBrush" Value="{DynamicResource A.B.InsetEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#38000A28" />
                            <GradientStop Offset="1" Color="#1A000A28" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- A row of the Glass pane: its words at the left, its control at the right (the board's space-between). -->
            <Style x:Key="GlassRow" TargetType="DockPanel">
                <Setter Property="LastChildFill" Value="False" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <!-- A style card (the board's): a glass card 300 high, 22 in, of its style's glass; its name 17 semibold and its badge
                 on a small glass pill; a live "Power now" in the board's well; its note under it. A click chooses the style;
                 the chosen card wears the accent's ring, as does the one the keyboard is on. -->
            <Style x:Key="StyleCard" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
                <Setter Property="Height" Value="300" />
                <Setter Property="GroupName" Value="StyleCards" />
                <Setter Property="aero:Press.Enabled" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <aero:GlassPanel Background="{Binding Tint}" Padding="22">
                                    <StackPanel>
                                        <DockPanel>
                                            <aero:GlassPanel DockPanel.Dock="Right" Style="{StaticResource A.Glass.Capsule}" Height="28" Padding="12,0" Bubble="True" Background="#1FFFFFFF">
                                                <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                            </aero:GlassPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Border Style="{StaticResource BoardWell}" Margin="0,18,0,0" Padding="17">
                                            <StackPanel>
                                                <TextBlock Text="Power now" FontSize="{DynamicResource A.T.Small}" FontWeight="Medium" Foreground="{DynamicResource A.B.Text2}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Watts}" FontSize="44" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                                    <TextBlock Text="{Binding Unit}" FontSize="20" FontWeight="Medium" Foreground="{DynamicResource A.B.Text2}" Margin="6,0,0,7" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding Note}" FontSize="13" LineHeight="19.5" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource A.B.NavText}" />
                                    </StackPanel>
                                </aero:GlassPanel>
                                <Border x:Name="Ring" CornerRadius="31" Margin="-3" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- An accent, the board's glass sphere: 32 across, lit from its upper left (the Background's radial), a soft shadow
                 under it (0 4px 10px, navy at 40 %), a little shade at its foot; the chosen one ringed in white at 90 %, 3 px. -->
            <Style x:Key="Sphere" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Pill}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Ellipse x:Name="Ring" Margin="-3" Fill="#E6FFFFFF" Visibility="Collapsed" />
                                <Ellipse Fill="{TemplateBinding Background}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#00051E" RenderingBias="Performance" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.7" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#26000000" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A preset tint: a swatch that is a button, ticked while it is the Colour style's tint. -->
            <Style x:Key="Preset" TargetType="Button" BasedOn="{StaticResource A.Hoverable}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource A.B.Text}" StrokeThickness="2" Opacity="0" />
                                <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="{DynamicResource A.B.WellTop}" StrokeThickness="1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The date a tariff starts: a field with the calendar under a glass button. -->
            <Style x:Key="DateField" TargetType="DatePicker">
                <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
                <Setter Property="Width" Value="150" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid x:Name="PART_Root">
                                <Border CornerRadius="{DynamicResource A.R.Button}" Background="{DynamicResource A.B.Well}" />
                                <Border CornerRadius="{DynamicResource A.R.Button}" BorderBrush="{DynamicResource A.B.WellEdge}" BorderThickness="1" />
                                <DockPanel>
                                    <Button x:Name="PART_Button" DockPanel.Dock="Right" Style="{StaticResource A.GhostBtn}" Height="30" Width="30" Padding="0" Margin="0,0,4,0"
                                            Focusable="False" AutomationProperties.Name="Choose a date">
                                        <aero:Icon Data="{StaticResource A.I.History}" Size="14" />
                                    </Button>
                                    <DatePickerTextBox x:Name="PART_TextBox" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0"
                                                       VerticalContentAlignment="Center" Padding="12,0,4,0" MinHeight="38" CaretBrush="{DynamicResource A.B.Text}">
                                        <DatePickerTextBox.Template>
                                            <ControlTemplate TargetType="DatePickerTextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
                                            </ControlTemplate>
                                        </DatePickerTextBox.Template>
                                    </DatePickerTextBox>
                                </DockPanel>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}" StaysOpen="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource Page.Margin}">
            <Border Style="{StaticResource A.Well}" Margin="{StaticResource Pane.Gap}" Visibility="{Binding Notice, Converter={StaticResource VisibleWhenText}}">
                <TextBlock Style="{StaticResource A.Text.Body}" TextWrapping="Wrap" Text="{Binding Notice}" />
            </Border>

            <!-- The four glass styles (0.10.9, the Styles board's cards): each a card of its style's glass with a live "Power
                 now" in it, the board's 26 apart; a click chooses the style, as the Style choice under them does. -->
            <ItemsControl x:Name="StyleCards" Margin="-13,0,-13,24" Focusable="False" AutomationProperties.Name="Glass styles"
                          KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type aero:StyleCard}">
                        <RadioButton Style="{StaticResource StyleCard}" Margin="13,0" IsChecked="{Binding IsChosen}" Checked="StyleCardChecked"
                                     AutomationProperties.Name="{Binding Name, StringFormat={}{0} glass}" AutomationProperties.HelpText="{Binding Note}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Glass (Aero look design §3; the Styles board's pane): 28 by 32 in, its head and Reset, then two columns 48
                 apart and rows 22 apart: Style and Accent, Tint strength and Edge light, Reduce transparency and Increase
                 contrast, Reduce motion and the Watts overlay, then Show PowerLedger in screenshots; the Colour style's tint
                 under them while it is chosen. Each control sets one field of SettingsViewModel.Glass, which saves it and
                 repaints the look. -->
            <aero:GlassPanel Style="{StaticResource Pane}" DataContext="{Binding GlassSection}" x:Name="GlassPane" Padding="32,28" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,22">
                        <Button DockPanel.Dock="Right" Style="{StaticResource A.GhostBtn}" Content="Reset" Command="{Binding Reset}" Height="36" Padding="16,0"
                                AutomationProperties.Name="Reset the glass" />
                        <TextBlock Style="{StaticResource A.PanelTitle}" FontSize="20" Text="Glass" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Style: the board's segmented well, the chosen one the white glass pill. -->
                        <DockPanel Style="{StaticResource GlassRow}">
                            <TextBlock Style="{StaticResource Lab}" Text="Style" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource A.SegGroup}">
                                <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                                    <RadioButton Style="{StaticResource A.SegOpt}" Content="Clear" IsChecked="{Binding Style, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassStyle.Clear}}" />
                                    <RadioButton Style="{StaticResource A.SegOpt}" Content="Tinted" IsChecked="{Binding Style, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassStyle.Tinted}}" />
                                    <RadioButton Style="{StaticResource A.SegOpt}" Content="Dark" IsChecked="{Binding Style, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassStyle.Dark}}" />
                                    <RadioButton Style="{StaticResource A.SegOpt}" Content="Colour" IsChecked="{Binding Style, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassStyle.Colour}}" />
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Accent: five glass spheres 12 apart. -->
                        <DockPanel Grid.Column="2" Style="{StaticResource GlassRow}">
                            <TextBlock Style="{StaticResource Lab}" Text="Accent" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                                <RadioButton Style="{StaticResource Sphere}" Margin="0" ToolTip="Lime" AutomationProperties.Name="Lime accent"
                                             IsChecked="{Binding Accent, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassAccent.Lime}}">
                                    <RadioButton.Background>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Offset="0" Color="#F4FFB0" /><GradientStop Offset="0.6" Color="#C9E63E" />
                                        </RadialGradientBrush>
                                    </RadioButton.Background>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Sphere}" ToolTip="Ice" AutomationProperties.Name="Ice accent"
                                             IsChecked="{Binding Accent, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassAccent.Ice}}">
                                    <RadioButton.Background>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Offset="0" Color="#E0F6FF" /><GradientStop Offset="0.6" Color="#7FD4FF" />
                                        </RadialGradientBrush>
                                    </RadioButton.Background>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Sphere}" ToolTip="Indigo" AutomationProperties.Name="Indigo accent"
                                             IsChecked="{Binding Accent, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassAccent.Indigo}}">
                                    <RadioButton.Background>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Offset="0" Color="#E8EAFF" /><GradientStop Offset="0.6" Color="#9AA2FF" />
                                        </RadialGradientBrush>
                                    </RadioButton.Background>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Sphere}" ToolTip="Amber" AutomationProperties.Name="Amber accent"
                                             IsChecked="{Binding Accent, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassAccent.Amber}}">
                                    <RadioButton.Background>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Offset="0" Color="#FFF1C9" /><GradientStop Offset="0.6" Color="#FFC857" />
                                        </RadialGradientBrush>
                                    </RadioButton.Background>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Sphere}" ToolTip="Rose" AutomationProperties.Name="Rose accent"
                                             IsChecked="{Binding Accent, Converter={StaticResource Is}, ConverterParameter={x:Static app:GlassAccent.Rose}}">
                                    <RadioButton.Background>
                                        <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.85" RadiusY="0.85">
                                            <GradientStop Offset="0" Color="#FFE0EA" /><GradientStop Offset="0.6" Color="#FF8FB1" />
                                        </RadialGradientBrush>
                                    </RadioButton.Background>
                                </RadioButton>
                            </StackPanel>
                        </DockPanel>

                        <!-- The sliders: the label 140 wide, the slider the rest, 18 apart, its figure in the mono face 40 wide. -->
                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <TextBlock Style="{StaticResource Lab}" Width="140" Text="Tint strength" />
                            <TextBlock DockPanel.Dock="Right" Width="40" Margin="18,0,0,0" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource A.F.Mono}"
                                       FontSize="13" FontWeight="Medium" Text="{Binding TintStrength, StringFormat={}{0:P0}}" />
                            <Slider Style="{StaticResource A.Slider}" Margin="18,0,0,0" Minimum="0" Maximum="1" VerticalAlignment="Center" Value="{Binding TintStrength, Delay=150}" AutomationProperties.Name="Tint strength" />
                        </DockPanel>
                        <!-- No Frost here (0.10.6): the glass shows what is really behind the window, which Windows doesn't blur
                             for it, so the slider would do nothing. -->
                        <DockPanel Grid.Row="2" Grid.Column="2" LastChildFill="True">
                            <TextBlock Style="{StaticResource Lab}" Width="140" Text="Edge light" />
                            <TextBlock DockPanel.Dock="Right" Width="40" Margin="18,0,0,0" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource A.F.Mono}"
                                       FontSize="13" FontWeight="Medium" Text="{Binding EdgeLight, StringFormat={}{0:P0}}" />
                            <Slider Style="{StaticResource A.Slider}" Margin="18,0,0,0" Minimum="0" Maximum="1" VerticalAlignment="Center" Value="{Binding EdgeLight, Delay=150}" AutomationProperties.Name="Edge light" />
                        </DockPanel>

                        <!-- The switches: the words and the board's caption under them at the left, the switch at the right. -->
                        <DockPanel Grid.Row="4" Style="{StaticResource GlassRow}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Lab}" Text="Reduce transparency" />
                                <TextBlock Style="{StaticResource Cap}" Text="Denser glass, still glass" />
                            </StackPanel>
                            <aero:GlassSwitch DockPanel.Dock="Right" IsChecked="{Binding ReduceTransparency}" AutomationProperties.Name="Reduce transparency" />
                        </DockPanel>
                        <DockPanel Grid.Row="4" Grid.Column="2" Style="{StaticResource GlassRow}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Lab}" Text="Increase contrast" />
                                <TextBlock Style="{StaticResource Cap}" Text="Stronger edges and text" />
                            </StackPanel>
                            <aero:GlassSwitch DockPanel.Dock="Right" IsChecked="{Binding IncreaseContrast}" AutomationProperties.Name="Increase contrast" />
                        </DockPanel>
                        <DockPanel Grid.Row="6" Style="{StaticResource GlassRow}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Lab}" Text="Reduce motion" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Cap}" Text="{Binding ReduceMotionNote}" />
                                    <Button Style="{StaticResource A.GhostBtn}" Content="Follow Windows" Command="{Binding FollowWindows}" Height="26" Padding="12,0" Margin="10,0,0,0"
                                            FontSize="{DynamicResource A.T.Small}" Visibility="{Binding FollowsWindows, Converter={StaticResource HiddenWhen}}" />
                                </StackPanel>
                            </StackPanel>
                            <aero:GlassSwitch DockPanel.Dock="Right" IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="Reduce motion" />
                        </DockPanel>
                        <!-- The watts overlay (Aero look design §5): on or off here; its corner, opacity and sparkline in Overlay below. -->
                        <DockPanel Grid.Row="6" Grid.Column="2" Style="{StaticResource GlassRow}" DataContext="{Binding DataContext.OverlaySection, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Lab}" Text="Watts overlay" />
                                <TextBlock Style="{StaticResource Cap}" Text="A glass pill over other windows" />
                            </StackPanel>
                            <aero:GlassSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled}" AutomationProperties.Name="Watts overlay" />
                        </DockPanel>
                        <!-- The live glass keeps PowerLedger's windows out of screenshots and screen shares (0.10.9, the owner's
                             choice): on, they appear in them, and the glass shows the wallpaper instead. -->
                        <DockPanel Grid.Row="8" Style="{StaticResource GlassRow}">
                            <StackPanel VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left">
                                <TextBlock Style="{StaticResource Lab}" Text="Show PowerLedger in screenshots" />
                                <TextBlock Style="{StaticResource Cap}" TextWrapping="Wrap" Text="Off keeps it out of captures; on, the glass shows your wallpaper" />
                            </StackPanel>
                            <aero:GlassSwitch x:Name="ScreenshotsSwitch" DockPanel.Dock="Right" IsChecked="{Binding ShowInScreenshots}" AutomationProperties.Name="Show PowerLedger in screenshots"
                                              AutomationProperties.HelpText="Off: the glass shows the windows behind it live, and PowerLedger stays out of screenshots and screen shares. On: it appears in them, and the glass uses your wallpaper."
                                              ToolTip="Off: the glass shows the windows behind it live, and PowerLedger stays out of screenshots and screen shares. On: it appears in them, and the glass uses your wallpaper." />
                        </DockPanel>
                        <!-- No Tilt and parallax here (0.10.4): Aero's free-form window floats its glass over the real desktop,
                             which never tilts, so the switch would do nothing. -->

                        <!-- The Colour style's tint: 8 presets and the wheel, while Colour is chosen. -->
                        <DockPanel Grid.Row="9" Grid.ColumnSpan="3" Margin="0,22,0,0" Visibility="{Binding IsColour, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource Lab}" Width="140" Text="Tint colour" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{x:Static aero:GlassSection.Presets}" Focusable="False" Width="160" VerticalAlignment="Top" Margin="18,0,24,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type aero:TintPreset}">
                                        <Button Style="{StaticResource Preset}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.ChoosePreset, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Hex}">
                                            <Button.Background>
                                                <SolidColorBrush Color="{Binding Colour}" />
                                            </Button.Background>
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource SameText}">
                                                    <Binding Path="Hex" />
                                                    <Binding Path="DataContext.ChosenTint" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <aero:ColourWheel Width="160" Height="160" HorizontalAlignment="Left" Colour="{Binding Tint, Delay=150}" AutomationProperties.Name="Tint colour wheel" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </aero:GlassPanel>

            <!-- The watts overlay's place (Aero look design §5): its corner, opacity and sparkline, as its own menu has them; it
                 is switched on and off in Glass above. -->
            <aero:GlassPanel Style="{StaticResource Pane}" DataContext="{Binding OverlaySection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Overlay" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Where" />
                        <WrapPanel MaxWidth="560">
                            <RadioButton Style="{StaticResource A.OptItem}" Content="Top left" Margin="0,0,6,6" IsChecked="{Binding Position, Converter={StaticResource Is}, ConverterParameter={x:Static app:OverlayPosition.TopLeft}}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="Top right" Margin="0,0,6,6" IsChecked="{Binding Position, Converter={StaticResource Is}, ConverterParameter={x:Static app:OverlayPosition.TopRight}}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="Bottom left" Margin="0,0,6,6" IsChecked="{Binding Position, Converter={StaticResource Is}, ConverterParameter={x:Static app:OverlayPosition.BottomLeft}}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="Bottom right" Margin="0,0,6,6" IsChecked="{Binding Position, Converter={StaticResource Is}, ConverterParameter={x:Static app:OverlayPosition.BottomRight}}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="Free" Margin="0,0,6,6" IsChecked="{Binding Position, Converter={StaticResource Is}, ConverterParameter={x:Static app:OverlayPosition.Free}}" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource RowNote}" Text="Free keeps it where you drag it. Right-click the overlay for the same choices." />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Opacity" />
                        <Slider Style="{StaticResource Slider}" Minimum="{x:Static app:OverlaySettings.MinOpacity}" Value="{Binding Opacity, Delay=150}" AutomationProperties.Name="Overlay opacity" />
                        <TextBlock Style="{StaticResource Percent}" Text="{Binding Opacity, StringFormat={}{0:P0}}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Sparkline" />
                        <aero:GlassSwitch IsChecked="{Binding Sparkline}" AutomationProperties.Name="Overlay sparkline" />
                        <TextBlock Style="{StaticResource SwitchText}" Text="The last 30 seconds under the watts" />
                    </StackPanel>
                </StackPanel>
            </aero:GlassPanel>

            <aero:GlassPanel Style="{StaticResource Pane}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Tariff" />
                    <ItemsControl ItemsSource="{Binding TariffHistory}" Margin="0,0,0,8" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource A.Text.Number}" FontSize="{DynamicResource A.T.Small}" Margin="0,2" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel DataContext="{Binding Tariff}">
                        <TextBlock Style="{StaticResource A.Text.Secondary}" Text="Price per kWh" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Style="{StaticResource Field}" Width="90" Margin="0,0,16,8" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Price per kWh" />
                        <TextBlock Style="{StaticResource A.Text.Secondary}" Text="Currency" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Style="{StaticResource Field}" Margin="0,0,16,8" MaxLength="3" CharacterCasing="Upper" Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Currency" />
                        <TextBlock Style="{StaticResource A.Text.Secondary}" Text="From" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <DatePicker Style="{StaticResource DateField}" Margin="0,0,16,8" SelectedDate="{Binding From}" AutomationProperties.Name="First day of the tariff" />
                        <Button Style="{StaticResource A.AccentBtn}" Content="Save tariff" Command="{Binding Save}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Said}" DataContext="{Binding Tariff}" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}" />
                    <TextBlock Style="{StaticResource Note}" Text="Energy already recorded is priced again from the day a tariff starts, so a tariff may start in the past." />
                </StackPanel>
            </aero:GlassPanel>

            <!-- The service's settings save themselves: a box gives the form what was typed once it is left or Enter is pressed; a
                 tick or a choice gives it at once. -->
            <StackPanel DataContext="{Binding Service}" IsEnabled="{Binding IsLoaded}" app:SettingsEntry.SavesOnEnter="True">
                <aero:GlassPanel Style="{StaticResource Pane}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Machine" />
                        <TextBlock Style="{StaticResource Note}" Margin="0,0,0,6"
                                   Text="{Binding DataContext.Detected, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=Detected: {0}}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Chassis" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="Laptop"
                                         IsChecked="{Binding Chassis, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:ChassisKind.Laptop}}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="Desktop"
                                         IsChecked="{Binding Chassis, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:ChassisKind.Desktop}}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding IsDesktop, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource Label}" Text="Power supply rating" />
                            <WrapPanel MaxWidth="560">
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="White" IsChecked="{Binding PsuTier, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:PsuTier.White}}" />
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="Bronze" IsChecked="{Binding PsuTier, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:PsuTier.Bronze}}" />
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="Silver" IsChecked="{Binding PsuTier, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:PsuTier.Silver}}" />
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="Gold" IsChecked="{Binding PsuTier, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:PsuTier.Gold}}" />
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="Platinum" IsChecked="{Binding PsuTier, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:PsuTier.Platinum}}" />
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="Titanium" IsChecked="{Binding PsuTier, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:PsuTier.Titanium}}" />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Memory sticks" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding RamSticks, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Memory sticks" />
                            <CheckBox Style="{StaticResource A.Tick}" Content="DDR5" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="{Binding RamIsDdr5}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="SSDs · hard drives · fans" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding SsdCount, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="SSDs" />
                            <TextBox Style="{StaticResource Field}" Margin="8,0,0,0" Text="{Binding HddCount, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hard drives" />
                            <TextBox Style="{StaticResource Field}" Margin="8,0,0,0" Text="{Binding FanCount, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Fans" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Built-in panel, inches" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding PanelInches, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Built-in panel, inches" />
                            <TextBlock Style="{StaticResource Aside}" Text="0 for none" />
                        </StackPanel>
                        <!-- Each external monitor the service detected: its figure and where it came from, what it draws now and its
                             brightness, a figure of the user's own, whether it counts and, on a laptop, whether it has a plug of its own. -->
                        <ItemsControl ItemsSource="{Binding Monitors}" Focusable="False" Visibility="{Binding HasMonitors, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:MonitorRow}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="212" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource A.Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="0,10,12,0">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Size, Mode=OneWay}" Foreground="{DynamicResource A.B.Text3}" />
                                        </TextBlock>
                                        <WrapPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                <TextBox Style="{StaticResource Field}" VerticalAlignment="Center" Text="{Binding Watts, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.Name="{Binding Name, StringFormat=Watts for {0}}" />
                                                <TextBlock Style="{StaticResource Aside}" Text="W" />
                                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource A.Tick}" Content="Count it" IsChecked="{Binding Counted}" IsEnabled="{Binding OwnPlug}"
                                                              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name, StringFormat=Count {0}}" />
                                                    <CheckBox Style="{StaticResource A.Tick}" Content="has its own plug" Margin="0,6,0,0" IsChecked="{Binding OwnPlug}"
                                                              Visibility="{Binding ShowsPlug, Converter={StaticResource VisibleWhen}}"
                                                              AutomationProperties.Name="{Binding Name, StringFormat={}{0} has its own plug}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
                                                <TextBlock Style="{StaticResource A.Text.Muted}" TextWrapping="Wrap" Text="{Binding Source}"
                                                           Visibility="{Binding Source, Converter={StaticResource VisibleWhenText}}" />
                                                <TextBlock Style="{StaticResource A.Text.Muted}" TextWrapping="Wrap">
                                                    <Run Text="{Binding Now, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Brightness, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,2,0,6" Visibility="{Binding HasMonitors, Converter={StaticResource VisibleWhen}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                                    <Setter Property="Text" Value="A monitor of 17.3 inches or less is taken to run off this laptop, so it counts as part of what the laptop draws; tick &quot;has its own plug&quot; if it has one. Untick a monitor with its own plug to leave it out. PowerLedger reads whether each monitor is on, if allowed under Preferences; where it can't tell, unticking a monitor while it's off keeps it out. Clear a monitor's watts to go back to PowerLedger's own figure." />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDesktop}" Value="True">
                                            <Setter Property="Text" Value="Untick a monitor to leave it out. PowerLedger reads whether each monitor is on, if allowed under Preferences; where it can't tell, unticking a monitor while it's off keeps it out. Clear a monitor's watts to go back to PowerLedger's own figure." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasMonitors, Converter={StaticResource HiddenWhen}}">
                            <TextBlock Style="{StaticResource Label}" Text="External monitors" />
                            <TextBlock Style="{StaticResource A.Text.Muted}" VerticalAlignment="Center" Text="none detected" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Upses}" Focusable="False" Visibility="{Binding HasUps, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource A.Text.Body}" TextWrapping="Wrap" Margin="0,6" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding HasUps, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource Label}" Text="What does it power?" />
                            <WrapPanel MaxWidth="560">
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="This PC"
                                             IsChecked="{Binding UpsLoad, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:UpsLoad.ThisPc}}" />
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="This PC and its monitors"
                                             IsChecked="{Binding UpsLoad, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:UpsLoad.ThisPcAndMonitors}}" />
                                <RadioButton Style="{StaticResource A.OptItem}" Margin="0,0,6,6" Content="More"
                                             IsChecked="{Binding UpsLoad, Converter={StaticResource Is}, ConverterParameter={x:Static contracts:UpsLoad.More}}" />
                            </WrapPanel>
                        </StackPanel>
                        <!-- A UPS another computer shares over Network UPS Tools, as Classic and Midnight ask for it, in Aero's wells: the
                             server, its port, the UPS's name there and, for a server that lists only to known users, a username and
                             password. Once the service reads it, it is listed with the UPSes above and asks what it powers; until then,
                             what the service says of it shows under the rows. -->
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="UPS on another computer (NUT)" />
                            <TextBox Style="{StaticResource Field}" Width="200" Text="{Binding NutHost, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="UPS server"
                                     ToolTip="The computer that shares the UPS: a name or an IP address" />
                            <TextBlock Style="{StaticResource Aside}" Text="port" />
                            <TextBox Style="{StaticResource Field}" Margin="10,0,0,0" Text="{Binding NutPort, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="UPS server port" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="UPS name on that computer" />
                            <TextBox Style="{StaticResource Field}" Width="200" Text="{Binding NutUps, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="UPS name on the server" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Username · password, if asked" />
                            <TextBox Style="{StaticResource Field}" Width="140" Text="{Binding NutUser, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="UPS server username" />
                            <PasswordBox Style="{StaticResource A.Secret}" Width="140" Margin="8,0,0,0" app:PasswordEntry.Typed="{Binding NutPassword, Mode=OneWayToSource}"
                                         AutomationProperties.Name="UPS server password" />
                            <TextBlock Style="{StaticResource Aside}" Text="saved" Visibility="{Binding NutHasPassword, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Said}" Margin="212,2,0,4" Text="{Binding NutSaid}" Visibility="{Binding NutSaid, Converter={StaticResource VisibleWhenText}}" />
                        <TextBlock Style="{StaticResource RowNote}" Margin="212,2,0,6"
                                   Text="For a UPS that another computer, such as a NAS, shares with Network UPS Tools. Leave the server blank for none. The service keeps the password encrypted." />
                        <ItemsControl ItemsSource="{Binding PowerSupplies}" Focusable="False" Visibility="{Binding HasPowerSupply, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource A.Text.Body}" TextWrapping="Wrap" Margin="0,6" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Style="{StaticResource Row}" Visibility="{Binding AsksToReadPowerSupply, Converter={StaticResource VisibleWhen}}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPowerSupply}" Value="False">
                                                <Setter Property="Text" Value="Power supply" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <CheckBox Style="{StaticResource A.Tick}" Content="Read this power supply" VerticalAlignment="Center" IsChecked="{Binding ReadPowerSupply}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Extras such as lights and pumps, W" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding ExtrasWatts, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Extras in watts" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Processor · graphics rated power, W" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding CpuTdp, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Processor rated power" />
                            <TextBox Style="{StaticResource Field}" Margin="8,0,0,0" Text="{Binding GpuTdp, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Graphics rated power" />
                            <TextBlock Style="{StaticResource Aside}" Text="blank: from PowerLedger's table" TextWrapping="Wrap" MaxWidth="220" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Said}" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}" />
                    </StackPanel>
                </aero:GlassPanel>

                <aero:GlassPanel Style="{StaticResource Pane}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Title}" Text="Sampling and history" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Idle after, minutes" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding IdleMinutes, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Idle after, minutes" />
                            <TextBlock Style="{StaticResource Aside}" Text="1 to 30" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Sample every, seconds" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="1" IsChecked="{Binding SampleInterval, Converter={StaticResource Is}, ConverterParameter=1}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="2" IsChecked="{Binding SampleInterval, Converter={StaticResource Is}, ConverterParameter=2}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="3" IsChecked="{Binding SampleInterval, Converter={StaticResource Is}, ConverterParameter=3}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="4" IsChecked="{Binding SampleInterval, Converter={StaticResource Is}, ConverterParameter=4}" />
                            <RadioButton Style="{StaticResource A.OptItem}" Content="5" IsChecked="{Binding SampleInterval, Converter={StaticResource Is}, ConverterParameter=5}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Keep every reading for, hours" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding RawHours, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hours of every reading" />
                            <TextBlock Style="{StaticResource Aside}" Text="24 to 168" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource Label}" Text="Keep minute totals for, years" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding HistoryYears, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Years of minute totals" />
                            <TextBlock Style="{StaticResource Aside}" Text="1 to 5; hourly totals are kept for good" />
                        </StackPanel>
                    </StackPanel>
                </aero:GlassPanel>
            </StackPanel>

            <aero:GlassPanel Style="{StaticResource Pane}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Calibration" />
                    <TextBlock Style="{StaticResource A.Text.Body}" TextWrapping="Wrap" Text="{Binding Calibration}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding ConfirmingReset, Converter={StaticResource HiddenWhen}}">
                        <Button Style="{StaticResource A.OutlineBtn}" Content="Reset calibration" Command="{Binding ResetCalibration}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding ConfirmingReset, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource A.Text.Body}" Text="Forget what was learned on battery?" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource A.OutlineBtn}" Content="Keep" Command="{Binding CancelReset}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource A.AccentBtn}" Content="Reset" Command="{Binding ConfirmReset}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Said}" Text="{Binding CalibrationMessage}" Visibility="{Binding CalibrationMessage, Converter={StaticResource VisibleWhenText}}" />
                </StackPanel>
            </aero:GlassPanel>

            <aero:GlassPanel Style="{StaticResource Pane}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Preferences" />
                    <!-- The one carbon setting: the report's and the Carbon insight's grid factor alike. -->
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="CO₂ per kWh, kg" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding Co2, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kilograms of CO2 per kWh" />
                        <Button Style="{StaticResource A.OutlineBtn}" Content="Save" Command="{Binding SaveCo2}" Margin="12,0,0,0" />
                        <Button Style="{StaticResource A.OutlineBtn}" Content="{Binding RegionCo2Offer}" Command="{Binding UseRegionCo2}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource RowNote}" Text="Use your electricity supplier's figure for its grid; 0.40 is the world average." />
                    <TextBlock Style="{StaticResource Said}" Text="{Binding Co2Message}" Visibility="{Binding Co2Message, Converter={StaticResource VisibleWhenText}}" />
                    <!-- Aero look design §1: the look, in every look. -->
                    <!-- The existing Theme choice. -->
                    <StackPanel Style="{StaticResource Row}" Margin="0,12,0,6">
                        <TextBlock Style="{StaticResource Label}" Text="Appearance" />
                        <Border Style="{StaticResource A.SegGroup}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource A.SegOpt}" Content="Like Windows" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter={x:Static app:ThemeChoice.System}}" />
                                <RadioButton Style="{StaticResource A.SegOpt}" Content="Dark" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter={x:Static app:ThemeChoice.Dark}}" />
                                <RadioButton Style="{StaticResource A.SegOpt}" Content="Light" IsChecked="{Binding Theme, Converter={StaticResource Is}, ConverterParameter={x:Static app:ThemeChoice.Light}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Look" />
                        <RadioButton Style="{StaticResource A.OptItem}" Content="Classic" IsChecked="{Binding Look, Converter={StaticResource Is}, ConverterParameter={x:Static app:Look.Classic}}" />
                        <RadioButton Style="{StaticResource A.OptItem}" Content="Midnight" IsChecked="{Binding Look, Converter={StaticResource Is}, ConverterParameter={x:Static app:Look.Midnight}}" />
                        <RadioButton Style="{StaticResource A.OptItem}" Content="Aero" IsChecked="{Binding Look, Converter={StaticResource Is}, ConverterParameter={x:Static app:Look.Aero}}" />
                        <!-- Plan S intro: the intro video again, any time, out of this button; it counts against nothing. -->
                        <Button x:Name="WatchIntroButton" Style="{StaticResource A.OutlineBtn}" Content="Watch the Aero intro" Height="30" Margin="12,0,0,0"
                                Click="WatchIntroClick" AutomationProperties.Name="Watch the Aero intro" />
                    </StackPanel>
                    <!-- 0.10.9: the demo's Replay intro and Play tour, off the window's chrome and here: the opening again, or the
                         camera on the Dashboard's panes one by one. -->
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Intro and tour" />
                        <Button x:Name="ReplayButton" Style="{StaticResource A.OutlineBtn}" Height="30" Click="ReplayIntroClick" AutomationProperties.Name="Replay intro" ToolTip="Play the opening again">
                            <StackPanel Orientation="Horizontal">
                                <aero:Icon Data="{StaticResource A.I.Replay}" Size="13" StrokeWidth="2.2" VerticalAlignment="Center" />
                                <TextBlock Text="Replay intro" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TourButton" Style="{StaticResource A.OutlineBtn}" Height="30" Margin="8,0,0,0" Click="PlayTourClick" AutomationProperties.Name="Play tour" ToolTip="Show the Dashboard's panes one by one">
                            <StackPanel Orientation="Horizontal">
                                <aero:Icon Data="{StaticResource A.I.Play}" Size="12" Filled="True" VerticalAlignment="Center" />
                                <TextBlock Text="Play tour" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- 0.10.7: Aero is by request. While locked, Request Aero sends this PC's request ID, which the owner approves. -->
                    <StackPanel Style="{StaticResource Row}" Visibility="{Binding AeroLocked, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource Label}" Text="Aero" />
                        <Button Style="{StaticResource A.OutlineBtn}" Content="Request Aero" Command="{Binding Aero.Request}" AutomationProperties.Name="Request Aero" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Aero.HasRequested, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                        <TextBlock Style="{StaticResource RowNote}" Text="{Binding Aero.RequestText}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowNote}" Text="{Binding Aero.Status, StringFormat=Status: {0}}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource A.OutlineBtn}" Content="Copy ID" Command="{Binding Aero.CopyId}" Margin="12,0,0,0" AutomationProperties.Name="Copy request ID" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Start with Windows" />
                        <aero:GlassSwitch IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                        <TextBlock Style="{StaticResource SwitchText}" Text="In the tray, when you sign in" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Monitors" />
                        <aero:GlassSwitch IsChecked="{Binding ReadMonitorBrightness}" AutomationProperties.Name="Read monitors' brightness" />
                        <TextBlock Style="{StaticResource SwitchText}" Text="Read monitors' brightness and whether they're on (read-only)" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Said}" Text="{Binding AppMessage}" Visibility="{Binding AppMessage, Converter={StaticResource VisibleWhenText}}" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Updates" />
                        <!-- Plan Q §4: updates are always on, so there is no switch; the note below says where they stand. -->
                        <Button Style="{StaticResource A.OutlineBtn}" Content="Check now" Command="{Binding Updates.CheckNow}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource RowNote}" Text="{Binding Updates.Status}"
                               Visibility="{Binding Updates.Status, Converter={StaticResource VisibleWhenText}, FallbackValue=Collapsed}" />
                </StackPanel>
            </aero:GlassPanel>

            <aero:GlassPanel Style="{StaticResource Pane}" DataContext="{Binding Privacy}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Privacy" />
                    <StackPanel Style="{StaticResource Row}">
                        <aero:GlassSwitch IsChecked="{Binding Diagnostics}" AutomationProperties.Name="Crash and sensor reports" VerticalAlignment="Top" />
                        <StackPanel Margin="12,0,0,0" MaxWidth="640">
                            <TextBlock Style="{StaticResource A.Text.Body}" FontWeight="SemiBold" Text="Crash and sensor reports" />
                            <TextBlock Style="{StaticResource Note}" Text="When PowerLedger crashes or a sensor fails, send what went wrong and on which hardware, so it can be fixed." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <aero:GlassSwitch IsChecked="{Binding Usage}" AutomationProperties.Name="Usage" VerticalAlignment="Top" />
                        <StackPanel Margin="12,0,0,0" MaxWidth="640">
                            <TextBlock Style="{StaticResource A.Text.Body}" FontWeight="SemiBold" Text="Usage" />
                            <TextBlock Style="{StaticResource Note}" Text="Send how PowerLedger is used, so the next version works on what matters." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <aero:GlassSwitch IsChecked="{Binding Power}" AutomationProperties.Name="Hardware and power" VerticalAlignment="Top" />
                        <StackPanel Margin="12,0,0,0" MaxWidth="640">
                            <TextBlock Style="{StaticResource A.Text.Body}" FontWeight="SemiBold" Text="Hardware and power" />
                            <TextBlock Style="{StaticResource Note}" Text="Send this PC's parts and its power, minute by minute, so PowerLedger's estimates get more accurate for everyone." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <aero:GlassSwitch IsChecked="{Binding Share}" IsEnabled="{Binding Power}" AutomationProperties.Name="Share my detailed data" VerticalAlignment="Top"
                                          ToolTipService.ShowOnDisabled="True" ToolTip="Needs Hardware and power turned on" />
                        <StackPanel Margin="12,0,0,0" MaxWidth="640">
                            <TextBlock Style="{StaticResource A.Text.Body}" FontWeight="SemiBold" Text="Share my detailed data" />
                            <TextBlock Style="{StaticResource Note}"
                                       Text="Let what Hardware and power sends be given or sold, as it is, to researchers, hardware makers and energy companies. It goes under a random ID, never your name. Copies already shared can't be taken back." />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Said}" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}" />

                    <StackPanel Style="{StaticResource Row}" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Install ID" />
                        <TextBlock Style="{StaticResource A.Text.Number}" FontSize="{DynamicResource A.T.Small}" VerticalAlignment="Center" Text="{Binding InstallId}" />
                        <Button Style="{StaticResource A.OutlineBtn}" Content="Copy" Command="{Binding CopyInstallId}" Margin="12,0,0,0" Height="30" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource RowNote}" Text="{Binding Status}" />

                    <WrapPanel Margin="0,14,0,0" Visibility="{Binding ConfirmingDelete, Converter={StaticResource HiddenWhen}}">
                        <Button Style="{StaticResource A.OutlineBtn}" Content="What's been sent…" Command="{Binding OpenSent}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource A.OutlineBtn}" Content="Delete my data…" Command="{Binding DeleteMyData}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource A.GhostBtn}" Content="Privacy policy" Command="{Binding OpenPrivacyPolicy}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding ConfirmingDelete, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource A.Text.Title}" Text="Delete my data" />
                        <TextBlock Style="{StaticResource Note}"
                                   Text="This deletes everything PowerLedger has sent from this PC from the server and turns every switch off. Data already shared with others can't be recalled." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource A.OutlineBtn}" Content="Cancel" Command="{Binding CancelDelete}" />
                            <Button Style="{StaticResource A.AccentBtn}" Content="Delete" Command="{Binding ConfirmDelete}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </aero:GlassPanel>

            <aero:GlassPanel Style="{StaticResource Pane}" DataContext="{Binding Household}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="Household" />
                    <StackPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource Label}" Text="Discoverable" />
                        <aero:GlassSwitch IsChecked="{Binding Discoverable}" AutomationProperties.Name="Discoverable" />
                        <TextBlock Style="{StaticResource SwitchText}" Text="Let my other PCs find this one on the network" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Said}" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}" />
                </StackPanel>
            </aero:GlassPanel>

            <aero:GlassPanel Style="{StaticResource Pane}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Title}" Text="About" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="{StaticResource Brand.Mark}" Width="36" Height="36" VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource A.Text.Title}" Text="PowerLedger" />
                            <TextBlock Style="{StaticResource A.Text.Muted}" Text="How much power this PC uses, and what it costs" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource A.Text.Body}" Text="{Binding ServiceState}" />
                    <TextBlock Style="{StaticResource A.Text.Secondary}" Margin="0,4,0,0" Text="{Binding Database, StringFormat=Database {0}}" />
                    <TextBlock Style="{StaticResource A.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" Text="No driver: readings come from interfaces Windows already provides." />
                    <TextBlock Style="{StaticResource A.Text.Secondary}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Monitor figures come from the ENERGY STAR Certified Displays list (US EPA, public domain). PowerLedger isn't endorsed by ENERGY STAR." />
                    <Border Style="{StaticResource A.Table.Header}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="212" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource A.Text.Small}" Foreground="{DynamicResource A.B.Text3}" Text="Source" />
                            <TextBlock Grid.Column="1" Style="{StaticResource A.Text.Small}" Foreground="{DynamicResource A.B.Text3}" Text="State" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Sources}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:SourceLine}">
                                <Border Style="{StaticResource A.Table.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="212" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource A.Text.Body}" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource A.Text.Secondary}" Text="{Binding State}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource A.Text.Muted}" TextWrapping="Wrap" Text="{Binding Detail}" VerticalAlignment="Center" Margin="0,8" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource A.OutlineBtn}" Content="Run setup again" Command="{Binding RunSetup}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </aero:GlassPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

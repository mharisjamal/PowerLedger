<UserControl x:Class="PowerLedger.App.Aero.PartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PowerLedger.App"
             xmlns:aero="clr-namespace:PowerLedger.App.Aero">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Aero's styles and the page styles, the one instance the window merges (SharedDictionary). -->
                <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The table's columns, one set for the heads and every row: the part and its model take what is left. Energy's is
                 wide enough for its change against before in full, "About the same" the widest. -->
            <GridLength x:Key="Swatch">22</GridLength>
            <GridLength x:Key="Now">64</GridLength>
            <GridLength x:Key="Energy">96</GridLength>
            <GridLength x:Key="Share">72</GridLength>
            <GridLength x:Key="Quality">104</GridLength>
            <GridLength x:Key="Trend">100</GridLength>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource A.Page.Margin}">
            <aero:GlassPanel Style="{StaticResource A.Page.Glass}" Padding="20,18,20,12">
                <StackPanel>
                    <DockPanel Style="{StaticResource A.Page.Head}">
                        <aero:SegTrack DockPanel.Dock="Right" Style="{StaticResource A.Page.SegTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="PartsRange" Content="Today"
                                             IsChecked="{Binding PartsRange, Converter={StaticResource Is}, ConverterParameter={x:Static app:PartsRange.Today}}" />
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="PartsRange" Content="7 days"
                                             IsChecked="{Binding PartsRange, Converter={StaticResource Is}, ConverterParameter={x:Static app:PartsRange.SevenDays}}" />
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="PartsRange" Content="30 days"
                                             IsChecked="{Binding PartsRange, Converter={StaticResource Is}, ConverterParameter={x:Static app:PartsRange.ThirtyDays}}" />
                            </StackPanel>
                        </aero:SegTrack>
                        <Border Style="{StaticResource A.Page.IconWell}">
                            <aero:Icon Data="{StaticResource A.I.Chip}" Size="15" />
                        </Border>
                        <TextBlock Style="{StaticResource A.PanelTitle}" Text="Parts" />
                    </DockPanel>

                    <Border Style="{StaticResource A.Table.Header}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Swatch}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource Now}" />
                                <ColumnDefinition Width="{StaticResource Energy}" />
                                <ColumnDefinition Width="{StaticResource Share}" />
                                <ColumnDefinition Width="{StaticResource Quality}" />
                                <ColumnDefinition Width="{StaticResource Trend}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource A.Page.Head.Cell}" Margin="10,0,0,0" Text="Part" />
                            <TextBlock Grid.Column="2" Style="{StaticResource A.Page.Head.Cell}" HorizontalAlignment="Right" Text="Now" />
                            <TextBlock Grid.Column="3" Style="{StaticResource A.Page.Head.Cell}" HorizontalAlignment="Right" Text="Energy" />
                            <TextBlock Grid.Column="4" Style="{StaticResource A.Page.Head.Cell}" Margin="16,0,0,0" Text="Share" />
                            <TextBlock Grid.Column="5" Style="{StaticResource A.Page.Head.Cell}" Margin="8,0,0,0" Text="Quality" />
                            <TextBlock Grid.Column="6" Style="{StaticResource A.Page.Head.Cell}" Margin="4,0,0,0" Text="Last 7 days" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:DashboardPart}">
                                <Border Style="{StaticResource A.Table.Row}" MinHeight="56">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource Swatch}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{StaticResource Now}" />
                                            <ColumnDefinition Width="{StaticResource Energy}" />
                                            <ColumnDefinition Width="{StaticResource Share}" />
                                            <ColumnDefinition Width="{StaticResource Quality}" />
                                            <ColumnDefinition Width="{StaticResource Trend}" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Swatch" Style="{StaticResource A.Page.Dot}" Fill="{DynamicResource M.PartRest}" HorizontalAlignment="Right" />
                                        <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource A.Page.Cell}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource A.Text.Small}" Foreground="{DynamicResource A.B.Text2}" Margin="0,2,0,0" Text="{Binding Model}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" Visibility="{Binding Model, Converter={StaticResource VisibleWhenText}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource A.Page.Cell.Number}" Text="{Binding NowW}" />
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Style="{StaticResource A.Page.Cell.Number}" Text="{Binding Energy}" />
                                            <TextBlock x:Name="Trend" Style="{StaticResource A.Text.Small}" Foreground="{DynamicResource A.B.Text2}" HorizontalAlignment="Right"
                                                       Margin="0,2,0,0" Text="{Binding Trend}" Visibility="{Binding Trend, Converter={StaticResource VisibleWhenText}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource A.Page.Cell}" Text="{Binding Share, StringFormat={}{0:0%}}" />
                                            <app:ShareBar x:Name="Share" Style="{StaticResource A.Page.ShareBar}" Margin="0,6,0,0" Value="{Binding Share}"
                                                          AutomationProperties.Name="{Binding Name, StringFormat={}{0} share}" />
                                        </StackPanel>
                                        <Grid Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <ContentControl x:Name="Measured" Style="{StaticResource A.Chip.Measured}" Visibility="Collapsed" />
                                            <ContentControl x:Name="Calibrated" Style="{StaticResource A.Chip.Calibrated}" Visibility="Collapsed" />
                                            <ContentControl x:Name="Estimated" Style="{StaticResource A.Chip.Estimated}" Visibility="Collapsed" />
                                            <TextBlock x:Name="NoReading" Style="{StaticResource A.Text.Small}" Foreground="{DynamicResource A.B.Text2}" Text="No reading" Visibility="Collapsed" />
                                        </Grid>
                                        <aero:PartTrend x:Name="Line" Grid.Column="6" Style="{StaticResource A.Page.PartTrend}" Margin="4,0,0,0" HorizontalAlignment="Left"
                                                        Values="{Binding Last7DaysWh}" StrokeBrush="{DynamicResource M.PartRest}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='{}{0}, last 7 days'}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Part}" Value="Cpu">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartCpu}" />
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartCpu}" />
                                        <Setter TargetName="Line" Property="StrokeBrush" Value="{DynamicResource M.PartCpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Part}" Value="Gpu">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartGpu}" />
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartGpu}" />
                                        <Setter TargetName="Line" Property="StrokeBrush" Value="{DynamicResource M.PartGpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Part}" Value="Display">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartDisplay}" />
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartDisplay}" />
                                        <Setter TargetName="Line" Property="StrokeBrush" Value="{DynamicResource M.PartDisplay}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Quality}" Value="Measured">
                                        <Setter TargetName="Measured" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Quality}" Value="Calibrated">
                                        <Setter TargetName="Calibrated" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Quality}" Value="Estimated">
                                        <Setter TargetName="Estimated" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Quality}" Value="{x:Null}">
                                        <Setter TargetName="NoReading" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- The trend's direction in words, as the Dashboard's arrows mean it: more or less than before. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Up">
                                        <Setter TargetName="Trend" Property="Text" Value="{Binding Trend, StringFormat={}{0} more}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Down">
                                        <Setter TargetName="Trend" Property="Text" Value="{Binding Trend, StringFormat={}{0} less}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Flat">
                                        <Setter TargetName="Trend" Property="Text" Value="About the same" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Before the first read, or with the service away since the start: say so, not an empty table. -->
                    <TextBlock Style="{StaticResource A.Page.Cell.Muted}" Margin="14,9" Text="No readings yet. The parts appear once the service has measured this PC.">
                        <TextBlock.Visibility>
                            <Binding Path="Parts.Count" FallbackValue="{x:Static Visibility.Visible}">
                                <Binding.Converter>
                                    <app:VisibleWhenStep />
                                </Binding.Converter>
                                <Binding.ConverterParameter>
                                    <sys:Int32 xmlns:sys="clr-namespace:System;assembly=System.Runtime">0</sys:Int32>
                                </Binding.ConverterParameter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Style="{StaticResource A.Page.Note}" Margin="14,12,0,0"
                               Text="Now is each part's watts at this moment; energy, share and the change against the same length of time before are over the range chosen above." />
                </StackPanel>
            </aero:GlassPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

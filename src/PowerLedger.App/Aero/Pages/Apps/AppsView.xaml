<UserControl x:Class="PowerLedger.App.Aero.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PowerLedger.App"
             xmlns:aero="clr-namespace:PowerLedger.App.Aero">
    <!-- Aero's Apps page (Plan AE): energy and cost by app, a ledger, as the Parts page lays its table. One pane: the title
         with the period's total and cost under it, Today, Week and Month on the sliding pills; then the apps most first,
         each with its icon, share bar, kWh and cost; the lines beside them, as the bands' table words its lines beside the
         bands; a rule; the screen, Windows and idle, and the rest of the PC; the total. A line opens in place to its
         processor against its graphics, how long it ran and whether it ran mostly in the background. Glass is the pane and
         the pills only: the lines are its content, lit as a well under the pointer and while open. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Aero's styles and the page styles, the one instance the window merges (SharedDictionary). -->
                <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The ledger's columns, one set for the heads and every line: the name takes what is left. -->
            <GridLength x:Key="Picture">40</GridLength>
            <GridLength x:Key="Energy">76</GridLength>
            <GridLength x:Key="Chevron">30</GridLength>
            <sys:Double x:Key="Percent" xmlns:sys="clr-namespace:System;assembly=System.Runtime">44</sys:Double>
            <sys:Double x:Key="Cost" xmlns:sys="clr-namespace:System;assembly=System.Runtime">88</sys:Double>

            <!-- The cost column shows while a tariff prices the lines. -->
            <Style x:Key="CostCell" TargetType="TextBlock" BasedOn="{StaticResource A.Page.Cell.Number}">
                <Setter Property="Width" Value="{StaticResource Cost}" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Visibility" Value="{Binding DataContext.HasCost, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}" />
            </Style>

            <!-- A line: a bare row of the pane's content that lights as a well under the pointer, the soft focus ring round
                 it; no press squeeze for a row as wide as the pane. -->
            <Style x:Key="Line" TargetType="app:Disclosure" BasedOn="{StaticResource A.Hoverable}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
                <Setter Property="aero:Press.Enabled" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="app:Disclosure">
                            <Grid Background="Transparent">
                                <Border x:Name="Hover" CornerRadius="{DynamicResource A.R.MenuItem}" Background="{DynamicResource A.B.Well}" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                                    <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A quiet tag on an opened app: a dot and the words on a soft capsule, as the quality chips are worded. -->
            <Style x:Key="Tag" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource A.B.Well2}" />
                <Setter Property="Padding" Value="9,3,10,3" />
                <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource A.Page.Margin}">
            <aero:GlassPanel x:Name="Pane" Style="{StaticResource A.Page.Glass}" Padding="20,18,20,12" AutomationProperties.Name="Apps">
                <StackPanel>
                    <DockPanel Style="{StaticResource A.Page.Head}">
                        <aero:SegTrack x:Name="Periods" DockPanel.Dock="Right" Style="{StaticResource A.Page.SegTrack}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" AutomationProperties.Name="Period">
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="AppsPeriod" Content="Today"
                                             IsChecked="{Binding Period, Converter={StaticResource Is}, ConverterParameter={x:Static app:AppsPeriod.Today}}" />
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="AppsPeriod" Content="Week" AutomationProperties.Name="This week"
                                             IsChecked="{Binding Period, Converter={StaticResource Is}, ConverterParameter={x:Static app:AppsPeriod.Week}}" />
                                <RadioButton Style="{StaticResource A.SegItem}" GroupName="AppsPeriod" Content="Month" AutomationProperties.Name="This month"
                                             IsChecked="{Binding Period, Converter={StaticResource Is}, ConverterParameter={x:Static app:AppsPeriod.Month}}" />
                            </StackPanel>
                        </aero:SegTrack>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource A.PanelTitle}" Text="Apps" />
                            <TextBlock x:Name="Summary" Style="{StaticResource A.Label}" Margin="0,4,0,0" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Summary, Converter={StaticResource VisibleWhenText}}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource A.Page.Note}" Margin="0,-4,0,10" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource VisibleWhenText}}" />

                    <Border Style="{StaticResource A.Table.Header}" Visibility="{Binding HasRows, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Picture}" />
                                <ColumnDefinition Width="3*" MinWidth="140" />
                                <ColumnDefinition Width="{StaticResource Energy}" />
                                <ColumnDefinition Width="2*" MinWidth="120" MaxWidth="300" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{StaticResource Chevron}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource A.Page.Head.Cell}" Text="App" />
                            <TextBlock Grid.Column="2" Style="{StaticResource A.Page.Head.Cell}" HorizontalAlignment="Right" Text="kWh" />
                            <TextBlock Grid.Column="3" Style="{StaticResource A.Page.Head.Cell}" Margin="16,0,0,0" Text="Share" />
                            <TextBlock Grid.Column="4" Style="{StaticResource A.Page.Head.Cell}" TextAlignment="Right" Width="{StaticResource Cost}" Text="Cost"
                                       Visibility="{Binding HasCost, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                    </Border>

                    <!-- The lines come new with every read: they change in place (perf review P14). One stop for Tab, the
                         arrows between the lines, Enter or Space to open one. -->
                    <ItemsControl x:Name="Lines" app:RowsInPlace.Items="{Binding Rows}" Focusable="False" AutomationProperties.Name="Apps by energy"
                                  KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                        <app:RowsInPlace.Template>
                            <DataTemplate DataType="{x:Type app:AppRow}">
                                <StackPanel>
                                    <!-- The fixed lines, set apart from the apps above them by a rule, the mockup's hairline (.sep). -->
                                    <Border x:Name="Rule" Height="1" Margin="14,8,14,8" Background="{DynamicResource A.B.GroupSep}" Visibility="Collapsed" />
                                    <Border x:Name="Card" CornerRadius="{DynamicResource A.R.MenuItem}" Background="Transparent">
                                        <StackPanel>
                                            <app:Disclosure x:Name="Head" Style="{StaticResource Line}" IsExpanded="{Binding IsOpen, Mode=OneWay}"
                                                            Command="{Binding DataContext.Toggle, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"
                                                            AutomationProperties.Name="{Binding Spoken}" AutomationProperties.HelpText="{Binding Detail}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource Picture}" />
                                                        <ColumnDefinition Width="3*" MinWidth="140" />
                                                        <ColumnDefinition Width="{StaticResource Energy}" />
                                                        <ColumnDefinition Width="2*" MinWidth="120" MaxWidth="300" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="{StaticResource Chevron}" />
                                                    </Grid.ColumnDefinitions>
                                                    <app:AppIcon x:Name="Picture" Width="28" Height="28" HorizontalAlignment="Left" Path="{Binding Path}" Glyph="{Binding Glyph}"
                                                                 Tile="{DynamicResource A.B.Well2}" Foreground="{DynamicResource A.B.Text2}" />
                                                    <TextBlock x:Name="Label" Grid.Column="1" Style="{StaticResource A.Page.Cell}" Margin="0,0,14,0" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock x:Name="Energy" Grid.Column="2" Style="{StaticResource A.Page.Cell.Number}" Text="{Binding Energy}" />
                                                    <DockPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource A.Page.Cell.Number}" Foreground="{DynamicResource A.B.Text2}"
                                                                   Width="{StaticResource Percent}" TextAlignment="Right" Text="{Binding Share}" />
                                                        <app:ShareBar x:Name="Bar" Style="{StaticResource A.Page.ShareBar}" VerticalAlignment="Center" Value="{Binding Fraction}"
                                                                      FillBrush="{DynamicResource A.B.AccentLine}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} share}" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Column="4" Style="{StaticResource CostCell}" Text="{Binding Cost}" />
                                                    <aero:Icon x:Name="Chevron" Grid.Column="5" Data="{StaticResource A.I.Chevron}" Size="14" StrokeWidth="2" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource A.B.Text3}" RenderTransformOrigin=".5,.5">
                                                        <aero:Icon.RenderTransform>
                                                            <RotateTransform x:Name="Turn" />
                                                        </aero:Icon.RenderTransform>
                                                    </aero:Icon>
                                                </Grid>
                                            </app:Disclosure>

                                            <!-- Opened: what the line holds, under its name. -->
                                            <StackPanel x:Name="Details" Margin="54,0,44,14" Visibility="Collapsed" Opacity="0">
                                                <StackPanel.RenderTransform>
                                                    <TranslateTransform x:Name="Drop" />
                                                </StackPanel.RenderTransform>
                                                <StackPanel x:Name="Split" Margin="0,0,0,10">
                                                    <!-- The bar as long as the room allows, up to 320, from the left. -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MaxWidth="320" />
                                                        </Grid.ColumnDefinitions>
                                                        <app:ShareBar Style="{StaticResource A.Page.ShareBar}" Value="{Binding ProcessorShare}"
                                                                      FillBrush="{DynamicResource M.PartCpu}" TrackBrush="{DynamicResource M.PartGpu}"
                                                                      AutomationProperties.Name="Processor against graphics" />
                                                    </Grid>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Ellipse Style="{StaticResource A.Page.Dot}" Fill="{DynamicResource M.PartCpu}" />
                                                        <TextBlock Style="{StaticResource A.Text.Small}" Margin="7,0,18,0" VerticalAlignment="Center">
                                                            <Run Text="Processor" Foreground="{DynamicResource A.B.Text2}" /> <Run Text="{Binding Processor, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Ellipse Style="{StaticResource A.Page.Dot}" Fill="{DynamicResource M.PartGpu}" />
                                                        <TextBlock Style="{StaticResource A.Text.Small}" Margin="7,0,0,0" VerticalAlignment="Center">
                                                            <Run Text="Graphics" Foreground="{DynamicResource A.B.Text2}" /> <Run Text="{Binding Graphics, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <WrapPanel x:Name="Times" Visibility="{Binding Ran, Converter={StaticResource VisibleWhenText}}">
                                                    <TextBlock Style="{StaticResource A.Text.Small}" Foreground="{DynamicResource A.B.Text2}" Margin="0,0,18,0" VerticalAlignment="Center"
                                                               Text="{Binding Ran}" />
                                                    <TextBlock Style="{StaticResource A.Text.Small}" Foreground="{DynamicResource A.B.Text2}" Margin="0,0,18,0" VerticalAlignment="Center"
                                                               Text="{Binding InFront}" Visibility="{Binding InFront, Converter={StaticResource VisibleWhenText}}" />
                                                    <Border Style="{StaticResource Tag}" Visibility="{Binding Background, Converter={StaticResource VisibleWhen}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource A.B.Muted}" VerticalAlignment="Center" />
                                                            <TextBlock Style="{StaticResource A.Text.Small}" Margin="6,0,0,0" Text="Mostly in background" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource A.Page.Note}" Margin="0" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource VisibleWhenText}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Apart}" Value="True">
                                        <Setter TargetName="Rule" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSplit}" Value="False">
                                        <Setter TargetName="Split" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <!-- The lines beside the apps, as the bands' lines beside the bands: quieter words, no bar. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Beside">
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource A.B.Text2}" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <!-- The fixed lines in their parts' colours, as Parts and History draw them. -->
                                    <DataTrigger Binding="{Binding Glyph}" Value="Screen">
                                        <Setter TargetName="Bar" Property="FillBrush" Value="{DynamicResource M.PartDisplay}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Glyph}" Value="System">
                                        <Setter TargetName="Bar" Property="FillBrush" Value="{DynamicResource M.PartCpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Glyph}" Value="Rest">
                                        <Setter TargetName="Bar" Property="FillBrush" Value="{DynamicResource M.PartRest}" />
                                    </DataTrigger>
                                    <!-- The total: the medium weight, no bar, nothing to open. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Total">
                                        <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
                                        <Setter TargetName="Energy" Property="FontWeight" Value="Medium" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Head" Property="IsHitTestVisible" Value="False" />
                                        <Setter TargetName="Head" Property="Focusable" Value="False" />
                                        <Setter TargetName="Head" Property="CanExpand" Value="False" />
                                    </DataTrigger>
                                    <!-- Opened: the line lit as a well, its details gliding down into place and the chevron
                                         turning; under reduced motion only the fade is left. -->
                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                        <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource A.B.Well}" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <aero:AeroAnimation Storyboard.TargetName="Details" Storyboard.TargetProperty="Opacity" From="0" To="1" Ms="280" Fade="True"
                                                                        EasingFunction="{x:Static aero:AeroMotion.Glide}" />
                                                    <aero:AeroAnimation Storyboard.TargetName="Drop" Storyboard.TargetProperty="Y" From="-6" To="0" Ms="420" Fade="False"
                                                                        EasingFunction="{x:Static aero:AeroMotion.Glide}" />
                                                    <aero:AeroAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="180" Ms="450" Fade="False"
                                                                        EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <aero:AeroAnimation Storyboard.TargetName="Details" Storyboard.TargetProperty="Opacity" To="0" Ms="1" Fade="True" />
                                                    <aero:AeroAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="0" Ms="450" Fade="False"
                                                                        EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </app:RowsInPlace.Template>
                    </ItemsControl>

                    <!-- Nothing to list yet, or nothing read: say so plainly. -->
                    <DockPanel Margin="14,10,14,6" Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}">
                        <app:AppIcon DockPanel.Dock="Left" Width="28" Height="28" Glyph="Program" Margin="0,0,12,0" VerticalAlignment="Top"
                                     Tile="{DynamicResource A.B.Well2}" Foreground="{DynamicResource A.B.Text2}" />
                        <TextBlock x:Name="Message" Style="{StaticResource A.Page.Cell.Muted}" TextWrapping="Wrap" Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource A.Page.Note}" Margin="14,14,14,0" MaxWidth="720" HorizontalAlignment="Left"
                               Text="Each share is of everything this PC used: every app's processor and graphics energy, the screen and the rest of the PC. Apps are grouped by program, not by process. This list stays on this PC: it is never shared or synced." />
                </StackPanel>
            </aero:GlassPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="PowerLedger.App.Aero.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PowerLedger.App"
             xmlns:aero="clr-namespace:PowerLedger.App.Aero"
             Focusable="False">
    <!-- Aero's Dashboard (0.10.9: the liquid glass mockup's Main board, piece by piece, on real data): Power now (the watts
         in their well, what measures them, today's kWh and the change against yesterday on a glass bubble, and the last
         minute's glowing line), This month (Open report, the cost so far and where it is heading, the month's bar, each
         PC's share), Energy each day (Day, Week or Month on a segmented glass, fourteen glass bars, the latest in the
         accent) and Where the power goes (the ring with a glass hole, each part with its model). Laid out as the mockup at
         1440 by 900: the left column the rest of the page, the right 384, the top row 280 high and the bottom the rest;
         under 860 px of page, one column. The panes are the recipe's glass; their insides are its .inset wells, and only
         the change against yesterday, the segmented control's choice, the bars and the ring's hole float on them as glass. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The window's styles, shared with it: a view built by the page host resolves its StaticResources before it joins the window. -->
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The mockup's .sub: 12.5, medium, white at 80 %. -->
            <Style x:Key="Sub" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Secondary}">
                <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
            <!-- A pane's heading (the mockup's 16 semibold). -->
            <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource A.PanelTitle}">
                <Setter Property="FontSize" Value="16" />
            </Style>
            <!-- A figure in the mono face (the mockup's Geist Mono 500). -->
            <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
                <Setter Property="FontFamily" Value="{DynamicResource A.F.Mono}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>

            <!-- A part's dot in its palette colour (M.Part*), as the ring, the Parts page and History colour it, with the
                 mockup's glow round it (0 0 8px in its own colour). -->
            <Style x:Key="PartDot" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{DynamicResource M.PartRest}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Part}" Value="Cpu"><Setter Property="Fill" Value="{DynamicResource M.PartCpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Gpu"><Setter Property="Fill" Value="{DynamicResource M.PartGpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Display"><Setter Property="Fill" Value="{DynamicResource M.PartDisplay}" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The page scrolls under the wheel and the keyboard; its side bar (0.10.8, Aero's ScrollViewer style) overlays the
         panes' edge, hidden until the pointer comes near or the page scrolls, so it takes none of their width. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="Camera" RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CamScale" />
                    <TranslateTransform x:Name="CamShift" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid x:Name="Layout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="384" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="280" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="494" />
                </Grid.RowDefinitions>

                <!-- ============ Power now ============ -->
                <!-- The mockup's: 18 in, a column 272 wide beside Last minute, 16 apart. In the column the Power now well (its
                     .inset, 20 in), and under it, 14 apart and 60 high, today's kWh in a well and the change against yesterday
                     on a glass bubble, 10 apart. -->
                <!-- The mockup's grid row is 252 high: its column's wells (171, 14 and 67) run 8 past the pane's padding. -->
                <aero:GlassPanel x:Name="PNow" Padding="18" AutomationProperties.Name="Power now">
                    <Grid x:Name="NowContent" Margin="0,0,0,-8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="272" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="67" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource A.Well}" Padding="19">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="28" Height="28">
                                            <Ellipse Fill="{DynamicResource A.B.Accent}" />
                                            <aero:Icon Data="{StaticResource A.I.Bolt}" Size="13" StrokeWidth="2.6" Foreground="{DynamicResource A.B.AccentInk}" />
                                        </Grid>
                                        <TextBlock Text="Power now" Style="{StaticResource A.Text.Body}" FontSize="15" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- The watts roll digit by digit (G6's RollingNumber); no reading is plain text. The mockup's
                                         figure: 48 semibold, the unit 22 at 80 %, 6 after it, 14 under the head. -->
                                    <StackPanel x:Name="NowFigure" Orientation="Horizontal" Margin="0,17,0,0" Focusable="False">
                                        <aero:RollingNumber x:Name="NowRoll" DigitSize="48" DigitWeight="SemiBold" Tracking="-0.035" VerticalAlignment="Bottom" />
                                        <TextBlock x:Name="NowValue" Style="{StaticResource A.Text.Big}" FontSize="48" FontWeight="SemiBold" LineHeight="56" TextTrimming="None" VerticalAlignment="Bottom" Visibility="Collapsed" />
                                        <TextBlock x:Name="NowUnit" Style="{StaticResource A.Text.Secondary}" FontSize="22" FontWeight="Medium" Margin="6,0,0,7" VerticalAlignment="Bottom" Text="W" />
                                    </StackPanel>
                                    <TextBlock x:Name="NowSource" Style="{StaticResource Sub}" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Today's kWh: 20 semibold, its label under it, 12 by 14 in. -->
                                <Border Style="{StaticResource A.Well}" Padding="13,11">
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock x:Name="TodayKwh" Style="{StaticResource A.Text.Number}" FontSize="20" FontWeight="SemiBold" Text="0" />
                                        <TextBlock Text="kWh today" Style="{StaticResource Sub}" />
                                    </StackPanel>
                                </Border>
                                <!-- The change against yesterday: the mockup's glass bubble, 20 corner, its figure 18 semibold. -->
                                <aero:GlassPanel Grid.Column="2" CornerRadius="20" Bubble="True" Padding="10" Height="60" VerticalAlignment="Top">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="ChangeText" Style="{StaticResource A.Text.Number}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Text="N/A" />
                                        <TextBlock Text="vs yesterday" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </aero:GlassPanel>
                            </Grid>
                        </Grid>
                        <!-- Last minute: the mockup's .inset, 16 by 18 in, its title and "Live" over the chart, 10 above it. -->
                        <Border Grid.Column="2" Style="{StaticResource A.Well}" Padding="17,15,17,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="Live" Style="{StaticResource Sub}" VerticalAlignment="Center" />
                                    <TextBlock Text="Last minute" Style="{StaticResource A.PanelTitle}" FontSize="15" />
                                </DockPanel>
                                <aero:LiveChart x:Name="Live" Grid.Row="1" Margin="0,10,0,0" Height="186" VerticalAlignment="Top" Samples="{Binding Live.Spark}" Average="{Binding Live.AverageW}" />
                            </Grid>
                        </Border>
                    </Grid>
                </aero:GlassPanel>

                <!-- ============ This month ============ -->
                <!-- The mockup's: 24 in; the head and Open report (the lime glass, 124 by 36); the cost 42 semibold, 18 under it;
                     the line under that; the month's bar, an inset 12 high, 18 under; each PC's row, 22 under and 8 apart. -->
                <aero:GlassPanel x:Name="PMonth" Grid.Column="2" Padding="24" AutomationProperties.Name="This month">
                    <StackPanel x:Name="MonthContent">
                        <DockPanel>
                            <Button x:Name="OpenReport" DockPanel.Dock="Right" Style="{StaticResource A.AccentBtn}" Width="124" Padding="0" HorizontalContentAlignment="Center" Content="Open report" Click="OpenReportClick" AutomationProperties.Name="Open report" />
                            <TextBlock Text="This month" Style="{StaticResource Head}" />
                        </DockPanel>
                        <!-- The mockup's .num at 42, tracked in by .035 em as the browser draws it. -->
                        <aero:TrackedText x:Name="MonthBig" FontFamily="{DynamicResource A.F.Ui}" Foreground="{DynamicResource A.B.Text}" Effect="{DynamicResource A.Glass.TextShadow}"
                                          FontSize="42" FontWeight="SemiBold" Tracking="-0.035" HorizontalAlignment="Left" Margin="0,19,0,0" Text="N/A" />
                        <TextBlock x:Name="MonthSub" Style="{StaticResource Sub}" Margin="0,-2,0,0" />
                        <!-- The bar: an inset 12 high, the accent filling it to where the month is, the mockup's gradient from its
                             foot to its head (#C9E63E to #EAFF7A for the lime), with its soft glow (0 0 12px at 55 %). -->
                        <Grid x:Name="MonthBar" Height="12" Margin="0,18,0,0">
                            <Border CornerRadius="6" Background="{DynamicResource A.B.InsetFill}" BorderBrush="{DynamicResource A.B.InsetEdge}" BorderThickness="1" />
                            <Grid x:Name="MonthFill" HorizontalAlignment="Left" Width="0">
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="{DynamicResource A.C.AccentLow}" />
                                            <GradientStop Offset="1" Color="{DynamicResource A.C.AccentHigh}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.55" Color="{DynamicResource A.C.Accent}" RenderingBias="Performance" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>
                        <ItemsControl x:Name="MonthSplit" Margin="0,24,0,0" Focusable="False" AutomationProperties.Name="This month by PC">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PcRow}">
                                    <DockPanel Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Energy}" Style="{StaticResource Mono}" FontSize="14" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource A.Text.Body}" FontSize="14" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </aero:GlassPanel>

                <!-- ============ Energy each day ============ -->
                <!-- The mockup's: 22 by 24 in; the head and Day, Week and Month on a segmented glass (a capsule 42 high, 4 in, the
                     chosen word on a glass bubble that slides); the bars' well 18 under, 20 by 18 in (14 at its foot), the
                     fourteen bars 10 apart, each a glass capsule of 14 corners, its label 8 under it; the latest in the
                     accent's glass (lime at 78 %). -->
                <aero:GlassPanel x:Name="PDaily" Grid.Row="2" Padding="24,22" AutomationProperties.Name="Energy each day">
                    <Grid x:Name="DailyContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <!-- The mockup's track: 232 by 42, its buttons centred in it 2 apart, Day 72 wide. -->
                            <aero:GlassPanel DockPanel.Dock="Right" Style="{StaticResource A.SegTrack}" Width="232" Height="42">
                                <Grid x:Name="Seg" HorizontalAlignment="Center">
                                    <aero:GlassPanel x:Name="SegIndicator" Style="{StaticResource A.Glass.Bubble}" Height="34" Width="40" HorizontalAlignment="Left" Opacity="0">
                                        <aero:GlassPanel.RenderTransform>
                                            <TranslateTransform x:Name="SegX" />
                                        </aero:GlassPanel.RenderTransform>
                                    </aero:GlassPanel>
                                    <StackPanel x:Name="SegItems" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once"
                                                AutomationProperties.Name="Energy each day by">
                                        <RadioButton Style="{StaticResource A.SegItem}" Content="Day" Width="72" Padding="0" Checked="SpanChecked"
                                                     IsChecked="{Binding HistorySpan, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static local:HistorySpan.Day}}" />
                                        <RadioButton Style="{StaticResource A.SegItem}" Content="Week" Margin="2,0,0,0" Checked="SpanChecked"
                                                     IsChecked="{Binding HistorySpan, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static local:HistorySpan.Week}}" />
                                        <RadioButton Style="{StaticResource A.SegItem}" Content="Month" Margin="2,0,0,0" Checked="SpanChecked"
                                                     IsChecked="{Binding HistorySpan, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static local:HistorySpan.Month}}" />
                                    </StackPanel>
                                </Grid>
                            </aero:GlassPanel>
                            <TextBlock Text="Energy each day" Style="{StaticResource Head}" />
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource A.Well}" Margin="0,18,0,8" Padding="17,19,17,13">
                            <aero:EnergyBarChart x:Name="Bars" Bars="{Binding Detail.Bars}" />
                        </Border>
                    </Grid>
                </aero:GlassPanel>

                <!-- ============ Where the power goes ============ -->
                <!-- The mockup's: 24 in; the head; the ring 180 across, 22 under it and 16 over the list, its hole a glass disc
                     100 across; each part a row 8 by 4 in, its glowing dot, its name with its model under it, its share in the
                     mono face. -->
                <aero:GlassPanel x:Name="PParts" Grid.Row="2" Grid.Column="2" Padding="24" AutomationProperties.Name="Where the power goes">
                    <StackPanel x:Name="PartsContent">
                        <TextBlock Text="Where the power goes" Style="{StaticResource Head}" />
                        <Grid Width="180" Height="180" Margin="0,22,0,16" HorizontalAlignment="Center">
                            <aero:DonutChart x:Name="Ring" Parts="{Binding Parts}" />
                            <aero:GlassPanel x:Name="RingHole" Width="100" Height="100" CornerRadius="50" IsHitTestVisible="False" />
                        </Grid>
                        <!-- Filled by the view (ShowParts) only when what it shows changes, not with every reading. -->
                        <ItemsControl x:Name="PartsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type aero:PartRow}">
                                    <Border Padding="4,8" Background="Transparent" CornerRadius="12" MouseEnter="PartEnter" MouseLeave="PartLeave"
                                            AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Model}">
                                        <DockPanel>
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource PartDot}" Effect="{Binding Glow}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Share}" Style="{StaticResource Mono}" FontSize="14" VerticalAlignment="Center" />
                                            <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource A.Text.Body}" FontSize="14" />
                                                <TextBlock Text="{Binding Model}" Style="{StaticResource Sub}" FontSize="11.5"
                                                           Visibility="{Binding Model, Converter={StaticResource VisibleWhenText}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </aero:GlassPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

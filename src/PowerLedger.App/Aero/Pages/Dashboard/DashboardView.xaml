<UserControl x:Class="PowerLedger.App.Aero.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PowerLedger.App"
             xmlns:aero="clr-namespace:PowerLedger.App.Aero"
             Focusable="False">
    <!-- Aero's Dashboard (Aero look design §1, Plan S D3): the approved demo's panes on real data. Power now (the watts, or
         the cost of an hour, today's kWh and the change against yesterday) beside Last minute; This month (cost or energy,
         Open report, the day of the month, the forecast from Insights, the split by PC); Energy each day (a month against
         the one before, with its picker); Where the power goes (the 3D pie with each part's model under its name); and the
         history table (Day, Week, Month, Year; the top bar's search; Save CSV). Two columns from 860 px of page, one under
         860. The panes are glass; their insides are wells, never glass on glass. A pane's padding is the demo's 20 px and
         18 px plus the 1 px border its .glass has inside its box. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The window's styles, shared with it: a view built by the page host resolves its StaticResources before it joins the window. -->
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Styles.Aero.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <aero:ShareColumn x:Key="ShareColumn" />

            <!-- A part's dot in its palette colour (M.Part*), as the pie, the Parts page and History colour it. -->
            <Style x:Key="PartDot" TargetType="Ellipse">
                <Setter Property="Width" Value="9" />
                <Setter Property="Height" Value="9" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{DynamicResource M.PartRest}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Part}" Value="Cpu"><Setter Property="Fill" Value="{DynamicResource M.PartCpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Gpu"><Setter Property="Fill" Value="{DynamicResource M.PartGpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Display"><Setter Property="Fill" Value="{DynamicResource M.PartDisplay}" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Where a row's figures came from: the quality's chip. -->
            <Style x:Key="SourceChip" TargetType="ContentControl" BasedOn="{StaticResource A.Chip.Estimated}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Source}" Value="Measured">
                        <Setter Property="Content" Value="Measured" />
                        <Setter Property="Background" Value="{DynamicResource A.B.Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Source}" Value="Calibrated">
                        <Setter Property="Content" Value="Calibrated" />
                        <Setter Property="Background" Value="{DynamicResource A.B.Violet}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <!-- The small square that holds a pane's icon. -->
            <Style x:Key="IconSquare" TargetType="Border">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="CornerRadius" Value="{DynamicResource A.R.Icon}" />
                <Setter Property="Background" Value="{DynamicResource A.B.Well2}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The page scrolls under the wheel and the keyboard; its side bar (0.10.8, Aero's ScrollViewer style) overlays the
         panes' edge, hidden until the pointer comes near or the page scrolls, so it takes none of their width. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="Camera" RenderTransformOrigin="0,0" Margin="0,0,0,4">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CamScale" />
                    <TranslateTransform x:Name="CamShift" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid x:Name="Layout">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="262" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="238" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ============ Power now and Last minute ============ -->
                <aero:GlassPanel x:Name="PNow" Padding="21,19" AutomationProperties.Name="Power now">
                    <Grid x:Name="NowContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="256" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource A.Well}" Padding="16,13,12,14">
                                <Grid>
                                    <DockPanel VerticalAlignment="Top">
                                        <Grid Width="34" Height="34">
                                            <Ellipse Fill="{DynamicResource A.B.Accent}" />
                                            <aero:Icon Data="{StaticResource A.I.Bolt}" Size="15" Filled="True" Foreground="{DynamicResource A.B.AccentInk}" />
                                        </Grid>
                                        <Button x:Name="UnitButton" DockPanel.Dock="Right" Style="{StaticResource A.WhiteRoundBtn}" Click="UnitClick"
                                                AutomationProperties.Name="Show cost per hour" ToolTip="Show cost per hour">
                                            <aero:Icon Data="{StaticResource A.I.Unit}" Filled="True" />
                                        </Button>
                                        <TextBlock Text="Power now" Style="{StaticResource A.Text.Body}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <!-- The watts roll digit by digit (G6's RollingNumber); the cost of an hour, or no reading, is plain text. -->
                                    <StackPanel x:Name="NowFigure" Orientation="Horizontal" VerticalAlignment="Bottom" Focusable="False">
                                        <aero:RollingNumber x:Name="NowRoll" DigitSize="{DynamicResource A.T.Big}" DigitWeight="Medium" VerticalAlignment="Bottom" />
                                        <TextBlock x:Name="NowValue" Style="{StaticResource A.Text.Big}" TextTrimming="None" VerticalAlignment="Bottom" Visibility="Collapsed" />
                                        <TextBlock x:Name="NowUnit" Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Mid}" Margin="9,0,0,2" VerticalAlignment="Bottom" Text="W" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" CornerRadius="{DynamicResource A.R.Well}" Background="{DynamicResource A.B.Well}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="108" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The demo's .pair: a light top line (12 %) over the fill, under the delta. -->
                                    <Border Grid.ColumnSpan="2" CornerRadius="{DynamicResource A.R.Well}" BorderBrush="{DynamicResource A.B.SoftTop}" BorderThickness="0,1,0,0"
                                            IsHitTestVisible="False" />
                                    <!-- The demo's .pair .a: the figure at the top, its label at the foot. -->
                                    <DockPanel Margin="14,12">
                                        <TextBlock DockPanel.Dock="Bottom" Text="kWh used today" Style="{StaticResource A.Label}" />
                                        <TextBlock x:Name="TodayKwh" Style="{StaticResource A.Text.Mid}" Text="0" VerticalAlignment="Top" />
                                    </DockPanel>
                                    <Border Grid.Column="1" CornerRadius="{DynamicResource A.R.Well}" Background="{DynamicResource A.B.Well2}">
                                        <StackPanel>
                                            <TextBlock x:Name="ChangeText" Style="{StaticResource A.Text.Number}" FontSize="18" HorizontalAlignment="Center" Margin="8,11,8,7" Text="N/A"
                                                       LineHeight="24" LineStackingStrategy="BlockLineHeight" />
                                            <Border CornerRadius="16" Background="{DynamicResource A.B.Well3}" Margin="4,0,4,4" Padding="4,9">
                                                <TextBlock Text="vs yesterday" Style="{StaticResource A.Text.Body}" FontSize="{DynamicResource A.T.Small}" HorizontalAlignment="Center"
                                                           LineHeight="16.8" LineStackingStrategy="BlockLineHeight" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Column="2" CornerRadius="{DynamicResource A.R.Well}" Background="{DynamicResource A.B.ChartWell}"
                                BorderBrush="{DynamicResource A.B.ChartWellLit}" BorderThickness="0,1,0,0" Padding="12,11,12,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Button x:Name="FocusNow" DockPanel.Dock="Right" Style="{StaticResource A.ExpandBtn}" Click="FocusClick" Tag="PNow"
                                            AutomationProperties.Name="Focus on Last minute" ToolTip="Focus on Last minute">
                                        <aero:Icon Data="{StaticResource A.I.Expand}" Size="14" />
                                    </Button>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Last minute" Style="{StaticResource A.PanelTitle}" />
                                        <aero:Icon Data="{StaticResource A.I.Info}" Size="14" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="True"
                                                   ToolTip="The last 60 seconds of readings; the dashed line is today's average" />
                                    </StackPanel>
                                </DockPanel>
                                <aero:LiveChart x:Name="Live" Grid.Row="1" Samples="{Binding Live.Spark}" Average="{Binding Live.AverageW}" />
                            </Grid>
                        </Border>
                    </Grid>
                </aero:GlassPanel>

                <!-- ============ This month ============ -->
                <aero:GlassPanel x:Name="PMonth" Grid.Column="2" Padding="21,19" AutomationProperties.Name="This month">
                    <Grid x:Name="MonthContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="OpenReport" DockPanel.Dock="Right" Style="{StaticResource A.AccentBtn}" Content="Open report" Margin="10,0,0,0" Click="OpenReportClick" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                                <RadioButton x:Name="MonthCost" Style="{StaticResource A.TextToggle}" Content="Cost" IsChecked="True" Margin="0,0,12,0" Checked="MonthUnitChecked" />
                                <RadioButton x:Name="MonthEnergy" Style="{StaticResource A.TextToggle}" Content="Energy" Checked="MonthUnitChecked" />
                            </StackPanel>
                            <TextBlock Text="This month" Style="{StaticResource A.PanelTitle}" />
                        </DockPanel>
                        <TextBlock x:Name="MonthBig" Grid.Row="1" Style="{StaticResource A.Text.BigMonth}" Text="N/A" />
                        <TextBlock x:Name="MonthSub" Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource A.Label}" />
                        <Grid x:Name="MonthBar" Grid.Row="3" Height="6" Margin="0,12,0,6">
                            <Border CornerRadius="3" Background="{DynamicResource A.B.Track}" />
                            <Border x:Name="MonthFill" CornerRadius="3" Background="{DynamicResource A.B.Accent}" HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <DockPanel Grid.Row="4">
                            <TextBlock x:Name="DayOfText" DockPanel.Dock="Left" Style="{StaticResource A.Text.Muted}" FontSize="{DynamicResource A.T.Tiny}" />
                            <TextBlock x:Name="ForecastText" Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Tiny}" HorizontalAlignment="Right" Margin="12,0,0,0" />
                        </DockPanel>
                        <!-- Each row with the demo's 8 px under it, the last's taken back, so the split sits on the pane's foot. -->
                        <ItemsControl x:Name="MonthSplit" Grid.Row="6" Margin="0,0,0,-8" Focusable="False" AutomationProperties.Name="This month by PC">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:PcRow}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource A.Text.Body}" FontSize="{DynamicResource A.T.Label}" />
                                        <Grid Grid.Column="1" Height="6" Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Share, Converter={StaticResource ShareColumn}}" />
                                                <ColumnDefinition Width="{Binding Share, Converter={StaticResource ShareColumn}, ConverterParameter=Rest}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource A.B.TrackSoft}" />
                                            <Border x:Name="SplitFill" CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource A.B.Violet}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThisPc}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource A.B.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Energy}" Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Label}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </aero:GlassPanel>

                <!-- ============ Energy each day ============ -->
                <aero:GlassPanel x:Name="PDaily" Grid.Row="2" Padding="21,19" AutomationProperties.Name="Energy each day">
                    <Grid x:Name="DailyContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="FocusDaily" DockPanel.Dock="Right" Style="{StaticResource A.ExpandBtn}" Margin="10,0,0,0" Click="FocusClick" Tag="PDaily"
                                    AutomationProperties.Name="Focus on Energy each day" ToolTip="Focus on Energy each day">
                                <aero:Icon Data="{StaticResource A.I.Expand}" Size="14" />
                            </Button>
                            <Button x:Name="MonthButton" DockPanel.Dock="Right" Style="{StaticResource A.OutlineBtn}" Click="MonthPickerClick" AutomationProperties.Name="Month">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MonthLabel" VerticalAlignment="Center" />
                                    <aero:Icon Data="{StaticResource A.I.Chevron}" Size="13" StrokeWidth="2.4" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconSquare}">
                                    <aero:Icon Data="{StaticResource A.I.Bars}" Size="15" />
                                </Border>
                                <TextBlock Text="Energy each day" Style="{StaticResource A.PanelTitle}" Margin="10,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <!-- The demo's legend: each entry a dot, its month and its total, 7 px apart; the entries 18 px apart. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,-2,0,4">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource A.B.Accent}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LegendName" Margin="7,0,0,0" Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Label}" />
                            <TextBlock x:Name="LegendKwh" Margin="7,0,18,0" Style="{StaticResource A.Text.Body}" FontSize="{DynamicResource A.T.Label}" FontWeight="Medium" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource A.B.Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LegendPrevious" Margin="7,0,0,0" Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Label}" />
                            <TextBlock x:Name="LegendPreviousKwh" Margin="7,0,0,0" Style="{StaticResource A.Text.Body}" FontSize="{DynamicResource A.T.Label}" FontWeight="Medium" />
                        </StackPanel>
                        <aero:DailyChart x:Name="Daily" Grid.Row="2" Days="{Binding Detail.Daily}" Previous="{Binding Detail.DailyPrevious}" />
                    </Grid>
                </aero:GlassPanel>

                <!-- ============ Where the power goes ============ -->
                <aero:GlassPanel x:Name="PParts" Grid.Row="2" Grid.Column="2" Padding="21,19" AutomationProperties.Name="Where the power goes">
                    <Grid x:Name="PartsContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="FocusParts" DockPanel.Dock="Right" Style="{StaticResource A.ExpandBtn}" Click="FocusClick" Tag="PParts"
                                    AutomationProperties.Name="Focus on Where the power goes" ToolTip="Focus on Where the power goes">
                                <aero:Icon Data="{StaticResource A.I.Expand}" Size="14" />
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconSquare}">
                                    <aero:Icon Data="{StaticResource A.I.Pie}" Size="15" />
                                </Border>
                                <TextBlock Text="Where the power goes" Style="{StaticResource A.PanelTitle}" Margin="10,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- The demo's pie is 186 wide; 172 leaves the list room for the App's own names ("Rest of system") beside
                                     it, each with its part's model under it (design §1), which the demo's four words didn't need. -->
                                <ColumnDefinition Width="172" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <aero:PieChart3D x:Name="Pie" Parts="{Binding Parts}" />
                            <!-- Filled by the view (ShowParts) only when what it shows changes, not with every reading. -->
                            <ItemsControl x:Name="PartsList" Grid.Column="2" VerticalAlignment="Center" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DashboardPart}">
                                        <!-- The demo's row (7 px above and below, 3 apart); a row with a model under its name keeps to 4 px, so
                                             four of them fit beside the pie. -->
                                        <Border CornerRadius="12" Background="Transparent" MouseEnter="PartEnter" MouseLeave="PartLeave"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Padding" Value="10,4" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Model, Converter={StaticResource VisibleWhenText}}" Value="Collapsed">
                                                            <Setter Property="Padding" Value="10,7" />
                                                            <Setter Property="Margin" Value="0,0,0,3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Style="{StaticResource PartDot}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                                <StackPanel Grid.Column="1" Margin="9,0,9,0">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource A.Text.Body}" FontSize="{DynamicResource A.T.Label}" />
                                                    <TextBlock Text="{Binding Model}" Style="{StaticResource A.Text.Secondary}" FontSize="11"
                                                               Visibility="{Binding Model, Converter={StaticResource VisibleWhenText}}" ToolTip="{Binding Model}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Share, StringFormat={}{0:0%}}" Style="{StaticResource A.Text.Secondary}" FontSize="{DynamicResource A.T.Small}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </aero:GlassPanel>

                <!-- ============ History ============ -->
                <aero:GlassPanel x:Name="PHist" Grid.Row="4" Grid.ColumnSpan="3" Padding="21,19" AutomationProperties.Name="History">
                    <Grid x:Name="HistContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="SaveCsv" DockPanel.Dock="Right" Style="{StaticResource A.RoundGlassBtn}" Width="38" Height="38" Margin="10,0,0,0"
                                    Command="{Binding SaveHistory}" AutomationProperties.Name="Save CSV" ToolTip="Save as a CSV file">
                                <aero:Icon Data="{StaticResource A.I.Download}" Size="15" />
                            </Button>
                            <Border DockPanel.Dock="Right" Height="42" Padding="4" BorderBrush="{DynamicResource A.B.Line}" BorderThickness="1"
                                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}">
                                <Grid x:Name="Seg">
                                    <Border x:Name="SegIndicator" Height="32" Width="40" HorizontalAlignment="Left" Background="{DynamicResource A.B.Pill}" Opacity="0"
                                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SegX" />
                                        </Border.RenderTransform>
                                        <!-- The demo's .seg-ind: 0 2px 10px at 18 %. A small surface. -->
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.18" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                                        </Border.Effect>
                                    </Border>
                                    <StackPanel x:Name="SegItems" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                                        <RadioButton Style="{StaticResource A.SegItem}" Content="Day" Checked="SpanChecked"
                                                     IsChecked="{Binding HistorySpan, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static local:HistorySpan.Day}}" />
                                        <RadioButton Style="{StaticResource A.SegItem}" Content="Week" Checked="SpanChecked"
                                                     IsChecked="{Binding HistorySpan, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static local:HistorySpan.Week}}" />
                                        <RadioButton Style="{StaticResource A.SegItem}" Content="Month" Checked="SpanChecked"
                                                     IsChecked="{Binding HistorySpan, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static local:HistorySpan.Month}}" />
                                        <RadioButton Style="{StaticResource A.SegItem}" Content="Year" Checked="SpanChecked"
                                                     IsChecked="{Binding HistorySpan, Mode=OneWay, Converter={StaticResource Is}, ConverterParameter={x:Static local:HistorySpan.Year}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource IconSquare}">
                                    <aero:Icon Data="{StaticResource A.I.History}" Size="15" />
                                </Border>
                                <TextBlock Text="History" Style="{StaticResource A.PanelTitle}" Margin="10,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <!-- The columns in the demo's proportions, as its table lays its figures out at the demo's width. -->
                        <Border Grid.Row="1" Style="{StaticResource A.Table.Header}" Padding="0,0,0,8">
                            <Grid x:Name="HistHead">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="234*" />
                                    <ColumnDefinition Width="169*" />
                                    <ColumnDefinition Width="124*" />
                                    <ColumnDefinition Width="145*" />
                                    <ColumnDefinition Width="134*" />
                                    <ColumnDefinition Width="207*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SpanHead" Margin="14,0" Text="Day" />
                                <TextBlock Grid.Column="1" Margin="14,0" Text="Energy" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Margin="14,0" Text="Cost" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Margin="14,0" Text="Average" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Margin="14,0" Text="Peak" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Margin="14,0" Text="Source" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <ItemsControl x:Name="HistRows" ItemsSource="{Binding HistoryShown}" Focusable="False" AutomationProperties.Name="History by period">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:HistoryRow}">
                                        <Border Style="{StaticResource A.Table.Row}" Padding="0,9" MinHeight="0" AutomationProperties.Name="{Binding Period}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="234*" />
                                                    <ColumnDefinition Width="169*" />
                                                    <ColumnDefinition Width="124*" />
                                                    <ColumnDefinition Width="145*" />
                                                    <ColumnDefinition Width="134*" />
                                                    <ColumnDefinition Width="207*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="14,0" Text="{Binding Period}" Style="{StaticResource Cell}" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Margin="14,0" Text="{Binding Energy}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="2" Margin="14,0" Text="{Binding Cost}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="3" Margin="14,0" Text="{Binding Average}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="4" Margin="14,0" Text="{Binding Peak}" Style="{StaticResource Cell}" />
                                                <ContentControl Grid.Column="5" Margin="14,0" Style="{StaticResource SourceChip}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HistEmpty" Style="{StaticResource A.Text.Secondary}" Margin="14,9" TextWrapping="Wrap" TextTrimming="None" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </aero:GlassPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>

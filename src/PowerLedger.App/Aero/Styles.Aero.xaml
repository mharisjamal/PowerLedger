        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource A.B.Text}" />

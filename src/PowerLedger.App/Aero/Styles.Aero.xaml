<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:aero="clr-namespace:PowerLedger.App.Aero">
    <!-- Aero's keyed and implicit styles (Aero look design §3, Plan S 0.8), merged by AeroWindow and by every Aero view
         through SharedDictionary, never at Application level, so its implicit styles never reach Classic, Midnight or the
         dialogs. Ported from the approved prototype's Controls.xaml (tools/AeroPreview), every key prefixed A. Colours,
         radii and type sizes come from the palette's A.* tokens by DynamicResource, never from values here, so the
         GlassMaterial can change them on a window live; durations come from AeroMotion through AeroAnimation, so reduced
         motion is asked each time a storyboard starts. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Icons.Aero.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============ focus: the accent ring, 2 px just outside the control, as the HTML's :focus-visible ============ -->
    <Style x:Key="A.Focus.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.Focus.Soft">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="{DynamicResource A.R.Focus}" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource A.Focus.Soft}" />

    <!-- ============ text ============ -->
    <Style x:Key="A.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="A.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
    </Style>
    <Style x:Key="A.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text3}" />
    </Style>
    <Style x:Key="A.Text.Number" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <!-- The HTML's .big: 40 px, medium, a line of 1.05. -->
    <Style x:Key="A.Text.Big" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Number}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Big}" />
        <Setter Property="LineHeight" Value="{DynamicResource A.T.BigLine}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- This month's figure: the demo's .month .big, 34 px on .big's line of 1.05. -->
    <Style x:Key="A.Text.BigMonth" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Number}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.BigMonth}" />
        <Setter Property="LineHeight" Value="{DynamicResource A.T.BigMonthLine}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="A.Text.Mid" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Number}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Mid}" />
    </Style>
    <Style x:Key="A.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Title}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="A.Text.Label" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Secondary}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Label}" />
    </Style>
    <Style x:Key="A.Text.Small" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
    </Style>
    <Style x:Key="A.Text.Axis" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Muted}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Axis}" />
    </Style>
    <!-- A panel's heading (.ph h2) and the quieter label under a figure (.lbl), as the prototype names them. -->
    <Style x:Key="A.PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Title}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="A.Label" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Label}" />

    <!-- ============ hover: the HTML's transitions, a layer fading in over 250 ms on CSS's ease ============ -->
    <Storyboard x:Key="A.HoverIn">
        <aero:AeroAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Ms="250" Fade="True" EasingFunction="{x:Static aero:AeroMotion.Ease}" />
    </Storyboard>
    <Storyboard x:Key="A.HoverOut">
        <aero:AeroAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Ms="250" Fade="True" EasingFunction="{x:Static aero:AeroMotion.Ease}" />
    </Storyboard>

    <Style x:Key="A.Hoverable" TargetType="Control">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Pill}" />
        <Setter Property="aero:Press.Enabled" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============ buttons ============ -->
    <!-- gbtn: a glass pill, as the demo's: white at 12 % right to its edge, a 1 px rim at 22 % over it, and inside the
         rim a light top line at 25 %; nothing else, no second ring. Brighter under the pointer. Its content sits inside
         the rim, as the CSS border is inside the box: the padding is counted from the rim in. -->
    <Style x:Key="A.GlassBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.BtnFill}" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.OutlineHover}" Opacity="0" />
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                BorderBrush="{DynamicResource A.B.BtnEdge}" BorderThickness="1" />
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" Margin="1"
                                BorderBrush="{DynamicResource A.B.BtnTop}" BorderThickness="0,1,0,0" />
                        <Border Margin="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.RoundGlassBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.GlassBtn}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The demo's toggle: a glass pill with a light that comes on. -->
    <Style x:Key="A.GlassToggle" TargetType="ToggleButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.BtnFill}" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.OutlineHover}" Opacity="0" />
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                BorderBrush="{DynamicResource A.B.BtnEdge}" BorderThickness="1" />
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" Margin="1"
                                BorderBrush="{DynamicResource A.B.BtnTop}" BorderThickness="0,1,0,0" />
                        <Border Margin="1">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse Fill="{DynamicResource A.B.Muted}" />
                                    <Ellipse x:Name="On" Fill="{DynamicResource A.B.Accent}" Opacity="0" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- outline: a hairline pill. -->
    <Style x:Key="A.OutlineBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.OutlineHover}" Opacity="0" />
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                BorderBrush="{DynamicResource A.B.Line}" BorderThickness="1" Background="Transparent" />
                        <Border Margin="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- btn: the accent action, the accent's ink on it. -->
    <Style x:Key="A.AccentBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.AccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.AccentTop}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border CornerRadius="{DynamicResource A.R.Button}" Background="{TemplateBinding Background}" />
                        <Border x:Name="Hover" CornerRadius="{DynamicResource A.R.Button}" Background="{DynamicResource A.B.AccentHover}" Opacity="0" />
                        <Border CornerRadius="{DynamicResource A.R.Button}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- btn.ghost: the quieter action beside an accent one. -->
    <Style x:Key="A.GhostBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.AccentBtn}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="Background" Value="{DynamicResource A.B.Well2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.GhostTop}" />
    </Style>

    <!-- white-round: the unit switch on Power now. -->
    <Style x:Key="A.WhiteRoundBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.WhiteRoundInk}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Ellipse Fill="{DynamicResource A.B.WhiteRound}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.18" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Hover" Fill="{DynamicResource A.B.WhiteRoundHover}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- expand: a quiet round icon button. -->
    <Style x:Key="A.ExpandBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Hover" Fill="{DynamicResource A.B.WellHover}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in the sidebar or a menu: a capsule (or the Tag's radius) that lights under the pointer. -->
    <Style x:Key="A.RowBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Tag" Value="{DynamicResource A.R.Pill}" />
        <Setter Property="aero:Press.Enabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" Background="{DynamicResource A.B.Well}" Opacity="0">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{x:Static aero:Capsule.Instance}">
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.MenuBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.RowBtn}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Tag" Value="{DynamicResource A.R.MenuItem}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ============ navigation ============ -->
    <!-- The sidebar's pages: the icon's disc turns the accent when chosen; the glass pill behind is the window's indicator.
         The demo's .nav a: its faint fill right to the edge, a 1 px ring at 4 % over it and a light top line at 12 % on
         the same first row, so the edge is never darker than the fill. -->
    <Style x:Key="A.NavItem" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.NavFill}" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.NavHover}" Opacity="0" />
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                BorderBrush="{DynamicResource A.B.SoftEdge}" BorderThickness="1" />
                        <Border CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                BorderBrush="{DynamicResource A.B.SoftTop}" BorderThickness="0,1,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="6,0">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{DynamicResource A.B.NavIcon}" />
                                <aero:Icon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource A.B.Text}" />
                                <Grid x:Name="On" Opacity="0">
                                    <Ellipse Fill="{DynamicResource A.B.Accent}" />
                                    <aero:Icon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource A.B.AccentInk}" />
                                </Grid>
                            </Grid>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Ms="350" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Ms="350" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- seg: a segmented choice (History's span); the white pill behind is the view's indicator. -->
    <Style x:Key="A.SegItem" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="32" />
        <!-- 20 px each side, and the demo's .03em letter-spacing, which WPF text can't draw, kept in the button's width so
             the white pill has the demo's size. -->
        <Setter Property="Padding">
            <Setter.Value>
                <MultiBinding Converter="{x:Static aero:Tracking.SegPadding}">
                    <Binding Path="Content" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Ink}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- txt-toggle: Cost or Energy, words that brighten when chosen. -->
    <Style x:Key="A.TextToggle" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text3}" />
        <Setter Property="aero:Press.Enabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- opts: a choice among a few (Settings, a menu's choices): a hairline pill that fills with the pill white when chosen. -->
    <Style x:Key="A.OptItem" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Box" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                BorderBrush="{DynamicResource A.B.Line}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.OutlineHover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource A.B.Pill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource A.B.Pill}" />
                            <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice of a few (0.10.4, Settings' Style, Behind the glass and Appearance): the demo's .seg, one hairline capsule
         round the options, the chosen one the white pill with its soft shadow, the rest the quieter text on the glass. -->
    <Style x:Key="A.SegGroup" TargetType="Border">

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:aero="clr-namespace:PowerLedger.App.Aero">
    <!-- Aero's keyed and implicit styles (Aero look design §3, Plan S 0.8), merged by AeroWindow and by every Aero view
         through SharedDictionary, never at Application level, so its implicit styles never reach Classic, Midnight or the
         dialogs. Ported from the approved prototype's Controls.xaml (tools/AeroPreview), every key prefixed A. Colours,
         radii and type sizes come from the palette's A.* tokens by DynamicResource, never from values here, so the
         GlassMaterial can change them on a window live; durations come from AeroMotion through AeroAnimation, so reduced
         motion is asked each time a storyboard starts. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/PowerLedger;component/Aero/Icons.Aero.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============ focus: the accent ring, 2 px just outside the control, as the HTML's :focus-visible ============ -->
    <Style x:Key="A.Focus.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2"
                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.Focus.Soft">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" CornerRadius="{DynamicResource A.R.Focus}" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource A.Focus.Soft}" />

    <!-- ============ text ============ -->
    <!-- The mockup's text shadow (.t and .sub: 0 1px 2px, navy at 28 %), on text only (0.10.9): every TextBlock without a
         style of its own, and every text style here, carries it; an icon or a chart's line never does. -->
    <Style TargetType="TextBlock">
        <Setter Property="Effect" Value="{DynamicResource A.Glass.TextShadow}" />
    </Style>
    <Style x:Key="A.Text.Body" TargetType="TextBlock">
        <Setter Property="Effect" Value="{DynamicResource A.Glass.TextShadow}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="A.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
    </Style>
    <Style x:Key="A.Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text3}" />
    </Style>
    <Style x:Key="A.Text.Number" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <!-- The HTML's .big: 40 px, medium, a line of 1.05. -->
    <Style x:Key="A.Text.Big" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Number}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Big}" />
        <Setter Property="LineHeight" Value="{DynamicResource A.T.BigLine}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- This month's figure: the demo's .month .big, 34 px on .big's line of 1.05. -->
    <Style x:Key="A.Text.BigMonth" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Number}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.BigMonth}" />
        <Setter Property="LineHeight" Value="{DynamicResource A.T.BigMonthLine}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="A.Text.Mid" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Number}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Mid}" />
    </Style>
    <Style x:Key="A.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Title}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="A.Text.Label" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Secondary}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Label}" />
    </Style>
    <Style x:Key="A.Text.Small" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
    </Style>
    <Style x:Key="A.Text.Axis" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Muted}">
        <Setter Property="FontSize" Value="{DynamicResource A.T.Axis}" />
    </Style>
    <!-- A panel's heading (.ph h2) and the quieter label under a figure (.lbl), as the prototype names them. -->
    <Style x:Key="A.PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Title}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="A.Label" TargetType="TextBlock" BasedOn="{StaticResource A.Text.Label}" />

    <!-- ============ liquid glass (0.10.9, the owner's recipe): the one template every glass piece draws with ============ -->
    <!-- A piece, bottom to top: the engine's live backdrop (brightness 1.1, blur 2, the turbulence's bend), clipped to the
         piece; its shadows (GlassShadow: the recipe's drop shadow of what the piece paints, -8, -10, deviation 46, black at
         37 %, and a bubble's own soft one under it), worked out once into small bitmaps; the tint (none by default); the
         glowing edge (GlassGlow: the recipe's two inset highlights in white at 70 %); then the content, above the glow so
         its text reads. The mockup's text shadow (.t and .sub) falls on the text alone, never on an icon or a line: the
         text styles below carry it, not the piece. Nothing here runs per frame. A piece inside another reads the outer
         piece's tint and content beneath it, as the browser's backdrop root has it; the shadow and the glow are left out
         of that, as CSS paints them apart from the content. -->

    <ControlTemplate x:Key="A.Glass.Template" TargetType="aero:GlassPanel">
        <Grid>
            <aero:LiquidGlassBackdrop x:Name="PART_Backdrop" CornerRadius="{TemplateBinding CornerRadius}" IsLive="{DynamicResource A.Glass.Live}" />
            <!-- Empty but for a dialog or a toast, which float over the window's own panes: the window lays the stage under
                 it here (AeroWindow.Frost), as the browser's backdrop filter would read the page beneath. -->
            <Border x:Name="PART_Frost" IsHitTestVisible="False" />
            <aero:GlassShadow x:Name="PART_Shadow" aero:LiquidGlassBackdrop.InBackdrop="False" CornerRadius="{TemplateBinding CornerRadius}" Tint="{TemplateBinding Background}"
                              Glow="{DynamicResource A.Glass.Glow}" Casts="{TemplateBinding HasShadow}" Bubble="{TemplateBinding Bubble}" Lift="{TemplateBinding Lift}" />
            <Border x:Name="PART_Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" IsHitTestVisible="False" />
            <aero:GlassGlow x:Name="PART_Glow" aero:LiquidGlassBackdrop.InBackdrop="False" CornerRadius="{TemplateBinding CornerRadius}" Strength="{DynamicResource A.Glass.Glow}" />
            <ContentPresenter x:Name="PART_Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasGlow" Value="False">
                <Setter TargetName="PART_Glow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_Shadow" Property="Glow" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="aero:GlassPanel">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Background" Value="{DynamicResource A.B.GlassTint}" />
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Panel}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource A.Glass.Template}" />
    </Style>
    <!-- A capsule of glass (a pill, a bubble, a group of buttons): the same piece, its corners half its height. -->
    <Style x:Key="A.Glass.Capsule" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- A bubble on glass: the chosen page, a segmented control's choice (the mockup's .lg.cap.bubble). -->
    <Style x:Key="A.Glass.Bubble" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.Glass.Capsule}">
        <Setter Property="Bubble" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>


    <!-- ============ hover: the HTML's transitions, a layer fading in over 250 ms on CSS's ease ============ -->
    <Storyboard x:Key="A.HoverIn">
        <aero:AeroAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Ms="250" Fade="True" EasingFunction="{x:Static aero:AeroMotion.Ease}" />
    </Storyboard>
    <Storyboard x:Key="A.HoverOut">
        <aero:AeroAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Ms="250" Fade="True" EasingFunction="{x:Static aero:AeroMotion.Ease}" />
    </Storyboard>

    <Style x:Key="A.Hoverable" TargetType="Control">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Pill}" />
        <Setter Property="aero:Press.Enabled" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============ buttons ============ -->
    <!-- The hover and press every glass button shares: the mockup's .hov, a white wash (14 %) fading in over the glass, and
         its .press, the button squeezed to 95 % (Press) and springing back. -->
    <!-- A glass button: a capsule of the recipe's glass, its words on it (the kit's .pill; 0.10.9, the kit wins for a
         control): white at 12 % at rest, 26 % under the pointer (the wash's 14 % over it), and squeezed to 95 % with no
         wash while pressed. -->
    <Style x:Key="A.GlassBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="36" />
        <!-- The mockup's .cap words: 14, medium. -->
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource A.B.PillTint}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <aero:GlassPanel x:Name="Glass" Style="{StaticResource A.Glass.Capsule}" Background="{TemplateBinding Background}"
                                         HasShadow="{Binding (aero:GlassButton.Casts), RelativeSource={RelativeSource TemplatedParent}}"
                                         Lift="{Binding (aero:GlassButton.Lift), RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.GlassHover}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.RoundGlassBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.GlassBtn}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- A bare button on a glass group (the mockup's button.cap inside the top bar's capsule): no glass of its own, which
         would lie glass on glass, only the hover's white wash and the press. -->
    <Style x:Key="A.CapBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.GlassHover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.RoundCapBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.CapBtn}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- The window's own minimise, maximise and close (0.10.9): compact glyphs bare on the top bar's capsule, after Home
         past a hairline, the mockup's 40 high, narrower than its icon buttons so the group still reads as its capsule. -->
    <Style x:Key="A.WindowBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.CapBtn}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.NavText}" />
    </Style>

    <!-- The overlay's toggle, bare on the top bar's group, the mockup's 44 by 40: a small light in the accent comes on at
         its icon's upper right while the overlay shows. -->
    <Style x:Key="A.CapToggle" TargetType="ToggleButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.GlassHover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                        <Ellipse x:Name="On" Width="6" Height="6" Margin="0,9,9,0" Fill="{DynamicResource A.B.Accent}" Opacity="0"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A glass toggle standing alone: a glass capsule with a light that comes on. -->
    <Style x:Key="A.GlassToggle" TargetType="ToggleButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <aero:GlassPanel Style="{StaticResource A.Glass.Capsule}" Background="{TemplateBinding Background}" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.GlassHover}" Opacity="0" IsHitTestVisible="False" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse Fill="{DynamicResource A.B.Muted}" />
                                <Ellipse x:Name="On" Fill="{DynamicResource A.B.Accent}" Opacity="0" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- outline: a quieter action, a glass capsule as the kit's Switch back. -->
    <Style x:Key="A.OutlineBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.GlassBtn}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- btn: the accent action (Open report): the recipe's glass under the accent at 86 % (the mockup's lime glass), the
         accent's ink on it, semibold. -->
    <!-- The lime action: the Dashboard's Open report, the mockup's .lg.cap: the recipe's drop shadow of its lime, no pill
         box-shadow. -->
    <Style x:Key="A.AccentBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.GlassBtn}">
        <Setter Property="aero:GlassButton.Casts" Value="True" />
        <Setter Property="aero:GlassButton.Lift" Value="{x:Null}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.AccentInk}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource A.B.AccentGlass}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Pill}" />
    </Style>
    <!-- btn.ghost: the quieter action beside an accent one: untinted glass. -->
    <Style x:Key="A.GhostBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.GlassBtn}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <!-- white-round: the unit switch on Power now. -->
    <Style x:Key="A.WhiteRoundBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.WhiteRoundInk}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Ellipse Fill="{DynamicResource A.B.WhiteRound}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.18" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Hover" Fill="{DynamicResource A.B.WhiteRoundHover}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- expand: a quiet round icon button. -->
    <Style x:Key="A.ExpandBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Hover" Fill="{DynamicResource A.B.WellHover}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A row in the sidebar or a menu: a capsule (or the Tag's radius) that lights under the pointer. -->
    <Style x:Key="A.RowBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Tag" Value="{DynamicResource A.R.Pill}" />
        <Setter Property="aero:Press.Enabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" Background="{DynamicResource A.B.Well}" Opacity="0">
                            <Border.CornerRadius>
                                <MultiBinding Converter="{x:Static aero:Capsule.Instance}">
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Border.CornerRadius>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.MenuBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.RowBtn}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Tag" Value="{DynamicResource A.R.MenuItem}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ============ navigation ============ -->
    <!-- The sidebar's pages, the mockup's .nav: a bare row, its 18 px icon and its name 12 apart, 46 high, 14 in from each
         side, the words at 88 %; the chosen one whole, on the glass bubble that is the window's indicator (it slides from
         page to page), the rest lit by a white wash under the pointer. -->
    <Style x:Key="A.NavItem" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.NavText}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Nav}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.GlassHover}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Margin="14,0">
                            <aero:Icon Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="18" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" Effect="{DynamicResource A.Glass.TextShadow}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- seg: a segmented choice (the Dashboard's and History's spans), the mockup's: bare words at 85 % in a glass capsule
         group, the chosen one whole on the glass bubble behind it, which is the view's indicator and slides. The mockup's
         button.cap: 14 medium, 16 each side, no text shadow (it has no .t). -->
    <Style x:Key="A.SegItem" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.SegText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A segmented control's group: the mockup's glass capsule, 4 in round its words. -->
    <Style x:Key="A.SegTrack" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.Glass.Capsule}">
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- txt-toggle: Cost or Energy, words that brighten when chosen. -->
    <Style x:Key="A.TextToggle" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text3}" />
        <Setter Property="aero:Press.Enabled" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- opts: a choice among a few (Settings, a menu's choices), the mockup's Style row: bare words, the chosen one on a
         white glass pill (the recipe's glass under white fading to #DFE4EE) in the ink, the rest lit by a white wash under
         the pointer. -->
    <Style x:Key="A.OptItem" TargetType="RadioButton" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <aero:GlassPanel x:Name="Chosen" Style="{StaticResource A.Glass.Capsule}" Background="{DynamicResource A.B.PillGlass}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="Hover" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                Background="{DynamicResource A.B.GlassHover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                            <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource A.HoverIn}" /></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource A.HoverOut}" /></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chosen" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice of a few (Settings' Style and Appearance), the kit's: the options in a well (its .well, a capsule 42 high,
         4 in), the chosen one the white glass pill. -->
    <Style x:Key="A.SegGroup" TargetType="Border">
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="21" />
        <!-- The boards' .well: navy from 22 % at its top to 10 % at its foot. -->
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{DynamicResource A.C.BoardWellTop}" />
                    <GradientStop Offset="1" Color="{DynamicResource A.C.BoardWellFoot}" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.InsetEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- The Styles board's Style choice: 34 high, 16 each side, 14 medium in white, 2 apart; the chosen one the white pill. -->
    <Style x:Key="A.SegOpt" TargetType="RadioButton" BasedOn="{StaticResource A.OptItem}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
    </Style>

    <!-- ============ inputs ============ -->
    <!-- switch, the Styles board's .sw: a track 52 by 30, white at 14 % off, the accent on, with the inset's shade along
         its top and light along its foot; the knob 24 across, white shading to #E6E9F2 from its upper left, a soft shadow
         under it (0 3px 8px, navy at 45 %); it springs across (GlassSwitch runs the motion). -->
    <Style TargetType="aero:GlassSwitch" BasedOn="{StaticResource A.Hoverable}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="30" />
        <Setter Property="aero:Press.Enabled" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="aero:GlassSwitch">
                    <Grid Background="Transparent">
                        <Border CornerRadius="15" Background="{DynamicResource A.B.SwitchOff}" />
                        <Border x:Name="PART_On" CornerRadius="15" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="{DynamicResource A.C.AccentHigh}" />
                                    <GradientStop Offset="1" Color="{DynamicResource A.C.AccentLow}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="15" BorderBrush="{DynamicResource A.B.InsetEdge}" BorderThickness="1" />
                        <Ellipse x:Name="PART_Knob" Width="24" Height="24" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource A.B.Knob}">
                            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.45" Color="{DynamicResource A.C.Navy}" RenderingBias="Performance" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The top bar's search: bare text on the glass pill that holds it. -->
    <Style x:Key="A.SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A typed value: a well as the demo's .well, its fill right to the edge, a 1 px ring at 5 % over it and a light top
         line on the first row; the accent edge while it has the keyboard. -->
    <Style x:Key="A.Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource A.B.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="Background" Value="{DynamicResource A.B.Well}" />
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.WellEdge}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource A.R.MenuItem}" />
                        <Border CornerRadius="{DynamicResource A.R.MenuItem}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border CornerRadius="{DynamicResource A.R.MenuItem}" BorderBrush="{DynamicResource A.B.WellTop}" BorderThickness="0,1,0,0" />
                        <Border x:Name="Ring" CornerRadius="{DynamicResource A.R.MenuItem}" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource A.B.WellHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A typed secret, in the same well as a typed value: the light top edge, the hover wash and the accent ring while it
         has the keyboard. -->
    <Style x:Key="A.Secret" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource A.B.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="Background" Value="{DynamicResource A.B.Well}" />
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.WellEdge}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource A.R.MenuItem}" />
                        <Border CornerRadius="{DynamicResource A.R.MenuItem}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border CornerRadius="{DynamicResource A.R.MenuItem}" BorderBrush="{DynamicResource A.B.WellTop}" BorderThickness="0,1,0,0" />
                        <Border x:Name="Ring" CornerRadius="{DynamicResource A.R.MenuItem}" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource A.B.WellHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A yes or no: a glass square that fills with the accent and its ink's tick. -->
    <Style x:Key="A.Tick" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="6" Background="{DynamicResource A.B.Well2}" />
                            <Border CornerRadius="6" BorderBrush="{DynamicResource A.B.BtnEdge}" BorderThickness="1" />
                            <Grid x:Name="On" Opacity="0">
                                <Border CornerRadius="6" Background="{DynamicResource A.B.Accent}" />
                                <aero:Icon Data="{StaticResource A.I.Check}" Size="14" StrokeWidth="2.8" Foreground="{DynamicResource A.B.AccentInk}" />
                            </Grid>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource A.B.Well3}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A slider (the Glass settings' tint and edge light; the overlay's opacity), the Styles board's: a bar 12 high in the
         accent, with a light top line (inset 0 1px 0, white at 70 %), up to a white knob 26 across with the switch's
         shadow; the rest of the track bare, as the board draws it. -->
    <Style x:Key="A.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="12" CornerRadius="6" Background="{TemplateBinding Background}" VerticalAlignment="Center" Margin="0,0,-13,0" />
                        <Border Height="12" CornerRadius="6" BorderBrush="{DynamicResource A.B.SliderTop}" BorderThickness="0,1,0,0" VerticalAlignment="Center" Margin="0,0,-13,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{DynamicResource A.B.Knob}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.45" Color="{DynamicResource A.C.Navy}" RenderingBias="Performance" />
                        </Ellipse.Effect>
                    </Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.Slider" TargetType="Slider">
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Pill}" />
        <Setter Property="SmallChange" Value="0.01" />
        <Setter Property="LargeChange" Value="0.1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource A.SliderFill}" Background="{DynamicResource A.B.Accent}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource A.SliderFill}" Background="Transparent" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource A.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ surfaces ============ -->
    <!-- A dialog: the recipe's glass under the dialogs' tint, dense enough for its words over the scrim and the page under
         it (the mockup's menu), its corners the recipe's 28, centred; the window opens it out of its trigger. -->
    <Style x:Key="A.Modal" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="Background" Value="{DynamicResource A.B.ModalFill}" />
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Modal}" />
        <Setter Property="Padding" Value="24,22,24,22" />
        <Setter Property="Width" Value="460" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="AutomationProperties.Name" Value="Dialog" />
    </Style>
    <!-- The Aero intro video's dialog (Plan S intro): the same modal glass, wide enough for a 16:9 picture; the window
         narrows it to fit a small window. -->
    <Style x:Key="A.Modal.Intro" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.Modal}">
        <Setter Property="Width" Value="720" />
        <Setter Property="Padding" Value="20,20,20,20" />
        <Setter Property="AutomationProperties.Name" Value="The Aero intro" />
    </Style>
    <!-- Play and Replay over the intro's picture: a larger round glass button, low in the frame so the poster's own title
         stays clear. -->
    <Style x:Key="A.Intro.PlayBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.RoundGlassBtn}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- A toast: a small glass capsule at the foot of the window, read out politely. It floats over the page's own text,
         so it takes the menus' tint (the mockup's menu), dense enough for its words. -->
    <Style x:Key="A.Toast" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Toast}" />
        <Setter Property="Background" Value="{DynamicResource A.B.MenuFill}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <!-- The banner under the top bar ("PowerLedger has a new look"): a glass strip at the well's radius. -->
    <Style x:Key="A.Banner" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Well}" />
        <Setter Property="Padding" Value="18,10,10,10" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <!-- A top-bar or caption pill (0.10.1, free-form; 0.10.9 liquid glass): each floats on its own over the desktop, a glass
         capsule of its own and a piece of the window's shape, with its buttons bare on it (A.CapBtn), as the mockup's
         .lg.cap groups: one glass, never glass on glass. -->
    <Style x:Key="A.TopPill" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.Glass.Capsule}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The hairline between a glass group's bare buttons (the mockup's .sep: 1 by 22, white at 22 %, its group's 2 px gap
         either side). -->
    <Style x:Key="A.GroupSep" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource A.B.GroupSep}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- The resize grip: a small glass disc off the stage's bottom-right corner, in the smaller layout only. -->
    <Style x:Key="A.Grip" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.TopPill}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,3,3" />
        <Setter Property="ToolTip" Value="Resize" />
    </Style>
    <!-- The grab bar (visionOS's, top middle): a piece of the window's shape 120 by 22 that takes the pointer, and in it
         only the bar, the mockup's glass capsule 66 by 7. The bar's opacity is GrabBar's (the mockup's rest, near and over:
         a quarter, half, whole), and on it a white wash brightens it a touch; the focus ring hugs the bar, inside the shape.
         The hit area round the bar is clear. -->
    <Style x:Key="A.GrabBar" TargetType="aero:GrabBar">
        <Setter Property="Width" Value="{x:Static aero:GrabBar.HitWidth}" />
        <Setter Property="Height" Value="{x:Static aero:GrabBar.HitHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HasGlow" Value="False" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="aero:GrabBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="PART_Focus" Width="78" Height="19" CornerRadius="9.5" BorderBrush="{DynamicResource A.B.Accent}" BorderThickness="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Grid x:Name="PART_Bar" Width="{x:Static aero:GrabBar.BarWidth}" Height="{x:Static aero:GrabBar.BarHeight}" Opacity="0.25"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <aero:GlassPanel Style="{StaticResource A.Glass.Capsule}" Background="{DynamicResource A.B.PillTint}" HasShadow="False" Lift="{x:Static aero:GlassLift.Pill}" />
                            <Border x:Name="PART_Bright" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                    Background="{DynamicResource A.B.GlassHover}" Opacity="0" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A well, the mockup's .inset: the quieter surface inside a pane, never glass on glass: navy at 14 %, its inset shade
         along the top and its hairline of light along the foot as a one-pixel edge (A.B.InsetEdge), the padding a pixel
         less for it. -->
    <Style x:Key="A.Well" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Well}" />
        <Setter Property="Background" Value="{DynamicResource A.B.InsetFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.InsetEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,13,15,13" />
    </Style>

    <!-- ============ menus ============ -->
    <!-- A menu: the recipe's glass under the kit's menu tint (dense enough for its words over whatever it covers), its
         corners the kit's 22, a soft shadow under it within the popup's room, springing out of what it hangs from (opacity
         and scale .9 to 1, a 6 px drop); under reduced motion only the fade is left. -->
    <Style x:Key="A.Menu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid x:Name="Root" Margin="14" RenderTransformOrigin="1,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Scale" />
                                <TranslateTransform x:Name="Drop" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border CornerRadius="{DynamicResource A.R.Menu}" Background="{DynamicResource A.B.MenuFill}" Opacity="0.6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.5" Color="{DynamicResource A.C.Navy}" RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                        <aero:GlassPanel CornerRadius="{DynamicResource A.R.Menu}" Background="{DynamicResource A.B.MenuFill}" HasShadow="False">
                            <ItemsPresenter Margin="8" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </aero:GlassPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ContextMenu.Opened">
                            <BeginStoryboard>
                                <Storyboard>
                                    <aero:AeroAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Ms="380" Fade="True" EasingFunction="{x:Static aero:AeroMotion.Glide}" />
                                    <aero:AeroAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Ms="380" Fade="False" EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                    <aero:AeroAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Ms="380" Fade="False" EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                    <aero:AeroAnimation Storyboard.TargetName="Drop" Storyboard.TargetProperty="Y" From="-6" To="0" Ms="380" Fade="False" EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A menu's item: .mi, a rounded row that lights under the pointer; the accent tick before a chosen one; its
         gesture or figure (.mi em) quieter at the right. -->
    <Style x:Key="A.MenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.NavText}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="14" Padding="14,10" BorderBrush="Transparent" BorderThickness="0,1,0,0">
                        <DockPanel Margin="0,-1,0,0">
                            <aero:Icon x:Name="Check" DockPanel.Dock="Left" Data="{StaticResource A.I.Check}" Size="14" StrokeWidth="2.4" Margin="0,0,10,0"
                                       Foreground="{DynamicResource A.B.Accent}" Visibility="Collapsed" />
                            <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{TemplateBinding InputGestureText}" FontSize="{DynamicResource A.T.Small}"
                                       Foreground="{DynamicResource A.B.Text2}" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource A.B.GlassHover}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource A.B.MenuShine}" />
                            <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="12,6" Background="{DynamicResource A.B.WellTop}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ data ============ -->
    <!-- Where a figure came from (.src): a dot in the quality's colour and the word, quiet. -->
    <ControlTemplate x:Key="A.Chip.Face" TargetType="ContentControl">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <Ellipse Width="9" Height="9" Fill="{TemplateBinding Background}" VerticalAlignment="Center" />
            <TextBlock Margin="7,0,0,0" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>
    <Style x:Key="A.Chip.Measured" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Content" Value="Measured" />
        <Setter Property="Background" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Template" Value="{StaticResource A.Chip.Face}" />
    </Style>
    <Style x:Key="A.Chip.Calibrated" TargetType="ContentControl" BasedOn="{StaticResource A.Chip.Measured}">
        <Setter Property="Content" Value="Calibrated" />
        <Setter Property="Background" Value="{DynamicResource A.B.Violet}" />
    </Style>
    <Style x:Key="A.Chip.Estimated" TargetType="ContentControl" BasedOn="{StaticResource A.Chip.Measured}">
        <Setter Property="Content" Value="Estimated" />
        <Setter Property="Background" Value="{DynamicResource A.B.Muted}" />
    </Style>

    <!-- The history table (the HTML's table): quiet column heads, rows that light as a well under the pointer. -->
    <Style x:Key="A.Table.Header" TargetType="Border">
        <Setter Property="Padding" Value="14,0,14,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource A.B.Text3}" />
    </Style>
    <Style x:Key="A.Table.Row" TargetType="Border">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.MenuItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource A.B.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource A.B.Well}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ implicit, scoped to the window this dictionary is merged into ============ -->
    <Style TargetType="TextBox" BasedOn="{StaticResource A.Field}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource A.Tick}" />
    <Style TargetType="ContextMenu" BasedOn="{StaticResource A.Menu}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource A.MenuItem}" />

    <!-- The side scroll bar (0.10.8): a thin capsule thumb as the demo's .gbtn, the white fill at 12 % brightened on it by
         the hover wash (about 20 %), a 1 px edge at 22 %; no track, no arrows. The thumb takes the pointer across the
         whole strip; the capsule, 6 wide (10 on it, ScrollGlow), sits 4 in from the pane's edge. -->
    <Style x:Key="A.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Grid x:Name="PART_Capsule" Width="{x:Static aero:ScrollGlow.Thin}" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <aero:GlassPanel CornerRadius="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" Padding="0"
                                             Background="{DynamicResource A.B.PillTint}" HasShadow="False" Lift="{x:Static aero:GlassLift.Pill}" />
                            <Border x:Name="PART_Bright" Opacity="0" CornerRadius="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                    Background="{DynamicResource A.B.GlassHover}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.ScrollThumbH" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Grid x:Name="PART_Capsule" Height="{x:Static aero:ScrollGlow.Thin}" VerticalAlignment="Bottom" Margin="0,0,0,4">
                            <aero:GlassPanel Style="{StaticResource A.Glass.Capsule}" Background="{DynamicResource A.B.PillTint}" HasShadow="False" Lift="{x:Static aero:GlassLift.Pill}" />
                            <Border x:Name="PART_Bright" Opacity="0" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}"
                                    Background="{DynamicResource A.B.GlassHover}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="{x:Static aero:ScrollGlow.Strip}" />
        <Setter Property="MinWidth" Value="{x:Static aero:ScrollGlow.Strip}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource A.ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{x:Static aero:ScrollGlow.Strip}" />
                <Setter Property="MinHeight" Value="{x:Static aero:ScrollGlow.Strip}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="4,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource A.ScrollThumbH}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- A scroll bar's host: a clear glass piece, so a shown bar is a piece of the free-form window's shape (as the grab
         bar is); ScrollGlow hides it at rest, when it is no piece at all. No frost, rim, sheen or shadow. -->
    <Style x:Key="A.ScrollHost" TargetType="aero:GlassPanel">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HasGlow" Value="False" />
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="aero:GlassPanel">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Every scrolling surface: the bars overlay the content (no layout shift), each in its host at the pane's right or
         bottom edge, hidden at rest and lit by ScrollGlow. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="aero:ScrollGlow.Enabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <aero:GlassPanel x:Name="PART_VerticalHost" Style="{StaticResource A.ScrollHost}" HorizontalAlignment="Right" Width="{x:Static aero:ScrollGlow.Strip}">
                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Cursor="Arrow" Opacity="0" Minimum="0"
                                       AutomationProperties.AutomationId="VerticalScrollBar"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </aero:GlassPanel>
                        <aero:GlassPanel x:Name="PART_HorizontalHost" Style="{StaticResource A.ScrollHost}" VerticalAlignment="Bottom" Height="{x:Static aero:ScrollGlow.Strip}">
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Cursor="Arrow" Opacity="0" Minimum="0"
                                       AutomationProperties.AutomationId="HorizontalScrollBar"
                                       Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </aero:GlassPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips: the HTML's chart tip, a pill-white bubble with the ink's words, fading in; no glass. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource A.B.Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid x:Name="Root" Margin="8" Opacity="0">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource A.R.Button}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.25" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <aero:AeroAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Ms="200" EasingFunction="{x:Static aero:AeroMotion.Glide}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

                        <Ellipse x:Name="PART_Knob" Width="22" Height="22" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{DynamicResource A.B.White}">
                            <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.3" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                            </Ellipse.Effect>

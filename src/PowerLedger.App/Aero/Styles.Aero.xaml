    <!-- A yes or no: a glass square that fills with the accent and its ink's tick. -->
    <Style x:Key="A.Tick" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Soft}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="6" Background="{DynamicResource A.B.Well2}" />
                            <Border CornerRadius="6" BorderBrush="{DynamicResource A.B.BtnEdge}" BorderThickness="1" />
                            <Grid x:Name="On" Opacity="0">
                                <Border CornerRadius="6" Background="{DynamicResource A.B.Accent}" />
                                <aero:Icon Data="{StaticResource A.I.Check}" Size="14" StrokeWidth="2.8" Foreground="{DynamicResource A.B.AccentInk}" />
                            </Grid>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource A.B.Well3}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><aero:AeroAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Ms="250" EasingFunction="{x:Static aero:AeroMotion.Ease}" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A slider (the Glass settings' tint, frost and edge light; the overlay's opacity): the HTML's range input with
         accent-color, a thin track filled with the accent up to a white knob. -->
    <Style x:Key="A.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{DynamicResource A.B.White}">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.3" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                        </Ellipse.Effect>
                    </Ellipse>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.Slider" TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource A.Focus.Pill}" />
        <Setter Property="SmallChange" Value="0.01" />
        <Setter Property="LargeChange" Value="0.1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource A.B.Track}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource A.SliderFill}" Background="{DynamicResource A.B.Accent}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource A.SliderFill}" Background="Transparent" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource A.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ surfaces ============ -->
    <!-- The glass pane: shadow outside only (pre-rendered), frost where a window has its own, the tint, the edge as the
         demo's .glass (GlassEdge: the 1 px rim, the light and dark lines inside it, the top sheen, the inner shade), the
         pointer sheen.
         The shadow's cache is on the grid round the blurred borders and their clip, so the bitmap holds the finished,
         clipped shadow: an Effect or Clip on the cached element itself is applied after the cache, on every frame that
         touches the pane, and that re-blurred every pane's two shadows on each live reading (Plan U, measured). -->
    <Style TargetType="aero:GlassPanel">
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Body}" />
        <Setter Property="Background" Value="{DynamicResource A.B.GlassTint}" />
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Panel}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="aero:GlassPanel">
                    <Grid>
                        <Grid x:Name="PART_Shadow" Margin="-100" IsHitTestVisible="False">
                            <Grid.CacheMode><BitmapCache SnapsToDevicePixels="True" /></Grid.CacheMode>
                            <Grid x:Name="PART_ShadowClip">
                                <Border Margin="100" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource A.B.Shadow}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="{DynamicResource A.Glass.ShadowFarBlur}" ShadowDepth="{DynamicResource A.Glass.ShadowFarDepth}"
                                                          Opacity="{DynamicResource A.Glass.ShadowFarOpacity}" Color="{DynamicResource A.C.Shadow}" Direction="270" RenderingBias="Performance" />
                                    </Border.Effect>
                                </Border>
                                <Border Margin="100" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource A.B.Shadow}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="{DynamicResource A.Glass.ShadowNearBlur}" ShadowDepth="{DynamicResource A.Glass.ShadowNearDepth}"
                                                          Opacity="{DynamicResource A.Glass.ShadowNearOpacity}" Color="{DynamicResource A.C.Shadow}" Direction="270" RenderingBias="Performance" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>
                        <Border x:Name="PART_Frost" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Frost}" IsHitTestVisible="False" />
                        <Border x:Name="PART_Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" />
                        <aero:GlassEdge x:Name="PART_Edge" CornerRadius="{TemplateBinding CornerRadius}"
                                        RimA="{DynamicResource A.C.RimA}" RimB="{DynamicResource A.C.RimB}" RimC="{DynamicResource A.C.RimC}" RimD="{DynamicResource A.C.RimD}"
                                        Light="{DynamicResource A.C.RimInner}" Dark="{DynamicResource A.C.RimDark}" Sheen="{DynamicResource A.C.TopSheen}"
                                        Shade="{DynamicResource A.C.InnerShade}" />
                        <Border x:Name="PART_Sheen" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <!-- The halo (0.10.1): a soft shadow behind the content, laid twice (one alone darkens the ground by a sixth
                             beside thin text; two by about three eighths), that keeps text readable on the bright glass; none on
                             the strict glass (GlassMaterial). -->
                        <Border x:Name="PART_Halo" Effect="{DynamicResource A.Glass.Halo}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Effect="{DynamicResource A.Glass.Halo}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasRim" Value="False">
                            <Setter TargetName="PART_Edge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dialog: the darker modal glass, wider radius, centred; the window opens it out of its trigger. -->
    <Style x:Key="A.Modal" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="Background" Value="{DynamicResource A.B.ModalFill}" />
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Modal}" />
        <Setter Property="Padding" Value="24,22,24,22" />
        <Setter Property="Width" Value="460" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="AutomationProperties.Name" Value="Dialog" />
    </Style>
    <!-- The Aero intro video's dialog (Plan S intro): the same modal glass, wide enough for a 16:9 picture; the window
         narrows it to fit a small window. -->
    <Style x:Key="A.Modal.Intro" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.Modal}">
        <Setter Property="Width" Value="720" />
        <Setter Property="Padding" Value="20,20,20,20" />
        <Setter Property="AutomationProperties.Name" Value="The Aero intro" />
    </Style>
    <!-- Play and Replay over the intro's picture: a larger round glass button, low in the frame so the poster's own title
         stays clear. -->
    <Style x:Key="A.Intro.PlayBtn" TargetType="ButtonBase" BasedOn="{StaticResource A.RoundGlassBtn}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- A toast: a small glass capsule at the foot of the window, read out politely. -->
    <Style x:Key="A.Toast" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Toast}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="SheenEnabled" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <!-- The banner under the top bar ("PowerLedger has a new look"): a glass strip at the well's radius. -->
    <Style x:Key="A.Banner" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Well}" />
        <Setter Property="Padding" Value="18,10,10,10" />
        <Setter Property="SheenEnabled" Value="False" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    </Style>
    <!-- A top-bar or caption pill (0.10.1, free-form): each floats on its own over the desktop, so each is a piece of the
         window's shape under its button, and paints only A.B.PillFill: the dim its words need at 3:1 over whatever window
         is behind (none where the button's own fill is enough), or on the strict glass the dialogs' denser wash, at 4.5:1.
         The rim, the fill and the top light are the button's own, as the demo's .gbtn: the pane draws none, so nothing
         doubles. The window's shape ends at its edge, so a shadow could never show: none is drawn. -->
    <Style x:Key="A.TopPill" TargetType="aero:GlassPanel" BasedOn="{StaticResource {x:Type aero:GlassPanel}}">
        <Setter Property="Background" Value="{DynamicResource A.B.PillFill}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HasRim" Value="False" />
        <Setter Property="SheenEnabled" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static aero:Capsule.Instance}}" />
    </Style>
    <!-- The resize grip: a small glass disc off the stage's bottom-right corner, in the smaller layout only. -->
    <Style x:Key="A.Grip" TargetType="aero:GlassPanel" BasedOn="{StaticResource A.TopPill}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,3,3" />
        <Setter Property="ToolTip" Value="Resize" />
    </Style>

    <!-- A well: the quieter surface inside a pane, with its light top edge. The demo draws that edge as an inset shadow
         over the well's fill, inside the padding; here it is a border, which the fill doesn't reach under, so its brush is
         the fill, the ring and the top light as one (A.B.WellLit), and the top padding is a pixel less. -->
    <Style x:Key="A.Well" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.Well}" />
        <Setter Property="Background" Value="{DynamicResource A.B.Well}" />
        <Setter Property="BorderBrush" Value="{DynamicResource A.B.WellLit}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,13,16,14" />
    </Style>

    <!-- ============ menus ============ -->
    <!-- A menu: a dark glass card as the demo's .menu, a 1 px edge at 16 % and inside it a light top line at 25 %, springing
         out of what it hangs from (opacity and scale .9 to 1, a 6 px drop); under reduced motion only the fade is left. -->
    <Style x:Key="A.Menu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid x:Name="Root" Margin="14" RenderTransformOrigin="1,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Scale" />
                                <TranslateTransform x:Name="Drop" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border CornerRadius="{DynamicResource A.R.Menu}" Background="{DynamicResource A.B.MenuFill}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.35" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="{DynamicResource A.R.Menu}" BorderBrush="{DynamicResource A.B.MenuEdge}" BorderThickness="1" />
                        <Border CornerRadius="{DynamicResource A.R.Menu}" Margin="1" BorderBrush="{DynamicResource A.B.BtnTop}" BorderThickness="0,1,0,0" />
                        <StackPanel Margin="6" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ContextMenu.Opened">
                            <BeginStoryboard>
                                <Storyboard>
                                    <aero:AeroAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Ms="380" Fade="True" EasingFunction="{x:Static aero:AeroMotion.Glide}" />
                                    <aero:AeroAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Ms="380" Fade="False" EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                    <aero:AeroAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Ms="380" Fade="False" EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                    <aero:AeroAnimation Storyboard.TargetName="Drop" Storyboard.TargetProperty="Y" From="-6" To="0" Ms="380" Fade="False" EasingFunction="{x:Static aero:AeroMotion.Spring}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- A menu's item: .mi, a rounded row that lights under the pointer; the accent tick before a chosen one; its
         gesture or figure (.mi em) quieter at the right. -->
    <Style x:Key="A.MenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="{DynamicResource A.R.MenuItem}" Padding="12,10">
                        <DockPanel>
                            <aero:Icon x:Name="Check" DockPanel.Dock="Left" Data="{StaticResource A.I.Check}" Size="14" StrokeWidth="2.4" Margin="0,0,10,0"
                                       Foreground="{DynamicResource A.B.Accent}" Visibility="Collapsed" />
                            <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Text="{TemplateBinding InputGestureText}" FontSize="{DynamicResource A.T.Small}"
                                       Foreground="{DynamicResource A.B.Text2}" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource A.B.MenuHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource A.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="12,6" Background="{DynamicResource A.B.WellTop}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ data ============ -->
    <!-- Where a figure came from (.src): a dot in the quality's colour and the word, quiet. -->
    <ControlTemplate x:Key="A.Chip.Face" TargetType="ContentControl">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <Ellipse Width="9" Height="9" Fill="{TemplateBinding Background}" VerticalAlignment="Center" />
            <TextBlock Margin="7,0,0,0" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>
    <Style x:Key="A.Chip.Measured" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Content" Value="Measured" />
        <Setter Property="Background" Value="{DynamicResource A.B.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Text2}" />
        <Setter Property="Template" Value="{StaticResource A.Chip.Face}" />
    </Style>
    <Style x:Key="A.Chip.Calibrated" TargetType="ContentControl" BasedOn="{StaticResource A.Chip.Measured}">
        <Setter Property="Content" Value="Calibrated" />
        <Setter Property="Background" Value="{DynamicResource A.B.Violet}" />
    </Style>
    <Style x:Key="A.Chip.Estimated" TargetType="ContentControl" BasedOn="{StaticResource A.Chip.Measured}">
        <Setter Property="Content" Value="Estimated" />
        <Setter Property="Background" Value="{DynamicResource A.B.Muted}" />
    </Style>

    <!-- The history table (the HTML's table): quiet column heads, rows that light as a well under the pointer. -->
    <Style x:Key="A.Table.Header" TargetType="Border">
        <Setter Property="Padding" Value="14,0,14,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource A.B.Text3}" />
    </Style>
    <Style x:Key="A.Table.Row" TargetType="Border">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="CornerRadius" Value="{DynamicResource A.R.MenuItem}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource A.B.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource A.B.Well}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ implicit, scoped to the window this dictionary is merged into ============ -->
    <Style TargetType="TextBox" BasedOn="{StaticResource A.Field}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource A.Tick}" />
    <Style TargetType="ContextMenu" BasedOn="{StaticResource A.Menu}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource A.MenuItem}" />

    <!-- Thin scroll bars: a glass thumb, no arrows, 8 px. -->
    <Style x:Key="A.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="4" Background="{DynamicResource A.B.Well3}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="A.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,4">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource A.ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="4,1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource A.ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource A.ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tooltips: the HTML's chart tip, a pill-white bubble with the ink's words, fading in; no glass. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource A.B.Pill}" />
        <Setter Property="Foreground" Value="{DynamicResource A.B.Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource A.F.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Small}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid x:Name="Root" Margin="8" Opacity="0">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource A.R.Button}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.25" Color="{DynamicResource A.C.Shadow}" RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <aero:AeroAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Ms="200" EasingFunction="{x:Static aero:AeroMotion.Glide}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource A.T.Control}" />
        <Setter Property="Effect">
            <Setter.Value>

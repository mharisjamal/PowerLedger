<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Aero, light (Aero look design §3): the dark palette's design for a light backdrop, since the prototype is dark
         only. First every key Classic's and Midnight's palettes define, in glass colours: a pale ground, white glass, ink
         text, and the lime deepened to an olive that stands off white glass at 3:1 with a near black ink on it. The rim is
         a dark hairline with a white inner light, as light glass reads. Then Aero's own tokens, under A., from the approved HTML through the prototype's Tokens.xaml. ContrastTests
         holds all of it to WCAG AA: text on the glass over the darkest and the brightest backdrop the look allows
         (A.C.BackdropDarkest and A.C.BackdropBrightest, which WallpaperFrost and the see-through wash keep it within) at
         4.5:1, the accent, the rim and the focus ring at 3:1. -->
    <SolidColorBrush x:Key="Brush.Ground" Color="#EEF0F3" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Brush.Line" Color="#E0E2E7" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#8A8D96" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#16181C" />
    <SolidColorBrush x:Key="Brush.Ink2" Color="#4E525B" />
    <SolidColorBrush x:Key="Brush.Ink3" Color="#60646D" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#768C0B" />
    <SolidColorBrush x:Key="Brush.AmberSoft" Color="#29768C0B" />
    <SolidColorBrush x:Key="Brush.OnAmber" Color="#0F1402" />
    <SolidColorBrush x:Key="Brush.Measured" Color="#4F6400" />
    <SolidColorBrush x:Key="Brush.Calibrated" Color="#7A5A08" />
    <SolidColorBrush x:Key="Brush.Estimated" Color="#0E5A85" />
    <SolidColorBrush x:Key="Brush.PartCpu" Color="#768C0B" />
    <SolidColorBrush x:Key="Brush.PartGpu" Color="#2F7552" />
    <SolidColorBrush x:Key="Brush.PartDisplay" Color="#7466D8" />
    <SolidColorBrush x:Key="Brush.PartRest" Color="#4E93B5" />

    <!-- Midnight's own keys, in Aero's colours. -->
    <SolidColorBrush x:Key="M.Ground" Color="#EEF0F3" />
    <SolidColorBrush x:Key="M.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.Raised" Color="#F5F6F8" />
    <SolidColorBrush x:Key="M.Line" Color="#E0E2E7" />
    <SolidColorBrush x:Key="M.LineStrong" Color="#8A8D96" />
    <SolidColorBrush x:Key="M.Ink" Color="#16181C" />
    <SolidColorBrush x:Key="M.Ink2" Color="#4E525B" />
    <SolidColorBrush x:Key="M.Ink3" Color="#60646D" />
    <SolidColorBrush x:Key="M.Accent" Color="#768C0B" />
    <SolidColorBrush x:Key="M.AccentSoft" Color="#29768C0B" />
    <SolidColorBrush x:Key="M.OnAccent" Color="#0F1402" />
    <SolidColorBrush x:Key="M.AccentText" Color="#4F6400" />
    <!-- The violet the demo pairs with the lime (the second PC), deepened: never alone and never text. -->
    <SolidColorBrush x:Key="M.Accent2" Color="#5B4CC4" />
    <SolidColorBrush x:Key="M.Good" Color="#147F57" />
    <SolidColorBrush x:Key="M.Bad" Color="#CC3B3B" />
    <SolidColorBrush x:Key="M.Warn" Color="#A86F00" />
    <!-- The demo's pie: the deepened accent, the green, the violet and the blue. GlassMaterial moves PartCpu with the accent. -->
    <SolidColorBrush x:Key="M.PartCpu" Color="#768C0B" />
    <SolidColorBrush x:Key="M.PartGpu" Color="#2F7552" />
    <SolidColorBrush x:Key="M.PartDisplay" Color="#7466D8" />
    <SolidColorBrush x:Key="M.PartRest" Color="#4E93B5" />
    <!-- The quality chips: the ground, and the text on it. -->
    <SolidColorBrush x:Key="M.ChipMeasured" Color="#EEF4D2" />
    <SolidColorBrush x:Key="M.ChipMeasuredText" Color="#4F6400" />
    <SolidColorBrush x:Key="M.ChipCalibrated" Color="#FBF1CF" />
    <SolidColorBrush x:Key="M.ChipCalibratedText" Color="#7A5A08" />
    <SolidColorBrush x:Key="M.ChipEstimated" Color="#DDEFFA" />
    <SolidColorBrush x:Key="M.ChipEstimatedText" Color="#0E5A85" />
    <!-- Tooltips: a dark bubble with white words over the light page. -->
    <SolidColorBrush x:Key="M.Tip" Color="#16181C" />
    <SolidColorBrush x:Key="M.TipText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.TipMuted" Color="#A9ACB5" />
    <SolidColorBrush x:Key="M.Shadow" Color="#29000000" />
    <SolidColorBrush x:Key="M.Hatch" Color="#1A16181C" />
    <!-- The charts in the deepened lime. -->
    <SolidColorBrush x:Key="M.ChartLine" Color="#768C0B" />
    <SolidColorBrush x:Key="M.BarTop" Color="#768C0B" />
    <SolidColorBrush x:Key="M.BarBottom" Color="#586908" />
    <SolidColorBrush x:Key="M.ChartFillTop" Color="#40768C0B" />
    <SolidColorBrush x:Key="M.ChartFillBottom" Color="#00768C0B" />
    <SolidColorBrush x:Key="M.Focus" Color="#768C0B" />

    <!-- Aero's own tokens. -->

    <!-- Ink: the ink at 100, 75 and 64 %, the steps that read at 4.5:1 on white glass over the darkest light backdrop.
         Where each may sit (ContrastTests): the ink anywhere; Text2 on the glass, the quiet wells, menus and dialogs;
         Text3 on the glass and the chart well only. -->
    <Color x:Key="A.C.Text">#16181C</Color>
    <Color x:Key="A.C.Text2">#BF16181C</Color>
    <Color x:Key="A.C.Text3">#A316181C</Color>
    <Color x:Key="A.C.Ink">#16181C</Color>
    <Color x:Key="A.C.Accent">#768C0B</Color>
    <Color x:Key="A.C.AccentInk">#0F1402</Color>
    <Color x:Key="A.C.Pill">#FFFFFF</Color>
    <Color x:Key="A.C.Violet">#7466D8</Color>
    <Color x:Key="A.C.Green">#2F7552</Color>
    <Color x:Key="A.C.Blue">#3F82A3</Color>
    <Color x:Key="A.C.MarkerFill">#FFFFFF</Color>

    <!-- The accents the Glass settings offer (the demo's tuner), each with an ink that reads on it at 4.5:1. -->
    <Color x:Key="A.C.Accent.Lime">#768C0B</Color>
    <Color x:Key="A.C.AccentInk.Lime">#0F1402</Color>
    <Color x:Key="A.C.Accent.Ice">#0089CF</Color>
    <Color x:Key="A.C.AccentInk.Ice">#001A2B</Color>
    <Color x:Key="A.C.Accent.Indigo">#4F5BD5</Color>
    <Color x:Key="A.C.AccentInk.Indigo">#FFFFFF</Color>
    <Color x:Key="A.C.Accent.Amber">#B27800</Color>
    <Color x:Key="A.C.AccentInk.Amber">#1A1000</Color>
    <Color x:Key="A.C.Accent.Rose">#D11F5A</Color>
    <Color x:Key="A.C.AccentInk.Rose">#FFFFFF</Color>

    <!-- The backdrop the glass is designed over: the darkest and the brightest a pane may sit on. WallpaperFrost holds the
         frosted wallpaper above the darkest; see-through, the system backdrop's light acrylic and the wash hold the
         desktop there. The ground a plain backdrop paints. -->
    <Color x:Key="A.C.BackdropDarkest">#D0D0D0</Color>
    <Color x:Key="A.C.BackdropBrightest">#FFFFFF</Color>
    <Color x:Key="A.C.SeeThroughWash">#33FFFFFF</Color>
    <Color x:Key="A.C.Plain">#E9EBEF</Color>

    <!-- Glass: white at 55 % over a light backdrop, a dark hairline rim and a white inner light -->
    <Color x:Key="A.C.GlassTintTop">#8CFFFFFF</Color>
    <Color x:Key="A.C.GlassTintBottom">#99F4F5F8</Color>
    <Color x:Key="A.C.RimA">#80101216</Color>
    <Color x:Key="A.C.RimB">#33101216</Color>
    <Color x:Key="A.C.RimC">#26101216</Color>
    <Color x:Key="A.C.RimD">#59101216</Color>
    <Color x:Key="A.C.RimInner">#B3FFFFFF</Color>
    <Color x:Key="A.C.RimDark">#0A000000</Color>
    <Color x:Key="A.C.TopSheen">#99FFFFFF</Color>
    <Color x:Key="A.C.PointerSheen">#40FFFFFF</Color>
    <Color x:Key="A.C.Shadow">#000000</Color>
    <sys:Double x:Key="A.Glass.ShadowFarBlur">60</sys:Double>
    <sys:Double x:Key="A.Glass.ShadowFarDepth">30</sys:Double>
    <sys:Double x:Key="A.Glass.ShadowFarOpacity">0.16</sys:Double>
    <sys:Double x:Key="A.Glass.ShadowNearBlur">16</sys:Double>
    <sys:Double x:Key="A.Glass.ShadowNearDepth">6</sys:Double>
    <sys:Double x:Key="A.Glass.ShadowNearOpacity">0.1</sys:Double>
    <sys:Double x:Key="A.Glass.Frost">26</sys:Double>
    <sys:Double x:Key="A.Glass.Saturate">1.55</sys:Double>
    <sys:Double x:Key="A.Glass.SheenRadius">420</sys:Double>
    <sys:Double x:Key="A.Glass.DimmedOpacity">0.22</sys:Double>

    <!-- Wells and lines -->
    <Color x:Key="A.C.Well">#0F000000</Color>
    <Color x:Key="A.C.Well2">#17000000</Color>
    <Color x:Key="A.C.Well3">#21000000</Color>
    <Color x:Key="A.C.WellHover">#14000000</Color>
    <Color x:Key="A.C.WellEdge">#0D000000</Color>
    <Color x:Key="A.C.WellTop">#99FFFFFF</Color>
    <Color x:Key="A.C.Line">#38000000</Color>
    <Color x:Key="A.C.ChartWell">#0A000000</Color>
    <Color x:Key="A.C.ChartWellTop">#80FFFFFF</Color>
    <Color x:Key="A.C.Grid">#12000000</Color>
    <Color x:Key="A.C.Track">#1A000000</Color>
    <Color x:Key="A.C.TrackSoft">#12000000</Color>
    <Color x:Key="A.C.Muted">#66000000</Color>
    <Color x:Key="A.C.Ghost">#29000000</Color>
    <Color x:Key="A.C.PrevLine">#40000000</Color>
    <Color x:Key="A.C.Guide">#47000000</Color>
    <Color x:Key="A.C.GuideStrong">#59000000</Color>

    <!-- Controls -->
    <Color x:Key="A.C.BtnFill">#73FFFFFF</Color>
    <Color x:Key="A.C.BtnFillHover">#A6FFFFFF</Color>
    <Color x:Key="A.C.BtnEdge">#1F000000</Color>
    <Color x:Key="A.C.BtnTop">#CCFFFFFF</Color>
    <Color x:Key="A.C.OutlineHover">#0D000000</Color>
    <Color x:Key="A.C.AccentTop">#59FFFFFF</Color>
    <Color x:Key="A.C.AccentHover">#14FFFFFF</Color>
    <Color x:Key="A.C.WhiteRound">#FFFFFFFF</Color>
    <Color x:Key="A.C.WhiteRoundHover">#FFF2F3F5</Color>
    <Color x:Key="A.C.WhiteRoundInk">#4A4D55</Color>
    <Color x:Key="A.C.NavFillA">#33FFFFFF</Color>
    <Color x:Key="A.C.NavFillB">#59FFFFFF</Color>
    <Color x:Key="A.C.NavHover">#0F000000</Color>
    <Color x:Key="A.C.NavIcon">#14000000</Color>
    <Color x:Key="A.C.NavIndicator">#80FFFFFF</Color>
    <Color x:Key="A.C.NavIndicatorTop">#FFFFFFFF</Color>
    <Color x:Key="A.C.SwitchOff">#29000000</Color>
    <Color x:Key="A.C.MenuFill">#E6F7F7F9</Color>
    <Color x:Key="A.C.MenuEdge">#1F000000</Color>
    <Color x:Key="A.C.MenuHover">#0F000000</Color>
    <Color x:Key="A.C.ModalTop">#EBFBFBFC</Color>
    <Color x:Key="A.C.ModalBottom">#E0F2F3F6</Color>
    <Color x:Key="A.C.Scrim">#33000000</Color>
    <Color x:Key="A.C.TimePill">#1F000000</Color>

    <SolidColorBrush x:Key="A.B.Text" Color="{StaticResource A.C.Text}" />
    <SolidColorBrush x:Key="A.B.Text2" Color="{StaticResource A.C.Text2}" />
    <SolidColorBrush x:Key="A.B.Text3" Color="{StaticResource A.C.Text3}" />
    <SolidColorBrush x:Key="A.B.Ink" Color="{StaticResource A.C.Ink}" />
    <SolidColorBrush x:Key="A.B.Accent" Color="{StaticResource A.C.Accent}" />
    <SolidColorBrush x:Key="A.B.AccentInk" Color="{StaticResource A.C.AccentInk}" />
    <SolidColorBrush x:Key="A.B.Pill" Color="{StaticResource A.C.Pill}" />
    <SolidColorBrush x:Key="A.B.Violet" Color="{StaticResource A.C.Violet}" />
    <SolidColorBrush x:Key="A.B.Well" Color="{StaticResource A.C.Well}" />
    <SolidColorBrush x:Key="A.B.Well2" Color="{StaticResource A.C.Well2}" />
    <SolidColorBrush x:Key="A.B.Well3" Color="{StaticResource A.C.Well3}" />
    <SolidColorBrush x:Key="A.B.WellHover" Color="{StaticResource A.C.WellHover}" />
    <SolidColorBrush x:Key="A.B.WellEdge" Color="{StaticResource A.C.WellEdge}" />
    <SolidColorBrush x:Key="A.B.WellTop" Color="{StaticResource A.C.WellTop}" />
    <SolidColorBrush x:Key="A.B.Line" Color="{StaticResource A.C.Line}" />
    <SolidColorBrush x:Key="A.B.ChartWell" Color="{StaticResource A.C.ChartWell}" />
    <SolidColorBrush x:Key="A.B.ChartWellTop" Color="{StaticResource A.C.ChartWellTop}" />
    <SolidColorBrush x:Key="A.B.Track" Color="{StaticResource A.C.Track}" />
    <SolidColorBrush x:Key="A.B.TrackSoft" Color="{StaticResource A.C.TrackSoft}" />
    <SolidColorBrush x:Key="A.B.Muted" Color="{StaticResource A.C.Muted}" />
    <SolidColorBrush x:Key="A.B.BtnFill" Color="{StaticResource A.C.BtnFill}" />
    <SolidColorBrush x:Key="A.B.BtnFillHover" Color="{StaticResource A.C.BtnFillHover}" />
    <SolidColorBrush x:Key="A.B.BtnEdge" Color="{StaticResource A.C.BtnEdge}" />
    <SolidColorBrush x:Key="A.B.BtnTop" Color="{StaticResource A.C.BtnTop}" />
    <SolidColorBrush x:Key="A.B.OutlineHover" Color="{StaticResource A.C.OutlineHover}" />
    <SolidColorBrush x:Key="A.B.AccentTop" Color="{StaticResource A.C.AccentTop}" />
    <SolidColorBrush x:Key="A.B.AccentHover" Color="{StaticResource A.C.AccentHover}" />
    <SolidColorBrush x:Key="A.B.WhiteRound" Color="{StaticResource A.C.WhiteRound}" />
    <SolidColorBrush x:Key="A.B.WhiteRoundHover" Color="{StaticResource A.C.WhiteRoundHover}" />
    <SolidColorBrush x:Key="A.B.WhiteRoundInk" Color="{StaticResource A.C.WhiteRoundInk}" />
    <SolidColorBrush x:Key="A.B.NavHover" Color="{StaticResource A.C.NavHover}" />
    <SolidColorBrush x:Key="A.B.NavIcon" Color="{StaticResource A.C.NavIcon}" />
    <SolidColorBrush x:Key="A.B.NavIndicator" Color="{StaticResource A.C.NavIndicator}" />
    <SolidColorBrush x:Key="A.B.NavIndicatorTop" Color="{StaticResource A.C.NavIndicatorTop}" />
    <SolidColorBrush x:Key="A.B.SwitchOff" Color="{StaticResource A.C.SwitchOff}" />
    <SolidColorBrush x:Key="A.B.MenuFill" Color="{StaticResource A.C.MenuFill}" />
    <SolidColorBrush x:Key="A.B.MenuEdge" Color="{StaticResource A.C.MenuEdge}" />
    <SolidColorBrush x:Key="A.B.MenuHover" Color="{StaticResource A.C.MenuHover}" />
    <SolidColorBrush x:Key="A.B.Scrim" Color="{StaticResource A.C.Scrim}" />
    <SolidColorBrush x:Key="A.B.RimInner" Color="{StaticResource A.C.RimInner}" />
    <SolidColorBrush x:Key="A.B.RimDark" Color="{StaticResource A.C.RimDark}" />
    <SolidColorBrush x:Key="A.B.White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="A.B.Plain" Color="{StaticResource A.C.Plain}" />
    <SolidColorBrush x:Key="A.B.SeeThroughWash" Color="{StaticResource A.C.SeeThroughWash}" />

    <LinearGradientBrush x:Key="A.B.GlassTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource A.C.GlassTintTop}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.GlassTintBottom}" />
    </LinearGradientBrush>
    <!-- The rim: a crisp light edge, brightest top left and bottom right, as the HTML's 140 degree gradient. -->
    <LinearGradientBrush x:Key="A.B.Rim" StartPoint="0.18,0" EndPoint="0.82,1">
        <GradientStop Offset="0" Color="{StaticResource A.C.RimA}" />
        <GradientStop Offset="0.3" Color="{StaticResource A.C.RimB}" />
        <GradientStop Offset="0.65" Color="{StaticResource A.C.RimC}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.RimD}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="A.B.TopSheen" StartPoint="0,0" EndPoint="0,22" MappingMode="Absolute">
        <GradientStop Offset="0" Color="{StaticResource A.C.TopSheen}" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="A.B.NavFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource A.C.NavFillA}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.NavFillB}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="A.B.ModalFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource A.C.ModalTop}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.ModalBottom}" />
    </LinearGradientBrush>

    <!-- Radii -->
    <CornerRadius x:Key="A.R.Panel">26</CornerRadius>
    <CornerRadius x:Key="A.R.Well">20</CornerRadius>
    <CornerRadius x:Key="A.R.Pill">999</CornerRadius>
    <CornerRadius x:Key="A.R.Search">16</CornerRadius>
    <CornerRadius x:Key="A.R.Button">10</CornerRadius>
    <CornerRadius x:Key="A.R.Menu">18</CornerRadius>
    <CornerRadius x:Key="A.R.MenuItem">12</CornerRadius>
    <CornerRadius x:Key="A.R.Modal">28</CornerRadius>
    <CornerRadius x:Key="A.R.Icon">9</CornerRadius>
    <sys:Double x:Key="A.Radius.Panel">26</sys:Double>

    <!-- Type -->
    <!-- Geist, the demo's face, bundled (Fonts/Geist, SIL OFL); Segoe UI Variable where a glyph is missing. -->
    <FontFamily x:Key="A.F.Ui">pack://application:,,,/PowerLedger;component/Fonts/Geist/#Geist, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="A.T.Big">40</sys:Double>
    <sys:Double x:Key="A.T.BigMonth">34</sys:Double>
    <sys:Double x:Key="A.T.Mid">22</sys:Double>
    <sys:Double x:Key="A.T.Title">16</sys:Double>
    <sys:Double x:Key="A.T.Brand">18</sys:Double>
    <sys:Double x:Key="A.T.Body">14</sys:Double>
    <sys:Double x:Key="A.T.Control">13.5</sys:Double>
    <sys:Double x:Key="A.T.Label">13</sys:Double>
    <sys:Double x:Key="A.T.Small">12.5</sys:Double>
    <sys:Double x:Key="A.T.Tiny">12</sys:Double>
    <sys:Double x:Key="A.T.Axis">11</sys:Double>
    <sys:Double x:Key="A.T.Modal">20</sys:Double>
    <sys:Double x:Key="A.T.BigLine">42</sys:Double>

    <!-- G1's additions for the style contract: the soft focus ring's radius, the toast's capsule, a disabled control's
         opacity, and the brush a glass pane's shadow is cast from. -->
    <CornerRadius x:Key="A.R.Focus">14</CornerRadius>
    <CornerRadius x:Key="A.R.Toast">22</CornerRadius>
    <sys:Double x:Key="A.Opacity.Disabled">0.5</sys:Double>
    <SolidColorBrush x:Key="A.B.Shadow" Color="{StaticResource A.C.Shadow}" />
</ResourceDictionary>

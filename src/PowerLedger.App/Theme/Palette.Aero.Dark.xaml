<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Aero, dark (Aero look design §3). First every key Classic's and Midnight's palettes define, in glass colours, so
         the shared dialogs, the wizard, the update card and any view that reads a Midnight key take Aero's look: the
         ground is the demo's deep backdrop tone, panels the dark glass as it reads over it, the accent the lime with its
         ink. Then Aero's own tokens, under A., from the approved HTML through the prototype's Tokens.xaml. ContrastTests
         holds the strict glass (Increase contrast, Reduce transparency) to WCAG AA: text on the glass over the darkest and
         the brightest backdrop the look allows (A.C.BackdropDarkest and A.C.BackdropBrightest, which WallpaperFrost and the
         see-through wash keep it within) at 4.5:1, the accent, the rim and the focus ring at 3:1. The default glass is
         brighter by the owner's choice (0.10.1): text at 3:1 over A.C.FrostDarkest and A.C.FrostBrightest with the halo. -->
    <SolidColorBrush x:Key="Brush.Ground" Color="#0E0F12" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#1A1C21" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#24262C" />
    <SolidColorBrush x:Key="Brush.Line" Color="#34363D" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#6E7079" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Brush.Ink2" Color="#B8BABF" />
    <SolidColorBrush x:Key="Brush.Ink3" Color="#9A9CA2" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#D3F03F" />
    <SolidColorBrush x:Key="Brush.AmberSoft" Color="#33D3F03F" />
    <SolidColorBrush x:Key="Brush.OnAmber" Color="#1B2004" />
    <SolidColorBrush x:Key="Brush.Measured" Color="#D3F03F" />
    <SolidColorBrush x:Key="Brush.Calibrated" Color="#F1D57A" />
    <SolidColorBrush x:Key="Brush.Estimated" Color="#7FD4FF" />
    <SolidColorBrush x:Key="Brush.PartCpu" Color="#D3F03F" />
    <SolidColorBrush x:Key="Brush.PartGpu" Color="#2F7552" />
    <SolidColorBrush x:Key="Brush.PartDisplay" Color="#7466D8" />
    <SolidColorBrush x:Key="Brush.PartRest" Color="#4E93B5" />

    <!-- Midnight's own keys, in Aero's colours. -->
    <SolidColorBrush x:Key="M.Ground" Color="#0E0F12" />
    <SolidColorBrush x:Key="M.Panel" Color="#1A1C21" />
    <SolidColorBrush x:Key="M.Raised" Color="#24262C" />
    <SolidColorBrush x:Key="M.Line" Color="#34363D" />
    <SolidColorBrush x:Key="M.LineStrong" Color="#6E7079" />
    <SolidColorBrush x:Key="M.Ink" Color="#F3F4F6" />
    <SolidColorBrush x:Key="M.Ink2" Color="#B8BABF" />
    <SolidColorBrush x:Key="M.Ink3" Color="#9A9CA2" />
    <SolidColorBrush x:Key="M.Accent" Color="#D3F03F" />
    <SolidColorBrush x:Key="M.AccentSoft" Color="#33D3F03F" />
    <SolidColorBrush x:Key="M.OnAccent" Color="#1B2004" />
    <SolidColorBrush x:Key="M.AccentText" Color="#D3F03F" />
    <!-- The violet the demo pairs with the lime (the second PC): never alone and never text. -->
    <SolidColorBrush x:Key="M.Accent2" Color="#7466D8" />
    <SolidColorBrush x:Key="M.Good" Color="#34D399" />
    <SolidColorBrush x:Key="M.Bad" Color="#F87171" />
    <SolidColorBrush x:Key="M.Warn" Color="#F5B942" />
    <!-- The demo's pie, exactly: the accent, the green, the violet and the blue. GlassMaterial moves PartCpu with the accent. -->
    <SolidColorBrush x:Key="M.PartCpu" Color="#D3F03F" />
    <SolidColorBrush x:Key="M.PartGpu" Color="#2F7552" />
    <SolidColorBrush x:Key="M.PartDisplay" Color="#7466D8" />
    <SolidColorBrush x:Key="M.PartRest" Color="#4E93B5" />
    <!-- The quality chips: the ground, and the text on it. -->
    <SolidColorBrush x:Key="M.ChipMeasured" Color="#2A3310" />
    <SolidColorBrush x:Key="M.ChipMeasuredText" Color="#D3F03F" />
    <SolidColorBrush x:Key="M.ChipCalibrated" Color="#3A3418" />
    <SolidColorBrush x:Key="M.ChipCalibratedText" Color="#F1D57A" />
    <SolidColorBrush x:Key="M.ChipEstimated" Color="#13303F" />
    <SolidColorBrush x:Key="M.ChipEstimatedText" Color="#7FD4FF" />
    <!-- Tooltips: the demo's chart tip, the pill white with the ink's words. -->
    <SolidColorBrush x:Key="M.Tip" Color="#F4F4F0" />
    <SolidColorBrush x:Key="M.TipText" Color="#16181C" />
    <SolidColorBrush x:Key="M.TipMuted" Color="#5A5D66" />
    <SolidColorBrush x:Key="M.Shadow" Color="#73000000" />
    <SolidColorBrush x:Key="M.Hatch" Color="#1AFFFFFF" />
    <!-- The charts in the lime, as the demo's line and bars. -->
    <SolidColorBrush x:Key="M.ChartLine" Color="#D3F03F" />
    <SolidColorBrush x:Key="M.BarTop" Color="#D3F03F" />
    <SolidColorBrush x:Key="M.BarBottom" Color="#9EB42F" />
    <SolidColorBrush x:Key="M.ChartFillTop" Color="#66D3F03F" />
    <SolidColorBrush x:Key="M.ChartFillBottom" Color="#00D3F03F" />
    <SolidColorBrush x:Key="M.Focus" Color="#D3F03F" />

    <!-- Aero's own tokens. -->

    <!-- Ink: the demo's #F3F4F6 at 100 %, then 78 and 60 % where the demo has 70 and 44 %, which read under WCAG AA's
         4.5:1 over the brighter backdrops (44 % does even over black). Where each may sit (ContrastTests): the ink
         anywhere; Text2 on the glass, the quiet wells, menus and dialogs; Text3 on the glass and the chart well only. -->
    <Color x:Key="A.C.Text">#F3F4F6</Color>
    <Color x:Key="A.C.Text2">#C7F3F4F6</Color>
    <Color x:Key="A.C.Text3">#99F3F4F6</Color>
    <Color x:Key="A.C.Ink">#16181C</Color>
    <Color x:Key="A.C.Accent">#D3F03F</Color>
    <Color x:Key="A.C.AccentInk">#1B2004</Color>
    <Color x:Key="A.C.Pill">#F4F4F0</Color>
    <Color x:Key="A.C.Violet">#7466D8</Color>
    <Color x:Key="A.C.Green">#2F7552</Color>
    <Color x:Key="A.C.Blue">#4E93B5</Color>
    <Color x:Key="A.C.MarkerFill">#1B1D20</Color>

    <!-- The accents the Glass settings offer (the demo's tuner), each with an ink that reads on it at 4.5:1. -->
    <Color x:Key="A.C.Accent.Lime">#D3F03F</Color>
    <Color x:Key="A.C.AccentInk.Lime">#1B2004</Color>
    <Color x:Key="A.C.Accent.Ice">#7FD4FF</Color>
    <Color x:Key="A.C.AccentInk.Ice">#04202E</Color>
    <Color x:Key="A.C.Accent.Indigo">#9AA2FF</Color>
    <Color x:Key="A.C.AccentInk.Indigo">#0F1440</Color>
    <Color x:Key="A.C.Accent.Amber">#FFC857</Color>
    <Color x:Key="A.C.AccentInk.Amber">#2E1F00</Color>
    <Color x:Key="A.C.Accent.Rose">#FF8FB1</Color>
    <Color x:Key="A.C.AccentInk.Rose">#3A0A1A</Color>

    <!-- The backdrop the glass is designed over: the darkest and the brightest a pane may sit on. WallpaperFrost holds the
         frosted wallpaper under the brightest; see-through, the system backdrop's dark acrylic and the wash hold the
         desktop there. The ground a plain backdrop paints. -->
    <Color x:Key="A.C.BackdropDarkest">#000000</Color>
    <Color x:Key="A.C.BackdropBrightest">#222222</Color>
    <Color x:Key="A.C.SeeThroughWash">#40000000</Color>
    <Color x:Key="A.C.Plain">#101114</Color>
    <!-- The bright glass (0.10.1, the owner's choice, as the demo): how far the frost may let the desktop through
         before the glass holds it, and the halo behind the glass's content that keeps text at 3:1 there (counted as its
         colour at A.Glass.HaloShare). Increase contrast and Reduce transparency keep the backdrop bounds above, no halo,
         and 4.5:1. The floor (Plan V): a black corner of the desktop still frosts to lit glass, so the sidebar over it
         reads as the panes' glass does, as the demo's, rather than a near-black slab. -->
    <Color x:Key="A.C.FrostDarkest">#383838</Color>
    <Color x:Key="A.C.FrostBrightest">#A0A0A0</Color>
    <!-- Aero bloom's grounds (0.10.3): the frosted bloom's darkest and brightest under the stage, as the video's glass
         shows it (AeroBloom; measured from Windows' img19 through the frost). -->
    <Color x:Key="A.C.BloomDarkest">#000117</Color>
    <Color x:Key="A.C.BloomBrightest">#00A4FF</Color>

    <!-- Liquid glass (0.10.9, the owner's recipe): no tint by default, both themes (the Dark and Colour styles and the
         strict glass lay theirs through GlassMaterial); the glowing edge's opacity, the recipe's white at 70 % at the default
         Edge light; whether the engine's live backdrop draws (off under Reduce transparency); the mockup's text shadow
         (.t: 0 1px 2px, navy at 28 %), laid by GlassMaterial on each piece's content; and the lime glass of an accent
         action (Open report, the mockup's rgba(217,242,90,.86)): the accent at 86 %. -->
    <Color x:Key="A.C.GlassTintTop">#00FFFFFF</Color>
    <Color x:Key="A.C.GlassTintBottom">#00FFFFFF</Color>
    <sys:Double x:Key="A.Glass.Glow">0.7</sys:Double>
    <sys:Boolean x:Key="A.Glass.Live">True</sys:Boolean>
    <Color x:Key="A.C.TextShadow">#47000A28</Color>
    <x:Null x:Key="A.Glass.TextShadow" />
    <Color x:Key="A.C.AccentGlass">#DBD3F03F</Color>
    <SolidColorBrush x:Key="A.B.AccentGlass" Color="{StaticResource A.C.AccentGlass}" />
    <!-- The mockup's other text steps: the sidebar's pages at 88 %, a segmented control's words at 85 %; the white wash a
         glass control takes under the pointer (the kit's .hov, 14 % over its glass); and the white glass pill of a chosen
         option (the Styles board's Style row). -->
    <Color x:Key="A.C.NavText">#E0F3F4F6</Color>
    <Color x:Key="A.C.SegText">#D9F3F4F6</Color>
    <Color x:Key="A.C.GlassHover">#24FFFFFF</Color>
    <SolidColorBrush x:Key="A.B.NavText" Color="{StaticResource A.C.NavText}" />
    <SolidColorBrush x:Key="A.B.SegText" Color="{StaticResource A.C.SegText}" />
    <SolidColorBrush x:Key="A.B.GlassHover" Color="{StaticResource A.C.GlassHover}" />
    <!-- The Styles board's knob (a switch's and a slider's): white shading to #E6E9F2 from its upper left; and the slider's
         light top line (inset 0 1px 0, white at 70 %). -->
    <RadialGradientBrush x:Key="A.B.Knob" GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#E6E9F2" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="A.B.SliderTop" Color="#B3FFFFFF" />
    <!-- The mockup's shadow navy, under a knob and a menu (rgba(0,5,30)). -->
    <Color x:Key="A.C.Navy">#00051E</Color>
    <!-- The hairline between the buttons of a glass group (the mockup's .sep, white at 22 %). -->
    <SolidColorBrush x:Key="A.B.GroupSep" Color="#38FFFFFF" />
    <LinearGradientBrush x:Key="A.B.PillGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#DFE4EE" />
    </LinearGradientBrush>
    <!-- A well, the mockup's .inset: navy at 14 %, a soft inner shade along its top (inset 0 1px 3px, navy at 28 %) and a
         hairline of light along its foot (inset 0 -.6px 0, white at 20 %), drawn as its fill and a one-pixel edge that
         runs from the shade at the top to the light at the foot. -->
    <Color x:Key="A.C.InsetFill">#24000A28</Color>
    <Color x:Key="A.C.InsetTop">#2E00051E</Color>
    <Color x:Key="A.C.InsetSide">#1A00051E</Color>
    <Color x:Key="A.C.InsetFoot">#1FFFFFFF</Color>
    <SolidColorBrush x:Key="A.B.InsetFill" Color="{StaticResource A.C.InsetFill}" />
    <LinearGradientBrush x:Key="A.B.InsetEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource A.C.InsetTop}" />
        <GradientStop Offset="0.12" Color="{StaticResource A.C.InsetSide}" />
        <GradientStop Offset="0.88" Color="{StaticResource A.C.InsetSide}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.InsetFoot}" />
    </LinearGradientBrush>
    <Color x:Key="A.C.Shadow">#000000</Color>
    <sys:Double x:Key="A.Glass.Frost">26</sys:Double>
    <sys:Double x:Key="A.Glass.Saturate">1.55</sys:Double>
    <sys:Double x:Key="A.Glass.DimmedOpacity">0.22</sys:Double>

    <!-- Wells and lines -->
    <Color x:Key="A.C.Well">#1AFFFFFF</Color>
    <Color x:Key="A.C.Well2">#26FFFFFF</Color>
    <Color x:Key="A.C.Well3">#38FFFFFF</Color>
    <Color x:Key="A.C.WellHover">#24FFFFFF</Color>
    <Color x:Key="A.C.WellEdge">#0DFFFFFF</Color>
    <Color x:Key="A.C.WellTop">#24FFFFFF</Color>
    <!-- A well's top border, which its fill doesn't reach under: the fill, the 1 px ring and the top light as one. -->
    <Color x:Key="A.C.WellLit">#43FFFFFF</Color>
    <!-- The quietest edge and top light (the demo's .nav a and .pair): a ring at 4 %, a top line at 12 %. -->
    <Color x:Key="A.C.SoftEdge">#0AFFFFFF</Color>
    <Color x:Key="A.C.SoftTop">#1FFFFFFF</Color>
    <Color x:Key="A.C.Line">#47FFFFFF</Color>
    <Color x:Key="A.C.ChartWell">#29000000</Color>
    <!-- The chart well's top border: its fill and its top light as one. -->
    <Color x:Key="A.C.ChartWellLit">#3A5A5A5A</Color>
    <Color x:Key="A.C.ChartWellTop">#14FFFFFF</Color>
    <Color x:Key="A.C.Grid">#0FFFFFFF</Color>
    <Color x:Key="A.C.Track">#1AFFFFFF</Color>
    <Color x:Key="A.C.TrackSoft">#14FFFFFF</Color>
    <Color x:Key="A.C.Muted">#66FFFFFF</Color>
    <Color x:Key="A.C.Ghost">#33FFFFFF</Color>
    <Color x:Key="A.C.PrevLine">#42FFFFFF</Color>
    <Color x:Key="A.C.Guide">#47FFFFFF</Color>
    <Color x:Key="A.C.GuideStrong">#59FFFFFF</Color>

    <!-- Controls -->
    <Color x:Key="A.C.BtnFill">#1FFFFFFF</Color>
    <Color x:Key="A.C.BtnFillHover">#2EFFFFFF</Color>
    <Color x:Key="A.C.BtnEdge">#38FFFFFF</Color>
    <Color x:Key="A.C.BtnTop">#40FFFFFF</Color>
    <Color x:Key="A.C.OutlineHover">#14FFFFFF</Color>
    <!-- The ghost button's top light (the demo's .btn.ghost, 18 %). -->
    <Color x:Key="A.C.GhostTop">#2EFFFFFF</Color>
    <Color x:Key="A.C.AccentTop">#80FFFFFF</Color>
    <Color x:Key="A.C.AccentHover">#12FFFFFF</Color>
    <Color x:Key="A.C.WhiteRound">#C7FFFFFF</Color>
    <Color x:Key="A.C.WhiteRoundHover">#E6FFFFFF</Color>
    <Color x:Key="A.C.WhiteRoundInk">#4A4D55</Color>
    <Color x:Key="A.C.NavFillA">#0EFFFFFF</Color>
    <Color x:Key="A.C.NavFillB">#1AFFFFFF</Color>
    <Color x:Key="A.C.NavHover">#1CFFFFFF</Color>
    <Color x:Key="A.C.NavIcon">#29FFFFFF</Color>
    <Color x:Key="A.C.NavIndicator">#1AFFFFFF</Color>
    <Color x:Key="A.C.NavIndicatorTop">#38FFFFFF</Color>
    <Color x:Key="A.C.SwitchOff">#24FFFFFF</Color>
    <Color x:Key="A.C.MenuFill">#B017181C</Color>
    <Color x:Key="A.C.MenuEdge">#29FFFFFF</Color>
    <Color x:Key="A.C.MenuHover">#1AFFFFFF</Color>
    <Color x:Key="A.C.ModalTop">#A0282A30</Color>
    <Color x:Key="A.C.ModalBottom">#961C1E22</Color>
    <Color x:Key="A.C.Scrim">#66000000</Color>
    <Color x:Key="A.C.TimePill">#40000000</Color>

    <SolidColorBrush x:Key="A.B.Text" Color="{StaticResource A.C.Text}" />
    <SolidColorBrush x:Key="A.B.Text2" Color="{StaticResource A.C.Text2}" />
    <SolidColorBrush x:Key="A.B.Text3" Color="{StaticResource A.C.Text3}" />
    <SolidColorBrush x:Key="A.B.Ink" Color="{StaticResource A.C.Ink}" />
    <SolidColorBrush x:Key="A.B.Accent" Color="{StaticResource A.C.Accent}" />
    <SolidColorBrush x:Key="A.B.AccentInk" Color="{StaticResource A.C.AccentInk}" />
    <SolidColorBrush x:Key="A.B.Pill" Color="{StaticResource A.C.Pill}" />
    <SolidColorBrush x:Key="A.B.Violet" Color="{StaticResource A.C.Violet}" />
    <SolidColorBrush x:Key="A.B.Well" Color="{StaticResource A.C.Well}" />
    <SolidColorBrush x:Key="A.B.Well2" Color="{StaticResource A.C.Well2}" />
    <SolidColorBrush x:Key="A.B.Well3" Color="{StaticResource A.C.Well3}" />
    <SolidColorBrush x:Key="A.B.WellHover" Color="{StaticResource A.C.WellHover}" />
    <SolidColorBrush x:Key="A.B.WellEdge" Color="{StaticResource A.C.WellEdge}" />
    <SolidColorBrush x:Key="A.B.WellTop" Color="{StaticResource A.C.WellTop}" />
    <SolidColorBrush x:Key="A.B.WellLit" Color="{StaticResource A.C.WellLit}" />
    <SolidColorBrush x:Key="A.B.SoftEdge" Color="{StaticResource A.C.SoftEdge}" />
    <SolidColorBrush x:Key="A.B.SoftTop" Color="{StaticResource A.C.SoftTop}" />
    <SolidColorBrush x:Key="A.B.ChartWellLit" Color="{StaticResource A.C.ChartWellLit}" />
    <SolidColorBrush x:Key="A.B.GhostTop" Color="{StaticResource A.C.GhostTop}" />
    <SolidColorBrush x:Key="A.B.Line" Color="{StaticResource A.C.Line}" />
    <SolidColorBrush x:Key="A.B.ChartWell" Color="{StaticResource A.C.ChartWell}" />
    <SolidColorBrush x:Key="A.B.ChartWellTop" Color="{StaticResource A.C.ChartWellTop}" />
    <SolidColorBrush x:Key="A.B.Track" Color="{StaticResource A.C.Track}" />
    <SolidColorBrush x:Key="A.B.TrackSoft" Color="{StaticResource A.C.TrackSoft}" />
    <SolidColorBrush x:Key="A.B.Muted" Color="{StaticResource A.C.Muted}" />
    <SolidColorBrush x:Key="A.B.BtnFill" Color="{StaticResource A.C.BtnFill}" />
    <SolidColorBrush x:Key="A.B.BtnFillHover" Color="{StaticResource A.C.BtnFillHover}" />
    <SolidColorBrush x:Key="A.B.BtnEdge" Color="{StaticResource A.C.BtnEdge}" />
    <SolidColorBrush x:Key="A.B.BtnTop" Color="{StaticResource A.C.BtnTop}" />
    <SolidColorBrush x:Key="A.B.OutlineHover" Color="{StaticResource A.C.OutlineHover}" />
    <SolidColorBrush x:Key="A.B.AccentTop" Color="{StaticResource A.C.AccentTop}" />
    <SolidColorBrush x:Key="A.B.AccentHover" Color="{StaticResource A.C.AccentHover}" />
    <SolidColorBrush x:Key="A.B.WhiteRound" Color="{StaticResource A.C.WhiteRound}" />
    <SolidColorBrush x:Key="A.B.WhiteRoundHover" Color="{StaticResource A.C.WhiteRoundHover}" />
    <SolidColorBrush x:Key="A.B.WhiteRoundInk" Color="{StaticResource A.C.WhiteRoundInk}" />
    <SolidColorBrush x:Key="A.B.NavHover" Color="{StaticResource A.C.NavHover}" />
    <SolidColorBrush x:Key="A.B.NavIcon" Color="{StaticResource A.C.NavIcon}" />
    <SolidColorBrush x:Key="A.B.NavIndicator" Color="{StaticResource A.C.NavIndicator}" />
    <SolidColorBrush x:Key="A.B.NavIndicatorTop" Color="{StaticResource A.C.NavIndicatorTop}" />
    <SolidColorBrush x:Key="A.B.SwitchOff" Color="{StaticResource A.C.SwitchOff}" />
    <SolidColorBrush x:Key="A.B.MenuFill" Color="{StaticResource A.C.MenuFill}" />
    <SolidColorBrush x:Key="A.B.MenuEdge" Color="{StaticResource A.C.MenuEdge}" />
    <SolidColorBrush x:Key="A.B.MenuHover" Color="{StaticResource A.C.MenuHover}" />
    <SolidColorBrush x:Key="A.B.Scrim" Color="{StaticResource A.C.Scrim}" />
    <SolidColorBrush x:Key="A.B.White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="A.B.Plain" Color="{StaticResource A.C.Plain}" />
    <SolidColorBrush x:Key="A.B.SeeThroughWash" Color="{StaticResource A.C.SeeThroughWash}" />

    <LinearGradientBrush x:Key="A.B.GlassTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource A.C.GlassTintTop}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.GlassTintBottom}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="A.B.NavFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="{StaticResource A.C.NavFillA}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.NavFillB}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="A.B.ModalFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource A.C.ModalTop}" />
        <GradientStop Offset="1" Color="{StaticResource A.C.ModalBottom}" />
    </LinearGradientBrush>

    <!-- Radii -->
    <CornerRadius x:Key="A.R.Panel">28</CornerRadius>
    <CornerRadius x:Key="A.R.Well">22</CornerRadius>
    <CornerRadius x:Key="A.R.Pill">999</CornerRadius>
    <CornerRadius x:Key="A.R.Search">16</CornerRadius>
    <CornerRadius x:Key="A.R.Button">10</CornerRadius>
    <CornerRadius x:Key="A.R.Menu">22</CornerRadius>
    <CornerRadius x:Key="A.R.MenuItem">12</CornerRadius>
    <CornerRadius x:Key="A.R.Modal">28</CornerRadius>
    <CornerRadius x:Key="A.R.Icon">9</CornerRadius>
    <sys:Double x:Key="A.Radius.Panel">28</sys:Double>

    <!-- Type -->
    <!-- Geist, the demo's face, bundled (Fonts/Geist, SIL OFL); Segoe UI Variable where a glyph is missing. -->
    <FontFamily x:Key="A.F.Ui">pack://application:,,,/PowerLedger;component/Fonts/Geist/#Geist, Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- The mockup's figures in Geist Mono; JetBrains Mono, bundled, stands in for it (Geist Mono is not bundled). -->
    <FontFamily x:Key="A.F.Mono">pack://application:,,,/PowerLedger;component/Fonts/JetBrainsMono/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="A.T.Big">40</sys:Double>
    <sys:Double x:Key="A.T.BigMonth">34</sys:Double>
    <sys:Double x:Key="A.T.Mid">22</sys:Double>
    <sys:Double x:Key="A.T.Title">16</sys:Double>
    <sys:Double x:Key="A.T.Nav">15</sys:Double>
    <sys:Double x:Key="A.T.Brand">18</sys:Double>
    <sys:Double x:Key="A.T.Body">14</sys:Double>
    <sys:Double x:Key="A.T.Control">13.5</sys:Double>
    <sys:Double x:Key="A.T.Label">13</sys:Double>
    <sys:Double x:Key="A.T.Small">12.5</sys:Double>
    <sys:Double x:Key="A.T.Tiny">12</sys:Double>
    <sys:Double x:Key="A.T.Axis">11</sys:Double>
    <sys:Double x:Key="A.T.Modal">20</sys:Double>
    <sys:Double x:Key="A.T.BigLine">42</sys:Double>
    <sys:Double x:Key="A.T.BigMonthLine">35.7</sys:Double>

    <!-- G1's additions for the style contract: the soft focus ring's radius, the toast's capsule, a disabled control's
         opacity, and the brush a glass pane's shadow is cast from. -->
    <CornerRadius x:Key="A.R.Focus">14</CornerRadius>
    <CornerRadius x:Key="A.R.Toast">22</CornerRadius>

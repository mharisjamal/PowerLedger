<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Midnight, light: the design's §3 tokens, laid out as the dark palette is. Ink3, LineStrong and Warn sit a little
         past the design's first figures, where the contrast tests (text 4.5:1, borders and marks 3:1 on white) put them;
         Good and Bad a little darker, since the trends are text. The CPU is teal, not the accent's blue, so its band
         stays apart from the accent's total line. -->
    <SolidColorBrush x:Key="Brush.Ground" Color="#F3F4FA" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#F7F8FD" />
    <SolidColorBrush x:Key="Brush.Line" Color="#E2E5F1" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#868CAB" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#151A33" />
    <SolidColorBrush x:Key="Brush.Ink2" Color="#5C6386" />
    <SolidColorBrush x:Key="Brush.Ink3" Color="#676D8C" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#3A5BFF" />
    <SolidColorBrush x:Key="Brush.AmberSoft" Color="#243A5BFF" />
    <SolidColorBrush x:Key="Brush.OnAmber" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Measured" Color="#4B5A12" />
    <SolidColorBrush x:Key="Brush.Calibrated" Color="#7A5A08" />
    <SolidColorBrush x:Key="Brush.Estimated" Color="#0E5A85" />
    <SolidColorBrush x:Key="Brush.PartCpu" Color="#0D9488" />
    <SolidColorBrush x:Key="Brush.PartGpu" Color="#7C5CE6" />
    <SolidColorBrush x:Key="Brush.PartDisplay" Color="#0891B2" />
    <SolidColorBrush x:Key="Brush.PartRest" Color="#8A90AE" />

    <!-- Midnight's own keys. -->
    <SolidColorBrush x:Key="M.Ground" Color="#F3F4FA" />
    <SolidColorBrush x:Key="M.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.Raised" Color="#F7F8FD" />
    <SolidColorBrush x:Key="M.Line" Color="#E2E5F1" />
    <SolidColorBrush x:Key="M.LineStrong" Color="#868CAB" />
    <SolidColorBrush x:Key="M.Ink" Color="#151A33" />
    <SolidColorBrush x:Key="M.Ink2" Color="#5C6386" />
    <SolidColorBrush x:Key="M.Ink3" Color="#676D8C" />
    <SolidColorBrush x:Key="M.Accent" Color="#3A5BFF" />
    <SolidColorBrush x:Key="M.AccentSoft" Color="#243A5BFF" />
    <SolidColorBrush x:Key="M.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.AccentText" Color="#3A5BFF" />
    <SolidColorBrush x:Key="M.Good" Color="#147F57" />
    <SolidColorBrush x:Key="M.Bad" Color="#CC3B3B" />
    <SolidColorBrush x:Key="M.Warn" Color="#C28511" />
    <SolidColorBrush x:Key="M.PartCpu" Color="#0D9488" />
    <SolidColorBrush x:Key="M.PartGpu" Color="#7C5CE6" />
    <SolidColorBrush x:Key="M.PartDisplay" Color="#0891B2" />
    <SolidColorBrush x:Key="M.PartRest" Color="#8A90AE" />
    <!-- The quality chips: the ground, and the text on it. -->
    <SolidColorBrush x:Key="M.ChipMeasured" Color="#EEF3D6" />
    <SolidColorBrush x:Key="M.ChipMeasuredText" Color="#4B5A12" />
    <SolidColorBrush x:Key="M.ChipCalibrated" Color="#FBF1CF" />
    <SolidColorBrush x:Key="M.ChipCalibratedText" Color="#7A5A08" />
    <SolidColorBrush x:Key="M.ChipEstimated" Color="#DDEFFA" />
    <SolidColorBrush x:Key="M.ChipEstimatedText" Color="#0E5A85" />
    <!-- Glass (the top bar and tooltips over content), shadow, hatch, the area chart's gradient and the focus ring. -->
    <SolidColorBrush x:Key="M.GlassFill" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="M.GlassBorder" Color="#14151A33" />
    <SolidColorBrush x:Key="M.GlassHighlight" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="M.Shadow" Color="#29151A33" />
    <SolidColorBrush x:Key="M.Hatch" Color="#1A151A33" />
    <SolidColorBrush x:Key="M.ChartFillTop" Color="#473A5BFF" />
    <SolidColorBrush x:Key="M.ChartFillBottom" Color="#003A5BFF" />
    <SolidColorBrush x:Key="M.Focus" Color="#3A5BFF" />
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Midnight, dark: the design's §3 tokens. Classic's keys come first with Midnight's values, so the dialogs, the wizard
         and the update card take Midnight's colours without a change; the amber keys carry the accent, as the brand mark
         alone stays amber. Ink3 and LineStrong sit a little above the design's first figures, where the contrast tests
         (text 4.5:1, borders 3:1 on the panel) put them. -->
    <SolidColorBrush x:Key="Brush.Ground" Color="#0B0E1C" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#10142A" />
    <SolidColorBrush x:Key="Brush.Raised" Color="#161B36" />
    <SolidColorBrush x:Key="Brush.Line" Color="#1F2547" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="#5A6396" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#ECEEF9" />
    <SolidColorBrush x:Key="Brush.Ink2" Color="#A9AFCC" />
    <SolidColorBrush x:Key="Brush.Ink3" Color="#7E85AC" />
    <SolidColorBrush x:Key="Brush.Amber" Color="#4C6FFF" />
    <SolidColorBrush x:Key="Brush.AmberSoft" Color="#384C6FFF" />
    <SolidColorBrush x:Key="Brush.OnAmber" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Measured" Color="#D9E27F" />
    <SolidColorBrush x:Key="Brush.Calibrated" Color="#F1D57A" />
    <SolidColorBrush x:Key="Brush.Estimated" Color="#7CC4F5" />
    <SolidColorBrush x:Key="Brush.PartCpu" Color="#6D8CFF" />
    <SolidColorBrush x:Key="Brush.PartGpu" Color="#A78BFA" />
    <SolidColorBrush x:Key="Brush.PartDisplay" Color="#38BDF8" />
    <SolidColorBrush x:Key="Brush.PartRest" Color="#7C86A8" />

    <!-- Midnight's own keys. -->
    <SolidColorBrush x:Key="M.Ground" Color="#0B0E1C" />
    <SolidColorBrush x:Key="M.Panel" Color="#10142A" />
    <SolidColorBrush x:Key="M.Raised" Color="#161B36" />
    <SolidColorBrush x:Key="M.Line" Color="#1F2547" />
    <SolidColorBrush x:Key="M.LineStrong" Color="#5A6396" />
    <SolidColorBrush x:Key="M.Ink" Color="#ECEEF9" />
    <SolidColorBrush x:Key="M.Ink2" Color="#A9AFCC" />
    <SolidColorBrush x:Key="M.Ink3" Color="#7E85AC" />
    <SolidColorBrush x:Key="M.Accent" Color="#4C6FFF" />
    <SolidColorBrush x:Key="M.AccentSoft" Color="#384C6FFF" />
    <SolidColorBrush x:Key="M.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="M.Good" Color="#34D399" />
    <SolidColorBrush x:Key="M.Bad" Color="#F87171" />
    <SolidColorBrush x:Key="M.Warn" Color="#F5B942" />
    <SolidColorBrush x:Key="M.PartCpu" Color="#6D8CFF" />
    <SolidColorBrush x:Key="M.PartGpu" Color="#A78BFA" />
    <SolidColorBrush x:Key="M.PartDisplay" Color="#38BDF8" />
    <SolidColorBrush x:Key="M.PartRest" Color="#7C86A8" />
    <!-- The quality chips: the ground, and the text on it. -->
    <SolidColorBrush x:Key="M.ChipMeasured" Color="#2F3A1E" />
    <SolidColorBrush x:Key="M.ChipMeasuredText" Color="#D9E27F" />
    <SolidColorBrush x:Key="M.ChipCalibrated" Color="#3A3418" />
    <SolidColorBrush x:Key="M.ChipCalibratedText" Color="#F1D57A" />
    <SolidColorBrush x:Key="M.ChipEstimated" Color="#1A2F44" />
    <SolidColorBrush x:Key="M.ChipEstimatedText" Color="#7CC4F5" />
    <!-- Glass (the top bar and tooltips over content), shadow, hatch, the area chart's gradient and the focus ring. -->
    <SolidColorBrush x:Key="M.GlassFill" Color="#B810142A" />
    <SolidColorBrush x:Key="M.GlassBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="M.GlassHighlight" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="M.Shadow" Color="#73000000" />
    <SolidColorBrush x:Key="M.Hatch" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="M.ChartFillTop" Color="#594C6FFF" />
    <SolidColorBrush x:Key="M.ChartFillBottom" Color="#004C6FFF" />
    <SolidColorBrush x:Key="M.Focus" Color="#8FA5FF" />
</ResourceDictionary>

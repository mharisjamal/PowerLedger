<Window x:Class="PowerLedger.App.PayloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What would be sent" Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <TextBox x:Name="Body" Margin="12" Padding="10" FontFamily="{StaticResource Font.Numbers}" FontSize="12.5"
             IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="NoWrap" AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             Background="{DynamicResource Brush.Ground}" Foreground="{DynamicResource Brush.Ink}"
             BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" />
</Window>

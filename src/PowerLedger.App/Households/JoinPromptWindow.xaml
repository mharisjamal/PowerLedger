<Window x:Class="PowerLedger.App.JoinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerLedger.App"
        Title="Join a household" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <!-- The buttons have a row of their own, so however short the screen, they stay in view while the text above scrolls
         (the same shape as the consent dialog, data-sharing design §2). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,24,28,8">
                <TextBlock Style="{StaticResource Text.Body}" FontSize="16" TextWrapping="Wrap" Text="{Binding Heading}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding ComparisonLine}"
                           Visibility="{Binding HasComparisonLine, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Amber}"
                           Visibility="{Binding ShowLeaveWarning, Converter={StaticResource VisibleWhen}}"
                           Text="Joining will leave your current household." />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="28,4,28,20">
            <UniformGrid Rows="1" Columns="2">
                <Button Style="{StaticResource Quiet}" Content="Don't join" Command="{Binding DontJoin}" Margin="0,0,6,0" HorizontalContentAlignment="Center" />
                <Button Style="{StaticResource Quiet}" Content="Join" Command="{Binding Join}" Margin="6,0,0,0" HorizontalContentAlignment="Center" />
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>

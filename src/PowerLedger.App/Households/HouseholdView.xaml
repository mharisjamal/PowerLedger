<UserControl x:Class="PowerLedger.App.HouseholdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PowerLedger.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="26,22,26,18">

            <!-- Before a household exists: the explanation and Add a PC (households design §2). -->
            <StackPanel Visibility="{Binding HasHousehold, Converter={StaticResource HiddenWhen}}">
                <TextBlock Style="{StaticResource Text.Eyebrow}" Text="HOUSEHOLD" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,10,0,16" MaxWidth="480" HorizontalAlignment="Left"
                           Text="{Binding Message}" />
                <!-- Task 0.8's removeOldRows: household_rows/household_members still name this PC from one it has since
                     left; Remove the old household's rows deletes every left PC's rows named here. -->
                <StackPanel Visibility="{Binding HasOldRows, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                               Text="This PC still holds rows from a household it left."
                               Visibility="{Binding IsConfirming, Converter={StaticResource HiddenWhen}}" />
                    <Button Style="{StaticResource Link}" Margin="0,4,0,0" Content="Remove the old household's rows…" Command="{Binding AskRemoveAllOldRows}"
                            HorizontalAlignment="Left" Visibility="{Binding IsConfirming, Converter={StaticResource HiddenWhen}}" />
                    <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Text="{Binding ConfirmText}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Amber}" Text="{Binding ActionMessage}"
                                   Visibility="{Binding ActionMessage, Converter={StaticResource VisibleWhenText}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Quiet}" Content="Cancel" Command="{Binding CancelPending}" />
                            <Button Style="{StaticResource Quiet}" Content="Confirm" Command="{Binding ConfirmPending}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- N2, plan 0.9: this PC's join request ended unanswered or was refused; only the user asks again. -->
                <StackPanel Visibility="{Binding CanAskAgain, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" Text="Nobody approved this PC." />
                    <Button Style="{StaticResource Link}" Margin="0,4,0,0" Content="Ask again" Command="{Binding AskAgain}" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Amber}" Text="{Binding AskAgainMessage}"
                               Visibility="{Binding AskAgainMessage, Converter={StaticResource VisibleWhenText}}" />
                </StackPanel>
                <Button Style="{StaticResource Quiet}" Content="Add a PC" Command="{Binding AddPc}" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Visibility="{Binding HasHousehold, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,14" Text="{Binding Message}"
                           Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,14" Foreground="{DynamicResource Brush.Amber}" Text="{Binding Problem}"
                           Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" DataContext="{Binding Today}">
                        <Border Style="{StaticResource LedgerHead}">
                            <TextBlock Style="{StaticResource Text.Eyebrow}" Text="TODAY" />
                        </Border>
                        <local:LedgerRow IsHero="True" Key="Energy" Value="{Binding Energy}" Note="kWh" />
                        <ItemsControl ItemsSource="{Binding Costs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HouseholdCostLine}">
                                    <local:LedgerRow Key="Cost" Value="{Binding Cost}" Note="{Binding Currency}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2" DataContext="{Binding Week}">
                        <Border Style="{StaticResource LedgerHead}">
                            <TextBlock Style="{StaticResource Text.Eyebrow}" Text="THIS WEEK" />
                        </Border>
                        <local:LedgerRow IsHero="True" Key="Energy" Value="{Binding Energy}" Note="kWh" />
                        <ItemsControl ItemsSource="{Binding Costs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HouseholdCostLine}">
                                    <local:LedgerRow Key="Cost" Value="{Binding Cost}" Note="{Binding Currency}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="4" DataContext="{Binding Month}">
                        <Border Style="{StaticResource LedgerHead}">
                            <TextBlock Style="{StaticResource Text.Eyebrow}" Text="THIS MONTH" />
                        </Border>
                        <local:LedgerRow IsHero="True" Key="Energy" Value="{Binding Energy}" Note="kWh" />
                        <ItemsControl ItemsSource="{Binding Costs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HouseholdCostLine}">
                                    <local:LedgerRow Key="Cost" Value="{Binding Cost}" Note="{Binding Currency}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Text.Eyebrow}" Margin="0,28,0,10" Text="YOUR PCS · SHARE OF THIS MONTH" />
                <ItemsControl ItemsSource="{Binding Members}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HouseholdMemberDisplay}">
                            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
                                        <TextBlock Style="{StaticResource Text.Number}" Text="{Binding Energy}" HorizontalAlignment="Right" />
                                        <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Status}" HorizontalAlignment="Right" />
                                        <Button Style="{StaticResource Link}" Content="Remove" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                Command="{Binding DataContext.AskRemove, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding CanRemove, Converter={StaticResource VisibleWhen}}" />
                                        <!-- Task 0.8: a left row's rows can be deleted (removeOldRows) instead of removing a current member. -->
                                        <Button Style="{StaticResource Link}" Content="Remove its rows" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                Command="{Binding DataContext.AskRemove, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding CanRemoveRows, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="8,0,0,0" Text="{Binding Kind}" />
                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="8,0,0,0" Text="this PC"
                                                       Visibility="{Binding IsThisPc, Converter={StaticResource VisibleWhen}}" />
                                        </DockPanel>
                                        <Border Width="140" Height="6" Margin="0,8,0,0" Background="{DynamicResource Brush.Line}" CornerRadius="3"
                                                HorizontalAlignment="Left">
                                            <Border Height="6" HorizontalAlignment="Left" Background="{DynamicResource Brush.PartCpu}" CornerRadius="3"
                                                    Width="{Binding Share, Converter={StaticResource ShareWidth}, ConverterParameter=140}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource Link}" Margin="0,20,0,0" Content="Add a PC" Command="{Binding AddPc}" HorizontalAlignment="Left" />

                <TextBlock Style="{StaticResource Text.Eyebrow}" Margin="0,28,0,10" Text="MANAGE THIS HOUSEHOLD" />
                <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource HiddenWhen}}">
                    <DockPanel MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Muted}" Text="This PC's name" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Content="Save" Margin="8,0,0,0" Command="{Binding SaveName}" />
                        <TextBox Style="{StaticResource Field}" Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Amber}" Text="{Binding NameMessage}"
                               Visibility="{Binding NameMessage, Converter={StaticResource VisibleWhenText}}" />
                    <Button Style="{StaticResource Quiet}" Margin="0,16,0,0" Content="Leave this household…" Command="{Binding AskLeave}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" Text="{Binding ConfirmText}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" Foreground="{DynamicResource Brush.Amber}" Text="{Binding ActionMessage}"
                               Visibility="{Binding ActionMessage, Converter={StaticResource VisibleWhenText}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Quiet}" Content="Cancel" Command="{Binding CancelPending}" />
                        <Button Style="{StaticResource Quiet}" Content="Confirm" Command="{Binding ConfirmPending}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource Text.Eyebrow}" Margin="0,28,0,10" Text="SIGN IN" />
            <StackPanel DataContext="{Binding Account}">
                <StackPanel Visibility="{Binding SignedIn, Converter={StaticResource HiddenWhen}}">
                    <!-- Security round, review: a provider with no client ID (or, for Google, no secret) is not offered
                         at all; with neither available, this explains why instead of showing anything to press. -->
                    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"
                               Text="{x:Static local:SignInViewModel.Unavailable}"
                               Visibility="{Binding AnyAvailable, Converter={StaticResource HiddenWhen}}" />
                    <StackPanel Visibility="{Binding AnyAvailable, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingRecoverySignIn, Converter={StaticResource HiddenWhen}}">
                            <Button Style="{StaticResource Quiet}" Content="Sign in with Microsoft" Command="{Binding SignInWithMicrosoft}"
                                    Visibility="{Binding MicrosoftAvailable, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource Quiet}" Content="Sign in with Google" Command="{Binding SignInWithGoogle}" Margin="8,0,0,0"
                                    Visibility="{Binding GoogleAvailable, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                        <DockPanel Margin="0,10,0,0" MaxWidth="420" HorizontalAlignment="Left" Visibility="{Binding ConfirmingRecoverySignIn, Converter={StaticResource HiddenWhen}}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Muted}" Text="Recovery code" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <!-- Plan 0.10: read once when Sign in is pressed and locked until that sign-in ends, so a
                                 code typed while the browser is up changes nothing about the attempt already under way. -->
                            <TextBox Style="{StaticResource Field}" Text="{Binding RecoveryCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding RecoveryCodeLocked}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Have a recovery code? Type it here, then sign in, to get your household back without waiting for another PC to approve you."
                                   Visibility="{Binding ConfirmingRecoverySignIn, Converter={StaticResource HiddenWhen}}" />
                        <!-- Plan 0.9: a typed recovery code warns before the browser opens at all, since it removes the
                             household's other PCs. -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ConfirmingRecoverySignIn, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"
                                       Text="{x:Static local:SignInViewModel.RecoveryWarning}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Quiet}" Content="Cancel" Command="{Binding CancelRecoverySignIn}" />
                                <Button Style="{StaticResource Quiet}" Content="Continue" Command="{Binding ContinueRecoverySignIn}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding SignedIn, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Email}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding ConfirmingDelete, Converter={StaticResource HiddenWhen}}">
                        <Button Style="{StaticResource Quiet}" Content="Sign out" Command="{Binding SignOut}" />
                        <Button Style="{StaticResource Quiet}" Content="Delete account…" Command="{Binding DeleteAccount}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding ConfirmingDelete, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Delete account" />
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="This removes your account and its recovery code. Your household and its members carry on without sign-in." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Quiet}" Content="Delete" Command="{Binding ConfirmDelete}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Quiet}" Content="Cancel" Command="{Binding CancelDelete}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Amber}" Text="{Binding Message}"
                           Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}" />
            </StackPanel>

            <!-- Review finding A6, task 0.8: RecoveryMissing, whether or not this PC is in a household right now. -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding RecoveryMissing, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"
                           Text="Your account's recovery code no longer works." />
                <Button Style="{StaticResource Quiet}" Margin="0,8,0,0" Content="Make a new recovery code" Command="{Binding MakeRecoveryCode}"
                        HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Amber}" Text="{Binding RecoveryMessage}"
                           Visibility="{Binding RecoveryMessage, Converter={StaticResource VisibleWhenText}}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>

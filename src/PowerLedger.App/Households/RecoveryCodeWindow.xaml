<Window x:Class="PowerLedger.App.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerLedger.App"
        Title="Your recovery code" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <!-- The buttons have a row of their own, so however short the screen, they stay in view while the text above scrolls
         (the same shape as the Join, Approve and Confirm join prompts). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="28,24,28,8">
                <TextBlock Style="{StaticResource Text.Body}" FontSize="16" TextWrapping="Wrap" Text="Your recovery code" />
                <TextBox Style="{StaticResource Field}" IsReadOnly="True" FontFamily="{StaticResource Font.Numbers}" FontSize="17"
                         HorizontalContentAlignment="Center" Padding="0,10" Margin="0,14,0,0" Text="{Binding Code, Mode=OneWay}" />
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,14,0,0" Text="{x:Static local:RecoveryCodeViewModel.Explanation}" />
                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Amber}"
                           Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource VisibleWhenText}}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,4,28,20">
            <Button Style="{StaticResource Quiet}" Content="Copy" Command="{Binding Copy}" />
            <Button Style="{StaticResource Quiet}" Content="Save as text file" Command="{Binding SaveAsTextFile}" Margin="8,0,0,0" />
            <Button Style="{StaticResource Quiet}" Content="OK" Command="{Binding Ok}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>

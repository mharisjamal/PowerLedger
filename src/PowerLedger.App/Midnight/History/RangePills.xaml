<UserControl x:Class="PowerLedger.App.Midnight.RangePills"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PowerLedger.App">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Midnight's styles and the page styles, the one instance the window merges (SharedDictionary): a view the
                     window's DataTemplate builds resolves its StaticResources before it joins the window. -->
                <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Midnight/Styles.Midnight.Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- The same six ranges Classic's RangeBar offers, as pills on one track, with the custom dates in fields beside them. -->
    <WrapPanel>
        <Border Style="{StaticResource M.PillTrack}" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource M.Pill}" Content="Today" IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.Today}}" />
                <RadioButton Style="{StaticResource M.Pill}" Content="7 days" IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.SevenDays}}" />
                <RadioButton Style="{StaticResource M.Pill}" Content="30 days" IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.ThirtyDays}}" />
                <RadioButton Style="{StaticResource M.Pill}" Content="This month" IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.ThisMonth}}" />
                <RadioButton Style="{StaticResource M.Pill}" Content="Last month" IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.LastMonth}}" />
                <RadioButton Style="{StaticResource M.Pill}" Content="Custom" IsChecked="{Binding Choice, Converter={StaticResource Is}, ConverterParameter={x:Static app:RangeChoice.Custom}}" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,6" Visibility="{Binding IsCustom, Converter={StaticResource VisibleWhen}}">
            <DatePicker Style="{StaticResource M.Field.Date}" Width="132" SelectedDate="{Binding From}" AutomationProperties.Name="First day" />
            <TextBlock Style="{StaticResource M.Text.Muted}" Text="to" VerticalAlignment="Center" Margin="8,0" />
            <DatePicker Style="{StaticResource M.Field.Date}" Width="132" SelectedDate="{Binding To}" AutomationProperties.Name="Last day" />
        </StackPanel>
    </WrapPanel>
</UserControl>

<UserControl x:Class="PowerLedger.App.Midnight.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PowerLedger.App"
             xmlns:local="clr-namespace:PowerLedger.App.Midnight">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Midnight's styles and the page styles, the one instance the window merges (SharedDictionary): a view the
                     window's DataTemplate builds resolves its StaticResources before it joins the window. -->
                <app:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Midnight/Styles.Midnight.Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource M.Page.Margin}">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource M.PillTrack}" VerticalAlignment="Top" Margin="16,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource M.Pill}" Content="W" ToolTip="Average watts while the machine was on"
                                     IsChecked="{Binding Unit, Converter={StaticResource Is}, ConverterParameter={x:Static app:ChartUnit.Watts}}" />
                        <RadioButton Style="{StaticResource M.Pill}" Content="Wh" ToolTip="Energy in each bucket"
                                     IsChecked="{Binding Unit, Converter={StaticResource Is}, ConverterParameter={x:Static app:ChartUnit.WattHours}}" />
                    </StackPanel>
                </Border>
                <local:RangePills DataContext="{Binding Range}" ShowHourAndYear="True" />
            </DockPanel>

            <!-- The chart card: the range and bucket over it, the unit at the right, the legend under it. -->
            <Border Style="{StaticResource M.Card}" Margin="{StaticResource M.Card.Gap}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource M.Text.Column}" VerticalAlignment="Center" Text="{Binding UnitLabel}" />
                        <TextBlock Style="{StaticResource M.Text.Heading}" Text="{Binding Heading}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource M.Text.Muted}" Margin="0,8,0,0" Text="{Binding Message}"
                               Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" />
                    <app:StackedChart Style="{StaticResource M.StackedChart}" Height="300" Margin="0,16,0,0" Model="{Binding Chart}" />
                    <WrapPanel Margin="0,12,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource M.Text.Secondary}">
                                <Setter Property="Margin" Value="8,0,20,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource M.Legend.Dot}" />
                        </WrapPanel.Resources>
                        <Ellipse Fill="{DynamicResource M.PartCpu}" /><TextBlock Text="CPU" />
                        <Ellipse Fill="{DynamicResource M.PartGpu}" /><TextBlock Text="GPU" />
                        <Ellipse Fill="{DynamicResource M.PartDisplay}" /><TextBlock Text="Display" />
                        <Ellipse Fill="{DynamicResource M.PartRest}" /><TextBlock Text="Rest" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- The table card: a row per part with its share as a bar, and the total last. -->
            <Border Style="{StaticResource M.Card}" Margin="{StaticResource M.Card.Gap}" Padding="20,20,20,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource M.Text.Heading}" Margin="0,0,0,12" Text="By component" />
                    <Border Style="{StaticResource M.Table.Header}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource M.Text.Column}" Text="Component" />
                            <TextBlock Grid.Column="2" Style="{StaticResource M.Text.Column}" Text="kWh" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Style="{StaticResource M.Text.Column}" Text="Share" Margin="24,0,0,0" Width="{StaticResource M.ShareTrack.Width}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:PartRow}">
                                <Border x:Name="Line" Style="{StaticResource M.Table.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Swatch" Style="{StaticResource M.Legend.Dot}" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="Label" Grid.Column="1" Style="{StaticResource M.Text.Body}" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Energy" Grid.Column="2" Style="{StaticResource M.Text.Number}" Text="{Binding Energy}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <app:ShareBar x:Name="Share" Grid.Column="3" Style="{StaticResource M.ShareBar}" Width="{StaticResource M.ShareTrack.Width}" Margin="24,0,0,0"
                                                      VerticalAlignment="Center" Value="{Binding Fraction}" FillBrush="{DynamicResource M.PartRest}"
                                                      AutomationProperties.Name="{Binding Name, StringFormat={}{0} share}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource M.Text.Number}" Foreground="{DynamicResource M.Ink3}" Text="{Binding Share}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Part}" Value="Cpu">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartCpu}" />
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartCpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Part}" Value="Gpu">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartGpu}" />
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartGpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Part}" Value="Display">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartDisplay}" />
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartDisplay}" />
                                    </DataTrigger>
                                    <!-- A line beside the bands, or the total: no dot and no bar. Only the total stands out. -->
                                    <DataTrigger Binding="{Binding Part}" Value="{x:Null}">
                                        <Setter TargetName="Swatch" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Share" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Total">
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Energy" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Line" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource M.Note}" Margin="0,12,0,0"
                               Visibility="{Binding HasNegativeRest, Converter={StaticResource VisibleWhen}}"
                               Text="The rest of the system fell below zero for part of this range: in measured mode the parts sometimes report more than the battery drains. The chart and the table count it as zero." />
                    <TextBlock Style="{StaticResource M.Note}" Margin="0,12,0,0" Text="{Binding Footnote}" />
                </StackPanel>
            </Border>

            <!-- Plan AE: the range's apps, the Apps ledger as a table: the apps most first, the lines beside them, the screen,
                 Windows and idle and the rest of the PC set apart, the total. A row's tooltip says what it holds. -->
            <Border Style="{StaticResource M.Card}" Margin="{StaticResource M.Card.Gap}" Padding="20,20,20,12" AutomationProperties.Name="By app"
                    Visibility="{Binding HasApps, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource M.Text.Heading}" Margin="0,0,0,12" Text="By app" />
                    <Border Style="{StaticResource M.Table.Header}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource M.Text.Column}" Text="App" />
                            <TextBlock Grid.Column="2" Style="{StaticResource M.Text.Column}" Text="kWh" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Style="{StaticResource M.Text.Column}" Text="Share" Margin="24,0,0,0" Width="{StaticResource M.ShareTrack.Width}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource M.Text.Column}" Text="Cost" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Apps}" Focusable="False" AutomationProperties.Name="Apps by energy">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:AppRow}">
                                <Border x:Name="Line" Style="{StaticResource M.Table.Row}" ToolTip="{Binding Detail}"
                                        AutomationProperties.Name="{Binding Spoken}" AutomationProperties.HelpText="{Binding Detail}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <app:AppIcon x:Name="Picture" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Path="{Binding Path}" Glyph="{Binding Glyph}"
                                                     Tile="{DynamicResource M.Raised}" Foreground="{DynamicResource M.Ink2}" />
                                        <TextBlock x:Name="Label" Grid.Column="1" Style="{StaticResource M.Text.Body}" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="Energy" Grid.Column="2" Style="{StaticResource M.Text.Number}" Text="{Binding Energy}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <app:ShareBar x:Name="Share" Grid.Column="3" Style="{StaticResource M.ShareBar}" Width="{StaticResource M.ShareTrack.Width}" Margin="24,0,0,0"
                                                      VerticalAlignment="Center" Value="{Binding Fraction}" FillBrush="{DynamicResource M.Accent}"
                                                      AutomationProperties.Name="{Binding Name, StringFormat={}{0} share}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource M.Text.Number}" Foreground="{DynamicResource M.Ink3}" Text="{Binding Share}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource M.Text.Number}" Text="{Binding Cost}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- The lines beside the apps: quieter words, no bar, as the bands' lines beside the bands. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Beside">
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource M.Ink2}" />
                                        <Setter TargetName="Share" Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                    <!-- The fixed lines set apart, in their parts' colours. -->
                                    <DataTrigger Binding="{Binding Apart}" Value="True">
                                        <Setter TargetName="Line" Property="Margin" Value="0,14,0,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Glyph}" Value="Screen">
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartDisplay}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Glyph}" Value="System">
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartCpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Glyph}" Value="Rest">
                                        <Setter TargetName="Share" Property="FillBrush" Value="{DynamicResource M.PartRest}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Total">
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Energy" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Share" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Line" Property="BorderThickness" Value="0" />
                                        <Setter TargetName="Line" Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource M.Text.Muted}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding AppsMessage}"
                               Visibility="{Binding AppsMessage, Converter={StaticResource VisibleWhenText}}" />
                    <TextBlock Style="{StaticResource M.Note}" Margin="0,12,0,0"
                               Text="Each share is of everything this PC used: every app's processor and graphics energy, the screen and the rest of the PC. Apps are grouped by program, not by process. This list stays on this PC." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

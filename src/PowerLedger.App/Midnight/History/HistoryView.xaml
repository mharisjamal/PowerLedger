<UserControl x:Class="PowerLedger.App.Midnight.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PowerLedger.App"
             xmlns:local="clr-namespace:PowerLedger.App.Midnight">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="{StaticResource M.Page.Margin}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <RadioButton Style="{StaticResource M.Pill}" Content="W" ToolTip="Average watts while the machine was on" Margin="0,0,6,6"
                                 IsChecked="{Binding Unit, Converter={StaticResource Is}, ConverterParameter={x:Static app:ChartUnit.Watts}}" />
                    <RadioButton Style="{StaticResource M.Pill}" Content="Wh" ToolTip="Energy in each bucket" Margin="0,0,0,6"
                                 IsChecked="{Binding Unit, Converter={StaticResource Is}, ConverterParameter={x:Static app:ChartUnit.WattHours}}" />
                </StackPanel>
                <local:RangePills DataContext="{Binding Range}" />
            </DockPanel>

            <!-- The chart card: the range and bucket over it, the unit at the right, the legend under it. -->
            <Border Style="{StaticResource M.Card}" Margin="{StaticResource M.Card.Gap}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource M.Text.Eyebrow}" VerticalAlignment="Center"
                                   Text="{Binding UnitLabel, Converter={StaticResource Upper}}" />
                        <TextBlock Style="{StaticResource M.Text.Heading}" Text="{Binding Heading}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource M.Text.Muted}" Margin="0,8,0,0" Text="{Binding Message}"
                               Visibility="{Binding HasMessage, Converter={StaticResource VisibleWhen}}" />
                    <app:StackedChart Style="{StaticResource M.Chart}" Height="300" Margin="0,16,0,0" Model="{Binding Chart}" />
                    <WrapPanel Margin="0,12,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource M.Text.Secondary}">
                                <Setter Property="Margin" Value="8,0,20,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource M.Legend.Dot}" />
                        </WrapPanel.Resources>
                        <Ellipse Fill="{DynamicResource M.PartCpu}" /><TextBlock Text="CPU" />
                        <Ellipse Fill="{DynamicResource M.PartGpu}" /><TextBlock Text="GPU" />
                        <Ellipse Fill="{DynamicResource M.PartDisplay}" /><TextBlock Text="Display" />
                        <Ellipse Fill="{DynamicResource M.PartRest}" /><TextBlock Text="Rest" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- The table card: a row per part with its share as a bar, and the total last. -->
            <Border Style="{StaticResource M.Card}" Margin="{StaticResource M.Card.Gap}" Padding="20,20,20,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource M.Text.Heading}" Margin="0,0,0,12" Text="By component" />
                    <Border Style="{StaticResource M.Table.Header}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource M.Text.Eyebrow}" Text="COMPONENT" />
                            <TextBlock Grid.Column="2" Style="{StaticResource M.Text.Eyebrow}" Text="KWH" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Style="{StaticResource M.Text.Eyebrow}" Text="SHARE" Margin="24,0,0,0" Width="{StaticResource M.ShareTrack.Width}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:PartRow}">
                                <Border x:Name="Line" Style="{StaticResource M.Table.Row}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Swatch" Style="{StaticResource M.Legend.Dot}" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="Label" Grid.Column="1" Style="{StaticResource M.Text.Body}" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Energy" Grid.Column="2" Style="{StaticResource M.Text.Number}" Text="{Binding Energy}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Border x:Name="Track" Grid.Column="3" Style="{StaticResource M.ShareTrack}" Width="{StaticResource M.ShareTrack.Width}"
                                                Margin="24,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat={}{0} share}">
                                            <Border x:Name="Fill" HorizontalAlignment="Left" Background="{DynamicResource M.PartRest}" CornerRadius="3"
                                                    Width="{Binding Fraction, Converter={StaticResource ShareWidth}, ConverterParameter=120}" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Style="{StaticResource M.Text.Number}" Foreground="{DynamicResource M.Ink3}" Text="{Binding Share}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Part}" Value="Cpu">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartCpu}" />
                                        <Setter TargetName="Fill" Property="Background" Value="{DynamicResource M.PartCpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Part}" Value="Gpu">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartGpu}" />
                                        <Setter TargetName="Fill" Property="Background" Value="{DynamicResource M.PartGpu}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Part}" Value="Display">
                                        <Setter TargetName="Swatch" Property="Fill" Value="{DynamicResource M.PartDisplay}" />
                                        <Setter TargetName="Fill" Property="Background" Value="{DynamicResource M.PartDisplay}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Part}" Value="{x:Null}">
                                        <Setter TargetName="Swatch" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Track" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Energy" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Line" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource M.Note}" Margin="0,12,0,0"
                               Visibility="{Binding HasNegativeRest, Converter={StaticResource VisibleWhen}}"
                               Text="The rest of the system fell below zero for part of this range: in measured mode the parts sometimes report more than the battery drains. The chart and the table count it as zero." />
                    <TextBlock Style="{StaticResource M.Note}" Margin="0,12,0,0" Text="{Binding Footnote}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

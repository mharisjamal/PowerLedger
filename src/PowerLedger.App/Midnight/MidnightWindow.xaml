<Window x:Class="PowerLedger.App.MidnightWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerLedger.App"
        xmlns:midnight="clr-namespace:PowerLedger.App.Midnight"
        Title="PowerLedger" Icon="pack://application:,,,/PowerLedger;component/Brand/PowerLedger.ico" Width="1180" Height="900" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource M.Ground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!-- The Midnight shell (Midnight look design §1, plan O M1-3): a 232 px sidebar with the pages in groups, a plain top
         bar over a hairline that the window is dragged by, the page header with its status pill and the household's members, and the page host.
         The drag area is the top 56 px, the top bar's height. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Midnight's styles live here, not at Application level, so its implicit styles never reach Classic or the dialogs;
                     the views merge the same instance (SharedDictionary). M2's page-only styles (Styles.Midnight.Pages.xaml) merge after this one. -->
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Midnight/Styles.Midnight.xaml" />
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Midnight/Styles.Midnight.Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:PageTitle x:Key="PageTitle" />
            <local:AtLeast x:Key="AtLeast" />

            <!-- A short window (under 700 px, where the full sidebar and an update card would not both fit) draws the
                 sidebar's items and groups closer and the update card down to its title and action, so every page stays
                 in view beside the card. -->
            <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource M.NavItem}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=700}" Value="False">
                        <Setter Property="Height" Value="34" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource M.NavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=700}" Value="False">
                        <Setter Property="Height" Value="34" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NavGroup" TargetType="TextBlock" BasedOn="{StaticResource M.NavGroup}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=700}" Value="False">
                        <Setter Property="Margin" Value="24,10,16,4" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="UpdateMore" TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AtLeast}, ConverterParameter=700}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate DataType="{x:Type local:DashboardViewModel}">
                <local:DashboardView />
            </DataTemplate>
            <!-- Midnight's own views over Classic's ViewModels (Midnight look design §2). -->
            <DataTemplate DataType="{x:Type local:BreakdownViewModel}">
                <midnight:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ReportViewModel}">
                <midnight:ReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:HouseholdViewModel}">
                <midnight:HouseholdView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:SettingsViewModel}">
                <midnight:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:WizardViewModel}">
                <local:WizardView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource M.LineStrong}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <!-- Windows pushes a maximised window's resize border off screen; keep the content on it. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The sidebar: the brand, the groups, and at the foot the service's state, the update card and the bug button. -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource M.Panel}" BorderBrush="{DynamicResource M.Line}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,16,24,12" Height="28">
                        <Image Source="{StaticResource Brand.Mark}" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource M.Text.Heading}" Margin="10,0,0,0" Text="PowerLedger" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                        <!-- The update card (spec §13): only when there is something to say. -->
                        <Border x:Name="UpdateCard" Style="{StaticResource M.Card.Flat}" Padding="14,12" Margin="0,0,0,12" DataContext="{Binding Updates}"
                                Visibility="{Binding ShowCard, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" AutomationProperties.Name="Update">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource M.IconButton.Quiet}" Width="24" Height="24" MinHeight="24" FontSize="9" Content="&#xE8BB;"
                                            Command="{Binding Dismiss}" ToolTip="Later" AutomationProperties.Name="Later" Margin="0,-4,-6,0"
                                            Visibility="{Binding CanDismiss, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock Style="{StaticResource M.Text.Eyebrow}" Text="UPDATE" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource M.Text.Body}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Title}" />
                                <StackPanel Style="{StaticResource UpdateMore}">
                                    <TextBlock Style="{StaticResource M.Text.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Detail}"
                                               Visibility="{Binding Detail, Converter={StaticResource VisibleWhenText}}" />
                                </StackPanel>
                                <Button Style="{StaticResource M.Button.Primary}" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{Binding ActionLabel}"
                                        Command="{Binding Act}" Visibility="{Binding ActionLabel, Converter={StaticResource VisibleWhenText}}" />
                                <StackPanel Style="{StaticResource UpdateMore}">
                                    <Button Style="{StaticResource M.Button.Quiet}" Margin="-12,6,0,0" HorizontalAlignment="Left" Content="What's new"
                                            Command="{Binding OpenNotes}" Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="12,0,0,0">
                            <Button x:Name="BugButton" DockPanel.Dock="Right" Style="{StaticResource M.IconButton}" Click="FeedbackClick"
                                    ToolTip="Send feedback or report a bug" AutomationProperties.Name="Send feedback">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M6.5,3.5 A1.5,1.5 0 1 0 9.5,3.5 A1.5,1.5 0 1 0 6.5,3.5 Z M5,9.5 A3,4 0 1 0 11,9.5 A3,4 0 1 0 5,9.5 Z M7,2.2 L6,0.5 M9,2.2 L10,0.5 M5.3,7 L2,6 M5,9.5 L1.3,9.5 M5.3,12 L2,13 M10.7,7 L14,6 M11,9.5 L14.7,9.5 M10.7,12 L14,13"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                                </Viewbox>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource M.Bad}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Now.Status.Running}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource M.Good}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource M.Text.Muted}" Text="{Binding Now.Status.State}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- The groups. The current page's row is one NavGlow behind the items that the code moves to the checked one (plan O 0.5).
                         A window too short for the groups and the foot scrolls the groups rather than covering them. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid x:Name="Nav" Margin="0,4,0,8" VerticalAlignment="Top">
                            <Canvas x:Name="NavCanvas">
                                <local:NavGlow x:Name="NavPill" Style="{StaticResource M.NavPill}" Canvas.Left="0" Canvas.Top="0" Width="0" Opacity="0" />
                            </Canvas>
                            <StackPanel x:Name="NavItems">
                                <TextBlock Style="{StaticResource NavGroup}" Text="OVERVIEW" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Dashboard" Tag="&#xE80F;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Dashboard}}" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="History" Tag="&#xE81C;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Breakdown}}" />
                                <TextBlock Style="{StaticResource NavGroup}" Text="INSIGHTS" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Report" Tag="&#xE9F9;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Report}}" />
                                <Grid>
                                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Household" Tag="&#xE716;" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Household}}" />
                                    <!-- PCs waiting for approval; nothing while there are none. -->
                                    <ContentControl Style="{StaticResource M.Badge}" HorizontalAlignment="Right" Margin="0,0,20,0" IsHitTestVisible="False"
                                                    Content="{Binding Household.PendingApprovals, FallbackValue={x:Null}}" AutomationProperties.Name="Waiting for approval" />
                                </Grid>
                                <TextBlock Style="{StaticResource NavGroup}" Text="SYSTEM" />
                                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Settings" Tag="&#xE713;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Settings}}" />
                                <Button Style="{StaticResource NavButton}" Content="Support" Tag="&#xED15;" Click="FeedbackClick" AutomationProperties.Name="Support" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="1" />
                        <Style.Triggers>
                            <!-- The wizard has the window: no sidebar, the top bar and the wizard across the whole width. -->
                            <DataTrigger Binding="{Binding IsSetup}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The top bar: plain over a hairline, the page's title, and on the right the theme, the look and Settings as small
                     framed squares, this PC as an avatar with its name, and the caption. -->
                <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource M.Ground}" BorderBrush="{DynamicResource M.Line}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="32,0,10,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="ThemeButton" Style="{StaticResource M.IconButton}" Content="&#xE706;" Click="ThemeClick" AutomationProperties.Name="Theme" />
                            <!-- Switch look (Midnight look design §1): the other look, chosen as in Settings, so the choice is kept. -->
                            <Button Style="{StaticResource M.IconButton}" Margin="8,0,0,0" Content="&#xE8AB;" Command="{Binding SwitchLook}" ToolTip="{Binding SwitchLookTip}"
                                    AutomationProperties.Name="Switch look" Click="SwitchLookClick" />
                            <Button Style="{StaticResource M.IconButton}" Margin="8,0,0,0" Content="&#xE713;" Click="SettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings" />
                            <Border Width="1" Height="20" Margin="16,0" Background="{DynamicResource M.Line}" />
                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource M.Raised}" BorderBrush="{DynamicResource M.Line}" BorderThickness="1">
                                <TextBlock x:Name="KindGlyph" Style="{StaticResource M.Text.Glyph}" FontSize="15" Text="&#xE7FB;" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,6,0">
                                <TextBlock x:Name="PcName" Style="{StaticResource M.Text.Body}" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Style="{StaticResource M.Text.Muted}" FontSize="11" Text="{Binding Household.Account.Email}"
                                           Visibility="{Binding Household.Account.Email, Converter={StaticResource VisibleWhenText}}" />
                            </StackPanel>
                            <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource M.Line}" />
                            <Button Style="{StaticResource M.IconButton.Quiet}" FontSize="10" Content="&#xE921;" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                            <Button x:Name="MaximizeButton" Style="{StaticResource M.IconButton.Quiet}" FontSize="10" Content="&#xE922;" Click="MaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
                            <Button Style="{StaticResource M.Caption.Close}" FontSize="10" Content="&#xE8BB;" Click="CloseClick" ToolTip="Close to the tray" AutomationProperties.Name="Close" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource M.Text.Heading}" VerticalAlignment="Center" Text="{Binding Page, Converter={StaticResource PageTitle}}" />
                    </DockPanel>
                </Border>

                <!-- The page header: the title again, heavier, the status pill, and the household's members. -->
                <DockPanel Grid.Row="1" Margin="32,22,32,0" Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource M.Button.Quiet}" Padding="6,0" Click="HouseholdClick" ToolTip="Household"
                            AutomationProperties.Name="Household members" Visibility="{Binding Household.HasHousehold, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl ItemsSource="{Binding Household.Members}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HouseholdMemberDisplay}">
                                    <local:Initials Style="{StaticResource M.Initials}" Member="{Binding Name}" Margin="0,0,4,0" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource M.Text.Title}" VerticalAlignment="Center" Text="{Binding Page, Converter={StaticResource PageTitle}}" />
                        <local:StatusPill Margin="14,0,0,0" Running="{Binding Now.Status.Running}" Quality="{Binding Now.Live.Quality}" />
                    </StackPanel>
                </DockPanel>

                <!-- Banners under the page header, flat, in the page's flow: they block nothing. Not while the wizard has the window. -->
                <StackPanel Grid.Row="2" Margin="32,0,32,0" Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                    <!-- The new look, said once (Midnight look design §1): news, so an accent edge, not a warning's red; it stays
                         until answered. Switch back chooses Classic through Settings; Got it, either button or any look switch
                         retires it for good (UiPreferences.LookIntroduced). -->
                    <Border x:Name="LookIntro" Style="{StaticResource M.Card.Flat}" BorderBrush="{DynamicResource M.Accent}" Padding="16,12,12,12"
                            Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="This is PowerLedger's new look" AutomationProperties.LiveSetting="Polite">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource M.Button.Outline}" Content="Switch back" Click="SwitchBackClick" Margin="0,2,8,2"
                                        ToolTip="Back to the classic look" />
                                <Button Style="{StaticResource M.Button.Primary}" Content="Got it" Click="GotItClick" Margin="0,2" />
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource M.Text.Glyph}" Foreground="{DynamicResource M.AccentText}" FontSize="16" Text="&#xE790;"
                                       Margin="0,1,12,0" VerticalAlignment="Top" AutomationProperties.Name="New" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource M.Text.Heading}" FontSize="14" Text="This is PowerLedger's new look" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource M.Text.Secondary}" Margin="0,3,0,0" TextWrapping="Wrap"
                                           Text="Prefer the classic one? Switch back any time here, or in Settings → Preferences." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- A look the top bar's Switch look couldn't open: why, on the page in view rather than on Settings' line out
                         of sight, until dismissed or ProblemShownFor on. -->
                    <Border x:Name="SwitchProblem" Style="{StaticResource M.Card.Flat}" BorderBrush="{DynamicResource M.Bad}" Padding="14,6,6,6"
                            Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Look switch problem" AutomationProperties.LiveSetting="Assertive">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource M.IconButton.Quiet}" Width="28" Height="28" MinHeight="28" FontSize="9" Content="&#xE8BB;"
                                    Click="DismissProblem" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource M.Text.Glyph}" Foreground="{DynamicResource M.Bad}" Text="&#xE7BA;" Margin="0,0,10,0"
                                       AutomationProperties.Name="Problem" />
                            <TextBlock x:Name="SwitchProblemText" Style="{StaticResource M.Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <local:PageHost x:Name="Pages" Grid.Row="3" Content="{Binding Current}" Margin="0,6,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="PowerLedger.App.MidnightWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerLedger.App"
        Title="PowerLedger" Icon="pack://application:,,,/PowerLedger;component/Brand/PowerLedger.ico" Width="1180" Height="900" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource M.Ground}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!-- The Midnight shell (Midnight look design §1, plan O M1-3): a 232 px sidebar with the pages in groups, a glass top
         bar the window is dragged by, the page header with its status pill and the household's members, and the page host.
         The drag area is the top 56 px, the top bar's height. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Midnight's styles live here, not at Application level, so its implicit styles never reach Classic or the dialogs;
                     the views merge the same instance (SharedDictionary). M2's page-only styles (Styles.Midnight.Pages.xaml) merge after this one. -->
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Midnight/Styles.Midnight.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:PageTitle x:Key="PageTitle" />
            <DataTemplate DataType="{x:Type local:DashboardViewModel}">
                <local:DashboardView />
            </DataTemplate>
            <!-- Classic's views stand in for History, Report, Household and Settings until M2's Midnight views land. -->
            <DataTemplate DataType="{x:Type local:BreakdownViewModel}">
                <local:BreakdownView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ReportViewModel}">
                <local:ReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:HouseholdViewModel}">
                <local:HouseholdView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:SettingsViewModel}">
                <local:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:WizardViewModel}">
                <local:WizardView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource M.LineStrong}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <!-- Windows pushes a maximised window's resize border off screen; keep the content on it. -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The sidebar: the brand, the groups, and at the foot the service's state, the update card and the bug button. -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource M.Panel}" BorderBrush="{DynamicResource M.Line}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,16,24,12" Height="28">
                        <Image Source="{StaticResource Brand.Mark}" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource M.Text.Heading}" Margin="10,0,0,0" Text="PowerLedger" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                        <!-- The update card (spec §13): only when there is something to say. -->
                        <Border x:Name="UpdateCard" Style="{StaticResource M.Card.Flat}" Padding="14,12" Margin="0,0,0,12" DataContext="{Binding Updates}"
                                Visibility="{Binding ShowCard, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" AutomationProperties.Name="Update">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource M.IconButton}" Width="24" Height="24" MinHeight="24" FontSize="9" Content="&#xE8BB;"
                                            Command="{Binding Dismiss}" ToolTip="Later" AutomationProperties.Name="Later" Margin="0,-4,-6,0"
                                            Visibility="{Binding CanDismiss, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock Style="{StaticResource M.Text.Eyebrow}" Text="UPDATE" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource M.Text.Body}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Title}" />
                                <TextBlock Style="{StaticResource M.Text.Muted}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Detail}"
                                           Visibility="{Binding Detail, Converter={StaticResource VisibleWhenText}}" />
                                <Button Style="{StaticResource M.Button.Primary}" Margin="0,10,0,0" HorizontalAlignment="Left" Content="{Binding ActionLabel}"
                                        Command="{Binding Act}" Visibility="{Binding ActionLabel, Converter={StaticResource VisibleWhenText}}" />
                                <Button Style="{StaticResource M.Button.Quiet}" Margin="-12,6,0,0" HorizontalAlignment="Left" Content="What's new"
                                        Command="{Binding OpenNotes}" Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="12,0,0,0">
                            <Button x:Name="BugButton" DockPanel.Dock="Right" Style="{StaticResource M.IconButton}" Click="FeedbackClick"
                                    ToolTip="Send feedback or report a bug" AutomationProperties.Name="Send feedback">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M6.5,3.5 A1.5,1.5 0 1 0 9.5,3.5 A1.5,1.5 0 1 0 6.5,3.5 Z M5,9.5 A3,4 0 1 0 11,9.5 A3,4 0 1 0 5,9.5 Z M7,2.2 L6,0.5 M9,2.2 L10,0.5 M5.3,7 L2,6 M5,9.5 L1.3,9.5 M5.3,12 L2,13 M10.7,7 L14,6 M11,9.5 L14.7,9.5 M10.7,12 L14,13"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
                                </Viewbox>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource M.Bad}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Now.Status.Running}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource M.Good}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource M.Text.Muted}" Text="{Binding Now.Status.State}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- The groups. The accent pill is one Border behind the items that the code moves to the checked one (plan O 0.5).
                         A window too short for the groups and the foot scrolls the groups rather than covering them. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid x:Name="Nav" Margin="0,4,0,8" VerticalAlignment="Top">
                            <Canvas x:Name="NavCanvas">
                                <Border x:Name="NavPill" Style="{StaticResource M.NavPill}" Canvas.Left="12" Canvas.Top="0" Width="0" Opacity="0" />
                            </Canvas>
                            <StackPanel x:Name="NavItems">
                                <TextBlock Style="{StaticResource M.NavGroup}" Text="OVERVIEW" />
                                <RadioButton Style="{StaticResource M.NavItem}" GroupName="Nav" Content="Dashboard" Tag="&#xE80F;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Dashboard}}" />
                                <RadioButton Style="{StaticResource M.NavItem}" GroupName="Nav" Content="History" Tag="&#xE81C;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Breakdown}}" />
                                <TextBlock Style="{StaticResource M.NavGroup}" Text="INSIGHTS" />
                                <RadioButton Style="{StaticResource M.NavItem}" GroupName="Nav" Content="Report" Tag="&#xE9F9;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Report}}" />
                                <Grid>
                                    <RadioButton Style="{StaticResource M.NavItem}" GroupName="Nav" Content="Household" Tag="&#xE716;" Checked="NavChecked"
                                                 IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Household}}" />
                                    <!-- PCs waiting for approval; nothing while there are none. -->
                                    <ContentControl Style="{StaticResource M.Badge}" HorizontalAlignment="Right" Margin="0,0,26,0" IsHitTestVisible="False"
                                                    Content="{Binding Household.PendingApprovals, FallbackValue={x:Null}}" AutomationProperties.Name="Waiting for approval" />
                                </Grid>
                                <TextBlock Style="{StaticResource M.NavGroup}" Text="SYSTEM" />
                                <RadioButton Style="{StaticResource M.NavItem}" GroupName="Nav" Content="Settings" Tag="&#xE713;" Checked="NavChecked"
                                             IsChecked="{Binding Page, Converter={StaticResource Is}, ConverterParameter={x:Static local:Page.Settings}}" />
                                <Button Style="{StaticResource M.NavButton}" Content="Support" Tag="&#xED15;" Click="FeedbackClick" AutomationProperties.Name="Support" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="1" />
                        <Style.Triggers>
                            <!-- The wizard has the window: no sidebar, the top bar and the wizard across the whole width. -->
                            <DataTrigger Binding="{Binding IsSetup}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The top bar: glass over the page, the page's title, and on the right the theme, the look, Settings, this PC and the caption. -->
                <Border x:Name="TopBar" Grid.Row="0" Style="{StaticResource M.Glass}" CornerRadius="0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Rectangle Style="{StaticResource M.Glass.Highlight}" Margin="0" />
                        <DockPanel Margin="28,0,10,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button x:Name="ThemeButton" Style="{StaticResource M.IconButton}" Content="&#xE706;" Click="ThemeClick" AutomationProperties.Name="Theme" />
                                <Button Style="{StaticResource M.IconButton}" Content="&#xE8AB;" Click="SwitchLookClick" ToolTip="Switch to the Classic look" AutomationProperties.Name="Switch look" />
                                <Button Style="{StaticResource M.IconButton}" Content="&#xE713;" Click="SettingsClick" ToolTip="Settings" AutomationProperties.Name="Settings" />
                                <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource M.Line}" />
                                <TextBlock x:Name="KindGlyph" Style="{StaticResource M.Text.Glyph}" FontSize="16" Text="&#xE7FB;" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="PcName" Style="{StaticResource M.Text.Body}" FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Style="{StaticResource M.Text.Muted}" FontSize="11" Text="{Binding Household.Account.Email}"
                                               Visibility="{Binding Household.Account.Email, Converter={StaticResource VisibleWhenText}}" />
                                </StackPanel>
                                <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource M.Line}" />
                                <Button Style="{StaticResource M.IconButton}" FontSize="10" Content="&#xE921;" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                                <Button x:Name="MaximizeButton" Style="{StaticResource M.IconButton}" FontSize="10" Content="&#xE922;" Click="MaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
                                <Button Style="{StaticResource M.Caption.Close}" FontSize="10" Content="&#xE8BB;" Click="CloseClick" ToolTip="Close to the tray" AutomationProperties.Name="Close" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource M.Text.Heading}" VerticalAlignment="Center" Text="{Binding Page, Converter={StaticResource PageTitle}}" />
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- The page header: the title again, heavier, the status pill, and the household's members. -->
                <DockPanel Grid.Row="1" Margin="32,22,32,0" Visibility="{Binding IsSetup, Converter={StaticResource HiddenWhen}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource M.Button.Quiet}" Padding="6,0" Click="HouseholdClick" ToolTip="Household"
                            AutomationProperties.Name="Household members" Visibility="{Binding Household.HasHousehold, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl ItemsSource="{Binding Household.Members}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HouseholdMemberDisplay}">
                                    <local:Initials Style="{StaticResource M.Initials}" Member="{Binding Name}" Margin="0,0,4,0" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource M.Text.Title}" VerticalAlignment="Center" Text="{Binding Page, Converter={StaticResource PageTitle}}" />
                        <local:StatusPill Margin="14,0,0,0" Running="{Binding Now.Status.Running}" Quality="{Binding Now.Live.Quality}" />
                    </StackPanel>
                </DockPanel>

                <local:PageHost x:Name="Pages" Grid.Row="2" Content="{Binding Current}" Margin="0,6,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>

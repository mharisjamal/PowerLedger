<UserControl x:Class="PowerLedger.App.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PowerLedger.App">
    <!-- The Dashboard (Midnight look design §1, plan O M1-4): three KPI cards, the area chart with its range pills, and the
         parts table with its own range. Three cards across from 1100 px of window; one under another below that. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The window's styles, shared with it (SharedDictionary): a view built by a DataTemplate resolves its StaticResources before it joins the window. -->
                <local:SharedDictionary Source="pack://application:,,,/PowerLedger;component/Midnight/Styles.Midnight.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:AtLeast x:Key="AtLeast" />
            <local:FigurePart x:Key="FigurePart" />

            <!-- Page-only styles, each on a key of plan O 0.3. A part's glyph and its share bar take the part's colour. -->
            <Style x:Key="PartGlyph" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Glyph}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{DynamicResource M.PartRest}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Part}" Value="Cpu"><Setter Property="Foreground" Value="{DynamicResource M.PartCpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Gpu"><Setter Property="Foreground" Value="{DynamicResource M.PartGpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Display"><Setter Property="Foreground" Value="{DynamicResource M.PartDisplay}" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PartShare" TargetType="local:ShareBar" BasedOn="{StaticResource M.ShareBar}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FillBrush" Value="{DynamicResource M.PartRest}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Part}" Value="Cpu"><Setter Property="FillBrush" Value="{DynamicResource M.PartCpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Gpu"><Setter Property="FillBrush" Value="{DynamicResource M.PartGpu}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Part}" Value="Display"><Setter Property="FillBrush" Value="{DynamicResource M.PartDisplay}" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Number}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ShareCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource M.Ink2}" />
            </Style>
            <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource M.Text.Eyebrow}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- A row of range pills: one tab stop, the arrows move along it, as a radio group does. -->
            <Style x:Key="PillRow" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            </Style>

            <!-- A KPI card: the label, the figure with its unit set smaller, the line under it, the trend or the quality chip, and the hatched bar. -->
            <DataTemplate x:Key="Kpi" DataType="{x:Type local:KpiCard}">
                <Border Style="{StaticResource M.Card}" Margin="0,0,16,16" AutomationProperties.Name="{Binding Label}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource M.Text.Eyebrow}" Text="{Binding Label, Converter={StaticResource Upper}}" />
                        <TextBlock Style="{StaticResource M.Text.Display}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Big, Mode=OneWay, Converter={StaticResource FigurePart}, ConverterParameter=Number}" /><Run
                                 Text=" " FontSize="18" /><Run Text="{Binding Big, Mode=OneWay, Converter={StaticResource FigurePart}, ConverterParameter=Unit}"
                                 FontFamily="{StaticResource M.Font.Ui}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource M.Ink2}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource M.Text.Secondary}" Margin="0,4,0,0" Text="{Binding Small}" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,16,0,0" Height="22">
                            <StackPanel x:Name="Trend" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:TrendMark Kind="{Binding Kind}" Text="{Binding Trend}" />
                                <TextBlock x:Name="Against" Style="{StaticResource M.Text.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <ContentControl x:Name="Chip" Style="{StaticResource M.Chip.Measured}" Visibility="Collapsed" />
                        </Grid>
                        <local:HatchBar Style="{StaticResource M.HatchBar}" Margin="0,14,0,0" Value="{Binding Fill}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <!-- What an arrow is against, for the two cards that have one; words alone ("first month") say it themselves. -->
                    <DataTrigger Binding="{Binding Label}" Value="Today">
                        <Setter TargetName="Against" Property="Text" Value="vs your average day" />
                        <Setter TargetName="Against" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Label}" Value="Idle waste this month">
                        <Setter TargetName="Against" Property="Text" Value="vs last month" />
                        <Setter TargetName="Against" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Text">
                        <Setter TargetName="Against" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Quality">
                        <Setter TargetName="Trend" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Chip" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Trend}" Value="Calibrated">
                        <Setter TargetName="Chip" Property="Style" Value="{StaticResource M.Chip.Calibrated}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Trend}" Value="Estimated">
                        <Setter TargetName="Chip" Property="Style" Value="{StaticResource M.Chip.Estimated}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="32,16,32,32">
            <!-- The cards. The -16 takes back the gutter the last card in a row leaves. The width is the page's: 1100 px of
                 window less the 232 px sidebar and the 1 px frame each side. -->
            <ItemsControl ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource Kpi}" Focusable="False" Margin="0,0,-16,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid>
                            <UniformGrid.Style>
                                <Style TargetType="UniformGrid">
                                    <Setter Property="Rows" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Value="False"
                                                     Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=local:DashboardView}, Converter={StaticResource AtLeast}, ConverterParameter=866}">
                                            <Setter Property="Rows" Value="0" />
                                            <Setter Property="Columns" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </UniformGrid.Style>
                        </UniformGrid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Power over time: the range's name, the pills, the chart, the key to its colours. -->
            <Border Style="{StaticResource M.Card}" Margin="0,0,0,16" AutomationProperties.Name="Power over time">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource M.PillTrack}" Margin="16,0,0,0" VerticalAlignment="Top">
                            <StackPanel Style="{StaticResource PillRow}">
                                <RadioButton Style="{StaticResource M.Pill}" Content="1H" ToolTip="The last hour" AutomationProperties.Name="Last hour"
                                             IsChecked="{Binding Range, Converter={StaticResource Is}, ConverterParameter={x:Static local:RangePill.Hour}}" />
                                <RadioButton Style="{StaticResource M.Pill}" Content="1D" ToolTip="Today" AutomationProperties.Name="Today"
                                             IsChecked="{Binding Range, Converter={StaticResource Is}, ConverterParameter={x:Static local:RangePill.Day}}" />
                                <RadioButton Style="{StaticResource M.Pill}" Content="1W" ToolTip="The last 7 days" AutomationProperties.Name="Last 7 days"
                                             IsChecked="{Binding Range, Converter={StaticResource Is}, ConverterParameter={x:Static local:RangePill.Week}}" />
                                <RadioButton Style="{StaticResource M.Pill}" Content="1M" ToolTip="The last 30 days" AutomationProperties.Name="Last 30 days"
                                             IsChecked="{Binding Range, Converter={StaticResource Is}, ConverterParameter={x:Static local:RangePill.Month}}" />
                                <RadioButton Style="{StaticResource M.Pill}" Content="1Y" ToolTip="The last 365 days" AutomationProperties.Name="Last 365 days"
                                             IsChecked="{Binding Range, Converter={StaticResource Is}, ConverterParameter={x:Static local:RangePill.Year}}" />
                                <RadioButton Style="{StaticResource M.Pill}" Content="All" ToolTip="Everything recorded" AutomationProperties.Name="Everything recorded"
                                             IsChecked="{Binding Range, Converter={StaticResource Is}, ConverterParameter={x:Static local:RangePill.All}}" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource M.Text.Heading}" Text="Power over time" />
                            <TextBlock Style="{StaticResource M.Text.Muted}" Margin="0,2,0,0" Text="{Binding ChartTitle}" />
                        </StackPanel>
                    </DockPanel>
                    <local:AreaChart Style="{StaticResource M.AreaChart}" Margin="0,16,0,0" Model="{Binding Chart}" From="{Binding ChartFrom}" Zone="{Binding Zone}"
                                     EmptyText="{Binding ChartMessage, TargetNullValue='No history yet'}" />
                    <WrapPanel Margin="0,12,0,0">
                        <WrapPanel.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource M.Text.Secondary}">
                                <Setter Property="Margin" Value="7,0,18,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </WrapPanel.Resources>
                        <Ellipse Fill="{DynamicResource M.Accent}" /><TextBlock Text="Total" />
                        <Ellipse Fill="{DynamicResource M.PartCpu}" /><TextBlock Text="CPU" />
                        <Ellipse Fill="{DynamicResource M.PartGpu}" /><TextBlock Text="GPU" />
                        <Ellipse Fill="{DynamicResource M.PartDisplay}" /><TextBlock Text="Display" />
                        <Ellipse Fill="{DynamicResource M.PartRest}" /><TextBlock Text="Rest" />
                        <local:HatchBar Style="{StaticResource M.HatchBar}" Width="18" Value="0" VerticalAlignment="Center" /><TextBlock Text="Asleep" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Where the power went: a row a part over the table's own range, each against the same length of time before it. -->
            <Border Style="{StaticResource M.Card}" AutomationProperties.Name="Where the power went">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource M.PillTrack}" Margin="16,0,0,0" VerticalAlignment="Top">
                            <StackPanel Style="{StaticResource PillRow}">
                                <RadioButton Style="{StaticResource M.Pill}" Content="Today"
                                             IsChecked="{Binding PartsRange, Converter={StaticResource Is}, ConverterParameter={x:Static local:PartsRange.Today}}" />
                                <RadioButton Style="{StaticResource M.Pill}" Content="7 days" AutomationProperties.Name="Last 7 days"
                                             IsChecked="{Binding PartsRange, Converter={StaticResource Is}, ConverterParameter={x:Static local:PartsRange.SevenDays}}" />
                                <RadioButton Style="{StaticResource M.Pill}" Content="30 days" AutomationProperties.Name="Last 30 days"
                                             IsChecked="{Binding PartsRange, Converter={StaticResource Is}, ConverterParameter={x:Static local:PartsRange.ThirtyDays}}" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource M.Text.Heading}" Text="Where the power went" />
                            <TextBlock Style="{StaticResource M.Text.Muted}" Margin="0,2,0,0" Text="By part, with the change on the same time before" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>

                    <!-- The header and the rows share one set of columns: the glyph, the name, watts now, energy, the share,
                         the chip, the trend. The name and the share stretch; at 960 px of window the rest still fits whole.
                         The rows reach 8 px past the text each side, so a row's hover wash has room around its words. -->
                    <StackPanel Margin="-8,18,-8,0">
                        <Border Style="{StaticResource M.Table.Header}" Padding="8,0,8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" MinWidth="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="1.4*" MinWidth="110" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="PART" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Head}" Text="NOW" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="ENERGY" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="SHARE" Margin="28,0,0,0" />
                                <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="QUALITY" Margin="20,0,0,0" />
                                <TextBlock Grid.Column="6" Style="{StaticResource Head}" Text="TREND" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Parts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DashboardPart}">
                                    <Border Style="{StaticResource M.Table.Row}" Padding="8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" MinWidth="110" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="1.4*" MinWidth="110" />
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="76" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource PartGlyph}" Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource M.Text.Body}" FontWeight="Medium" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding NowW}" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Energy}" />
                                            <DockPanel Grid.Column="4" Margin="28,0,0,0" VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource ShareCell}" MinWidth="40" Text="{Binding Share, StringFormat={}{0:P0}}" />
                                                <local:ShareBar Style="{StaticResource PartShare}" Margin="0,0,10,0" Value="{Binding Share}" />
                                            </DockPanel>
                                            <local:QualityBadge Grid.Column="5" Style="{StaticResource M.Chip}" Margin="20,0,0,0" Quality="{Binding Quality}" />
                                            <local:TrendMark Grid.Column="6" Margin="8,0,0,0" HorizontalAlignment="Left" Kind="{Binding Kind}" Text="{Binding Trend, TargetNullValue='–'}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
